---
export const prerender = false;
import Staff from '../../../layouts/Staff.astro';
import PageHead from '../../../components/PageHead.astro';
import Icon from '../../../components/Icon.astro';
import { initials } from '../../../lib/team';
import { departments, one } from '../../../lib/db';
import { looksLikeEmail, normalizeEmail } from '../../../lib/auth';
import { clientIp, int, safeNext, str, withFlash } from '../../../lib/http';
import {
  canSetPhoto, canSetPublic, changeEmail, changeMember, createInvite, getMember, listMembers, openInvites, recentlyClaimed, removeMember, revokeInvite, setDeputy,
  setPhoto, setShowPublic,
} from '../../../lib/members';
import { BadImage, mediaUrl, storeImage } from '../../../lib/media';
import * as P from '../../../lib/permissions';
import { Denied } from '../../../lib/records';
import { fmtDate, fmtDateTime, now } from '../../../lib/time';
import { ROLE_LABEL, type DeptSlug, type Role } from '../../../lib/types';

const user = Astro.locals.user!;
const manager = P.canManageMembers(user);
const grantable = P.grantableRoles(user);
const depts = await departments();
let inviteLink: string | null = null;
let inviteName = '';
let inviteError = '';

if (Astro.request.method === 'POST') {
  const fd = await Astro.request.formData();
  const action = str(fd, 'action', 20);
  const ip = clientIp(Astro.request);
  const back = safeNext(str(fd, 'back', 200), '/gishuud');
  if (action === 'public_on' || action === 'public_off') {
    const target = await getMember(int(str(fd, 'user')) ?? 0);
    if (!target || !canSetPublic(user, target)) return Astro.redirect(withFlash(back, 'denied', 'err'));
    await setShowPublic(user, target, action === 'public_on', ip);
    return Astro.redirect(withFlash(back, 'saved'));
  }
  if (action === 'photo' || action === 'photo_remove') {
    const target = await getMember(int(str(fd, 'user')) ?? 0);
    if (!target || target.status !== 'active' || !canSetPhoto(user, target)) return Astro.redirect(withFlash(back, 'denied', 'err'));
    if (action === 'photo_remove') {
      await setPhoto(user, target, null, ip);
      return Astro.redirect(withFlash(back, 'portrait_removed'));
    }
    const file = fd.get('file');
    if (!(file instanceof File) || file.size === 0) return Astro.redirect(withFlash(back, 'invalid', 'err'));
    try {
      const mediaId = await storeImage(file, user.id, int(str(fd, 'w')) ?? undefined, int(str(fd, 'h')) ?? undefined);
      await setPhoto(user, target, mediaId, ip);
    } catch (e) {
      if (e instanceof BadImage) return Astro.redirect(withFlash(back, 'image', 'err'));
      throw e;
    }
    return Astro.redirect(withFlash(back, 'portrait'));
  }
  if (!manager) return Astro.redirect(withFlash(back, 'denied', 'err'));
  try {
    if (action === 'invite') {
      const name = str(fd, 'name', 100);
      const studentId = str(fd, 'student_id', 20);
      const role = str(fd, 'role', 20) as Role;
      const dept = str(fd, 'dept', 40) as DeptSlug;
      // Student ID is optional: the President sometimes has only an e-mail or WeChat for someone.
      if (!name) inviteError = 'Нэрийг оруулна уу.';
      else if (studentId && !/^\d{6,12}$/.test(studentId)) inviteError = 'Оюутны дугаар зөвхөн тооноос бүрдэнэ (6–12 орон).';
      else if (!grantable.includes(role)) inviteError = 'Энэ эрхийг олгох боломжгүй.';
      else if (role !== 'maintainer' && !depts.some((d) => d.slug === dept)) inviteError = 'Хэлтэс сонгоно уу.';
      else {
        const token = await createInvite(user, { name, studentId, dept: role === 'maintainer' ? null : dept, role }, ip);
        // Shown once, on this response only — the raw token is never stored and never put in a URL we log.
        inviteLink = `${Astro.url.protocol}//${Astro.url.host}/urilga/${token}`;
        inviteName = name;
      }
    } else {
      const target = await getMember(int(str(fd, 'user')) ?? 0);
      if (action === 'revoke') await revokeInvite(user, int(str(fd, 'invite')) ?? 0, ip);
      else if (action === 'deputy') await setDeputy(user, target, ip);
      else if (action === 'no_deputy') await setDeputy(user, null, ip);
      else if (!target) throw new Denied();
      else if (action === 'change') await changeMember(user, target, { role: str(fd, 'role', 20) as Role, dept: (str(fd, 'dept', 40) || null) as DeptSlug | null }, ip);
      else if (action === 'remove') await removeMember(user, target, ip);
      else if (action === 'email') {
        const email = normalizeEmail(str(fd, 'email', 254));
        if (!looksLikeEmail(email)) return Astro.redirect(withFlash(back, 'invalid', 'err'));
        if (email !== target.email && (await one(`SELECT 1 FROM users WHERE email = ?`, email))) return Astro.redirect(withFlash(back, 'email_taken', 'err'));
        await changeEmail(user, target, email, ip);
      }
      const key = { revoke: 'revoked', deputy: 'deputy', no_deputy: 'deputy', change: 'saved', remove: 'removed' }[action] ?? 'saved';
      // After removing someone their page no longer exists — go back to the list.
      return Astro.redirect(withFlash(action === 'remove' ? '/gishuud' : back, key));
    }
  } catch (e) {
    if (e instanceof Denied) return Astro.redirect(withFlash(back, 'denied', 'err'));
    throw e;
  }
}

const [members, invites, claimed] = await Promise.all([
  listMembers('active'),
  manager ? openInvites() : Promise.resolve([]),
  manager ? recentlyClaimed() : Promise.resolve([]),
]);
const deputy = members.find((m) => m.is_deputy === 1);
const t = now();
// Group the list by department, leadership first (listMembers already sorts by role within).
const groups = depts
  .map((d) => ({ name: d.name_mn, rows: members.filter((m) => m.department_id === d.id) }))
  .concat([{ name: 'Хэлтэсгүй', rows: members.filter((m) => m.department_id === null) }])
  .filter((g) => g.rows.length > 0);
// The maintainer opens pages only to load photos (see gishuud/[id]).
const canOpen = (m: (typeof members)[number]) => m.id === user.id || manager || user.role === 'maintainer';
---
<Staff title="Гишүүд">
  <PageHead title="Гишүүд" sub={`Ажлын орчны эрхтэй ${members.length} хүн. Эрх жил бүрийн 9-р сарын 30-нд дуусна.`}>
    <Fragment slot="actions">
      {manager && <a class="btn btn-primary" href="#invite"><Icon name="plus" /> Урилга үүсгэх</a>}
      {manager && <a class="btn" href="/gishuud/shine-jil"><Icon name="clock" /> Шинэ жилийн бүртгэл</a>}
      {manager && <a class="btn" href="/gishuud/bichig?id=all" target="_blank" rel="noopener"><Icon name="print" /> Үүргийн бичиг<span class="sr-only"> (шинэ цонхонд)</span></a>}
    </Fragment>
  </PageHead>

  {
    inviteLink && (
      <section class="panel attention" aria-labelledby="made-h" style="margin-bottom:18px">
        <div class="panel-head"><h2 id="made-h"><Icon name="check" /> Урилга үүслээ: {inviteName}</h2></div>
        <div class="panel-body stack" style="--stack:12px">
          <p style="margin:0">Энэ холбоосыг WeChat-аар илгээнэ үү. Нэг удаа ашиглагдах бөгөөд <strong>72 цагийн</strong> дотор хүчинтэй. Холбоос зөвхөн одоо харагдана — дахин үзүүлэх боломжгүй.</p>
          <div class="copy-row">
            <label for="invite-link" class="sr-only">Урилгын холбоос</label>
            <input type="text" readonly value={inviteLink} id="invite-link" />
            <button class="btn btn-primary" type="button" data-copy="invite-link"><Icon name="copy" /> <span data-label>Хуулах</span></button>
          </div>
          <p class="form-note">Урилга авсан хүн өөрийн и-мэйл хаягаа өөрөө оруулж, кодоор баталгаажуулна. Ингэснээр хаягийн алдаа гарах боломжгүй.</p>
        </div>
      </section>
    )
  }

  <div class="table-wrap cards-sm">
    <table class="t">
      <caption class="sr-only">Гишүүдийн жагсаалт, хэлтсээр</caption>
      <thead>
        <tr>
          <th scope="col">Нэр</th>
          <th scope="col">Эрх</th>
          <th scope="col">И-мэйл</th>
          <th scope="col">Эрх дуусах</th>
          <th scope="col" title="Нийтийн «Удирдлагын баг» хуудсанд харагдах эсэх">Нийтэд</th>
        </tr>
      </thead>
      {groups.map((g) => (
        <tbody>
          <tr class="group-row"><th colspan="5" scope="rowgroup">{g.name}</th></tr>
          {g.rows.map((m) => {
            const expiring = m.term_ends_at !== null && m.term_ends_at - t < 30 * 86400;
            return (
              <tr class:list={{ clickable: canOpen(m) }}>
                <td class="main-cell">
                  <span class="who">
                    {m.photo_id
                      ? <span class="avatar photo" aria-hidden="true"><img src={mediaUrl(m.photo_id)} alt="" width="36" height="36" loading="lazy" /></span>
                      : <span class="avatar" aria-hidden="true">{initials(m.name_mn)}</span>}
                    <span class="who-text">
                      {canOpen(m) ? <a class="row-link" href={`/gishuud/${m.id}`}>{m.name_mn}</a> : <b>{m.name_mn}</b>}
                      {m.id === user.id && <span class="muted small"> (та)</span>}
                      {m.is_deputy === 1 && <> <span class="badge plain b-blue">орлогч</span></>}
                      <small>{m.student_id ?? ''}<span class="m-only">{ROLE_LABEL[m.role]} · {m.email}</span></small>
                    </span>
                  </span>
                </td>
                <td class="nowrap hide-sm">{ROLE_LABEL[m.role]}</td>
                <td class="small hide-sm">{m.email}</td>
                <td class:list={['nowrap num small hide-sm', { warnc: expiring }]}>{fmtDate(m.term_ends_at)}{expiring && <span class="sr-only"> (удахгүй дуусна)</span>}</td>
                <td class="nowrap small side-cell">
                  {m.role === 'maintainer' ? <span class="muted">—</span> : m.show_public ? <span class="tag"><Icon name="check" /> Харагдана</span> : <span class="muted">Нуусан</span>}
                </td>
              </tr>
            );
          })}
        </tbody>
      ))}
    </table>
  </div>

  {
    manager && (
      <div class="cols" style="margin-top:24px">
        <form method="post" class="panel" id="invite" aria-labelledby="inv-h">
          <input type="hidden" name="action" value="invite" />
          <div class="panel-head"><h2 id="inv-h"><Icon name="mail" /> Урилга үүсгэх</h2></div>
          <div class="panel-body" style="display:grid;gap:16px">
            <p class="form-note">Нэрийг та оруулна. И-мэйл хаягаа тухайн хүн өөрөө оруулна.</p>
            {inviteError && <div class="flash err" role="alert" style="margin:0"><Icon name="alert" /><span class="flash-text">{inviteError}</span></div>}
            <div class="field">
              <label for="i_name">Нэр</label>
              <input id="i_name" name="name" type="text" required maxlength="100" placeholder="Жишээ нь: Б. Болд" autocomplete="off" />
            </div>
            <div class="field">
              <label for="i_sid">Оюутны дугаар <span class="opt">(заавал биш)</span></label>
              <input id="i_sid" name="student_id" type="text" inputmode="numeric" pattern="[0-9]{6,12}" aria-describedby="i_sid-hint" autocomplete="off" />
              <span class="hint" id="i_sid-hint">Зөвхөн тоо, 6–12 орон. Мэдэхгүй бол хоосон орхино — үүргийн бичиг дээр гараар бичих зай үлдэнэ.</span>
            </div>
            <div class="two">
              <div class="field">
                <label for="i_role">Эрх</label>
                <select id="i_role" name="role">
                  {grantable.map((r) => <option value={r} selected={r === 'member'}>{ROLE_LABEL[r]}</option>)}
                </select>
              </div>
              <div class="field">
                <label for="i_dept">Хэлтэс</label>
                <select id="i_dept" name="dept" aria-describedby="i_dept-hint">
                  {depts.map((d) => <option value={d.slug}>{d.name_mn}</option>)}
                </select>
                <span class="hint" id="i_dept-hint" hidden>Техникийн хариуцагч хэлтэсгүй.</span>
              </div>
            </div>
            <div><button class="btn btn-primary" type="submit">Урилгын холбоос үүсгэх</button></div>
          </div>
        </form>

        <div>
          <section class="panel" aria-labelledby="dep-h">
            <div class="panel-head"><h2 id="dep-h"><Icon name="user" /> Орлогч</h2></div>
            <div class="panel-body">
              <p class="form-note" style="margin-bottom:10px">Тэргүүн байхгүй үед гишүүн нэмж, хасах эрхтэй нэг хүн.</p>
              {deputy ? (
                <form method="post" class="assignee-row">
                  <span class="avatar sm" aria-hidden="true">{initials(deputy.name_mn)}</span>
                  <strong class="grow">{deputy.name_mn}</strong>
                  {P.canSetDeputy(user) && <button class="btn btn-sm" name="action" value="no_deputy" data-confirm="Орлогчийг цуцлах уу?">Цуцлах</button>}
                </form>
              ) : (
                <div class="flash warn" style="margin:0"><Icon name="alert" /><span class="flash-text">Орлогч томилогдоогүй. Гишүүний нэр дээр дарж «Орлогчоор томилох».</span></div>
              )}
            </div>
          </section>

          <section class="panel" id="invites" aria-labelledby="pend-h">
            <div class="panel-head"><h2 id="pend-h"><Icon name="clock" /> Хүлээгдэж буй урилга</h2></div>
            <div class="panel-body">
              {invites.length === 0 ? <p class="form-note">Алга.</p> : (
                <ul class="items">
                  {invites.map((i) => (
                    <li class="item">
                      <span class="ic"><Icon name="mail" /></span>
                      <span class="item-title">{i.name_mn}</span>
                      <span class="item-meta">
                        <span>{ROLE_LABEL[i.role]}</span>
                        <span>{i.dept_name ?? '—'}</span>
                        <span class:list={{ overdue: i.expires_at < t }}>{i.expires_at < t ? 'хугацаа дууссан' : `${fmtDateTime(i.expires_at)} хүртэл`}</span>
                        {i.pending_email && <span>{i.pending_email} баталгаажуулж байна</span>}
                      </span>
                      <span class="item-act">
                        <form method="post">
                          <input type="hidden" name="invite" value={i.id} />
                          <button class="btn btn-sm btn-quiet" name="action" value="revoke" data-confirm={`«${i.name_mn}» нэртэй урилгыг цуцлах уу?`}>Цуцлах</button>
                        </form>
                      </span>
                    </li>
                  ))}
                </ul>
              )}
            </div>
          </section>

          {claimed.length > 0 && (
            <section class="panel" aria-labelledby="claim-h">
              <div class="panel-head"><h2 id="claim-h"><Icon name="check" /> Сүүлд бүртгүүлсэн</h2></div>
              <div class="panel-body">
                <p class="form-note" style="margin-bottom:8px">Зөв хүн зөв хаягаар бүртгүүлснийг шалгана уу.</p>
                <ul class="items">
                  {claimed.map((i) => (
                    <li class="item">
                      <span class="ic ok"><Icon name="user" /></span>
                      <span class="item-title">{i.name_mn}</span>
                      <span class="item-meta"><span>{i.claimed_email}</span><span>{fmtDateTime(i.claimed_at)}</span></span>
                    </li>
                  ))}
                </ul>
              </div>
            </section>
          )}
        </div>
      </div>
    )
  }
</Staff>

<script is:inline>
  // The maintainer has no department: hide the department choice when that role is picked.
  (function () {
    var role = document.getElementById('i_role'), dept = document.getElementById('i_dept'), hint = document.getElementById('i_dept-hint');
    if (!role || !dept) return;
    function sync() { var m = role.value === 'maintainer'; dept.disabled = m; if (hint) hint.hidden = !m; }
    role.addEventListener('change', sync); sync();
  })();
</script>
