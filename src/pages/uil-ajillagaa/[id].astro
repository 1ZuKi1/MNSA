---
export const prerender = false;
import Public from '../../layouts/Public.astro';
import { eventPhotos, getEvent } from '../../lib/events';
import { int } from '../../lib/http';
import { mediaUrl } from '../../lib/media';
import { fmtDateTime, fmtLong, now } from '../../lib/time';

const id = int(Astro.params.id?.split('-')[0]);
const ev = id ? await getEvent(id) : null;
if (!ev || ev.status !== 'published') return new Response(null, { status: 404 });
const photos = await eventPhotos(ev.id);
const past = ev.ends_at < now();
---
<Public title={ev.title} description={ev.summary ?? undefined} image={mediaUrl(ev.cover_media_id)}>
  <article class="wrap ev">
    <p class="back"><a href="/uil-ajillagaa">← Үйл ажиллагаа</a></p>
    <p class="when">{past ? 'Өнгөрсөн' : 'Удахгүй болох'} · {fmtLong(ev.starts_at)}</p>
    <h1>{ev.title}</h1>
    <dl class="kv facts">
      <dt>Хэзээ</dt><dd>{fmtDateTime(ev.starts_at)} – {fmtDateTime(ev.ends_at).slice(11)}</dd>
      {ev.location && (<><dt>Хаана</dt><dd>{ev.location}</dd></>)}
      {ev.dept_name && (<><dt>Зохион байгуулсан</dt><dd>{ev.dept_name}</dd></>)}
    </dl>
    {ev.summary && <p class="lede">{ev.summary}</p>}
    {ev.body && <div class="body">{ev.body}</div>}

    {
      photos.length > 0 && (
        <section class="gallery">
          {photos.map((p) => (
            <figure>
              <a href={mediaUrl(p.media_id)} target="_blank" rel="noopener">
                <img src={mediaUrl(p.media_id)} alt={p.caption ?? ev.title} loading="lazy" />
              </a>
              {p.caption && <figcaption>{p.caption}</figcaption>}
            </figure>
          ))}
        </section>
      )
    }

    {ev.publisher_name && <p class="by">Нийтэлсэн: <strong>{ev.publisher_name}</strong> · {fmtLong(ev.published_at)}</p>}
  </article>
</Public>

<style>
  .ev { max-width: 820px; padding-top: 28px; }
  .back { font-size: 0.9rem; }
  .when { color: var(--blue); font-weight: 600; font-size: 0.9rem; margin: 18px 0 6px; }
  h1 { font: 650 clamp(1.7rem, 1.3rem + 1.6vw, 2.4rem)/1.2 var(--font-serif); margin-bottom: 18px; }
  .facts { margin-bottom: 20px; padding: 14px 16px; background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius); }
  .lede { font-size: 1.12rem; color: var(--ink-2); }
  .body { white-space: pre-wrap; font: 1.05rem/1.75 var(--font-serif); }
  .gallery { display: grid; gap: 12px; grid-template-columns: repeat(auto-fill, minmax(min(100%, 240px), 1fr)); margin-top: 28px; }
  .gallery figure { margin: 0; }
  .gallery img { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; border-radius: var(--radius-sm); background: var(--sunk); }
  .gallery figcaption { font-size: 0.85rem; color: var(--ink-3); margin-top: 4px; }
  .by { margin-top: 28px; padding-top: 14px; border-top: 1px solid var(--line); color: var(--ink-3); font-size: 0.9rem; }
</style>
