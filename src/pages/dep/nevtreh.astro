---
export const prerender = false;
import { env } from 'cloudflare:workers';
import Staff from '../../layouts/Staff.astro';
import Icon from '../../components/Icon.astro';
import { codeRateOk, issueCode, looksLikeEmail, normalizeEmail, turnstileOk, verifyCode } from '../../lib/auth';
import { audit, one, run } from '../../lib/db';
import { clearDevCode, stashDevCode, takeDevCode } from '../../lib/devcode';
import { clientIp, safeNext, str } from '../../lib/http';
import { loginCodeMail, sendMail } from '../../lib/mailer';
import { loadActiveUser, setSessionCookie, signSession } from '../../lib/session';
import { now } from '../../lib/time';

if (Astro.locals.user) return Astro.redirect(safeNext(Astro.url.searchParams.get('next')));

const ip = clientIp(Astro.request);
let step: 'email' | 'code' = Astro.url.searchParams.get('step') === 'code' ? 'code' : 'email';
let email = normalizeEmail(Astro.url.searchParams.get('email') ?? '');
let next = safeNext(Astro.url.searchParams.get('next'));
let error = '';

if (Astro.request.method === 'POST') {
  const fd = await Astro.request.formData();
  const action = str(fd, 'action', 20);
  email = normalizeEmail(str(fd, 'email', 254));
  next = safeNext(str(fd, 'next', 500));

  if (action === 'request') {
    if (!looksLikeEmail(email)) {
      error = 'И-мэйл хаягаа зөв оруулна уу.';
    } else if (!(await turnstileOk(str(fd, 'cf-turnstile-response', 4000) || null, ip))) {
      error = 'Хамгаалалтын шалгалт амжилтгүй боллоо. Дахин оролдоно уу.';
    } else if (!(await codeRateOk(email, ip))) {
      error = 'Хэт олон удаа код хүслээ. 15 минутын дараа дахин оролдоно уу.';
    } else {
      // Same response whether or not this address is a member — the member list stays private.
      const u = await one<{ id: number }>(`SELECT id FROM users WHERE email = ? AND status = 'active'`, email);
      if (u && (await loadActiveUser(u.id))) {
        const code = await issueCode(email, 'login');
        await sendMail(loginCodeMail(email, code));
        stashDevCode(Astro.cookies, Astro.url, code);
      }
      const q = new URLSearchParams({ step: 'code', email, ...(next !== '/' ? { next } : {}) });
      return Astro.redirect(`/nevtreh?${q}`);
    }
  }

  if (action === 'verify') {
    step = 'code';
    const result = await verifyCode(email, 'login', str(fd, 'code', 20));
    if (result === 'ok') {
      const u = await one<{ id: number }>(`SELECT id FROM users WHERE email = ?`, email);
      const user = u ? await loadActiveUser(u.id) : null;
      if (user) {
        setSessionCookie(Astro.cookies, Astro.url, await signSession(user.id, user.sessionVersion));
        clearDevCode(Astro.cookies);
        await run(`UPDATE users SET last_login_at = ? WHERE id = ?`, now(), user.id);
        await audit(user.id, 'login', 'user', user.id, null, ip);
        return Astro.redirect(next);
      }
      error = 'Энэ бүртгэл идэвхгүй байна. Тэргүүнд хандана уу.';
    } else if (result === 'locked') {
      error = 'Хэт олон удаа буруу оруулсан тул код хүчингүй боллоо. Шинэ код авна уу.';
    } else if (result === 'expired') {
      error = 'Кодын хугацаа дууссан байна. Шинэ код авна уу.';
    } else {
      error = 'Код буруу байна.';
    }
  }
}

const devCode = step === 'code' ? takeDevCode(Astro.cookies, Astro.url) : null;
const siteKey = env.TURNSTILE_SITE_KEY;
---
<Staff title="Нэвтрэх" bare>
  <Fragment slot="head">
    {siteKey && step === 'email' && <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer is:inline />}
  </Fragment>

  <section class="auth" aria-labelledby="login-h">
    <div class="auth-card">
      <div class="auth-logo"><img src="/brand/logo.svg" alt="" width="56" height="43" /></div>
      <h1 id="login-h">{step === 'email' ? 'Ажлын орчинд нэвтрэх' : 'Кодоо оруулна уу'}</h1>
      <div class="steps-dots" aria-hidden="true"><span class="on"></span><span class:list={{ on: step === 'code' }}></span></div>

      {error && <div class="flash err" role="alert" id="login-err"><Icon name="alert" /><span class="flash-text">{error}</span></div>}

      {
        step === 'email' ? (
          <form method="post">
            <p class="lead" style="margin:0">Бүртгэлтэй и-мэйл хаягаа оруулна уу. Бид 6 оронтой нэг удаагийн код илгээнэ. Нууц үг хэрэггүй.</p>
            <input type="hidden" name="action" value="request" />
            <input type="hidden" name="next" value={next} />
            <div class="field">
              <label for="email">И-мэйл хаяг</label>
              <input id="email" name="email" type="email" autocomplete="email" inputmode="email" required value={email} autofocus
                aria-invalid={error ? 'true' : undefined} aria-describedby={error ? 'login-err' : undefined} />
            </div>
            {siteKey && <div class="cf-turnstile" data-sitekey={siteKey} data-language="auto" />}
            <button class="btn btn-primary btn-lg btn-block" type="submit">Код авах <Icon name="arrow" /></button>
          </form>
        ) : (
          <form method="post">
            <p class="lead" style="margin:0">
              Хэрэв <strong style="color:var(--ink)">{email}</strong> бүртгэлтэй бол түүн рүү код илгээлээ. Код 10 минут хүчинтэй. Спам хавтсаа ч шалгаарай.
            </p>
            <input type="hidden" name="action" value="verify" />
            <input type="hidden" name="email" value={email} />
            <input type="hidden" name="next" value={next} />
            {devCode && (
              <p class="dev-code"><span>Туршилтын горим — таны код:</span> <strong class="num">{devCode}</strong></p>
            )}
            <div class="field">
              <label for="code">6 оронтой код</label>
              <input
                id="code"
                name="code"
                class="code-input"
                inputmode="numeric"
                autocomplete="one-time-code"
                pattern="[0-9 ]{6,7}"
                maxlength="7"
                required
                autofocus
                aria-invalid={error ? 'true' : undefined}
                aria-describedby={error ? 'login-err' : undefined}
              />
            </div>
            <button class="btn btn-primary btn-lg btn-block" type="submit">Нэвтрэх</button>
            <p class="small" style="margin:0;text-align:center"><a href={`/nevtreh?email=${encodeURIComponent(email)}`}>Өөр хаягаар нэвтрэх, эсвэл шинэ код авах</a></p>
          </form>
        )
      }
    </div>
    <p class="foot-note">Бүртгэлгүй бол Тэргүүнээс урилга авна уу.</p>
  </section>
</Staff>
