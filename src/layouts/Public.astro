---
import '@fontsource-variable/golos-text';
import '@fontsource-variable/source-serif-4/opsz.css';
import '../styles/base.css';
import '../styles/public.css';
import { CONSTITUTION } from '../lib/public-docs';

interface Props {
  title?: string;
  description?: string;
  image?: string | null;
}
const {
  title,
  description = 'Бээжингийн Их Сургуульд суралцаж буй Монгол оюутнуудын холбоо — үйл ажиллагаа, удирдлагын баг, холбоо барих мэдээлэл.',
  image,
} = Astro.props;
const NAME = 'Бээжингийн Их Сургуулийн Монгол Оюутны Холбоо';
const full = title ? `${title} · ${NAME}` : NAME;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const nav = [
  { href: '/', label: 'Нүүр' },
  { href: '/taniltsuulga', label: 'Танилцуулга' },
  { href: '/udirdlaga', label: 'Удирдлагын баг' },
  { href: '/uil-ajillagaa', label: 'Үйл ажиллагаа' },
  { href: '/tosov', label: 'Төсөв' },
  { href: '/shine-oyutan', label: 'Шинэ оюутанд' },
  { href: '/holboo-barih', label: 'Холбоо барих' },
];
// The course-review site is its own website; the link just leaves for it.
const COURSES = { href: 'https://course.pkumongolia.com/', label: 'Хичээлийн үнэлгээ' };
const current = (h: string) => (h === '/' ? path === '/' : path === h || path.startsWith(h + '/'));
const ogImage = new URL(image ?? '/brand/logo-512.png', Astro.url).href;
---
<!doctype html>
<html lang="mn">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{full}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0d2138" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="МОХ · Бээжингийн Их Сургууль" />
    <meta property="og:title" content={title ?? NAME} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body class="public">
    <a class="skip" href="#main">Үндсэн агуулга руу шилжих</a>

    <header class="ph-header">
      <div class="wrap ph-bar">
        <a href="/" class="ph-brand" aria-label="Нүүр хуудас — Бээжингийн Их Сургуулийн Монгол Оюутны Холбоо">
          <img src="/brand/logo.svg" alt="" width="58" height="44" />
          <span>
            <span class="t1">Бээжингийн Их Сургуулийн</span>
            <span class="t2">Монгол Оюутны Холбоо</span>
          </span>
        </a>
        <button class="menu-btn" type="button" aria-expanded="false" aria-controls="site-nav">
          <span class="bars" aria-hidden="true"></span> <span class="menu-label">Цэс</span>
        </button>
        <nav id="site-nav" class="ph-nav" aria-label="Үндсэн цэс">
          <ul>
            {nav.map((n) => (
              <li>
                <a href={n.href} aria-current={current(n.href) ? 'page' : undefined}>{n.label}</a>
              </li>
            ))}
            <li>
              <a href={COURSES.href} class="nav-out">{COURSES.label}<span class="out" aria-hidden="true">↗</span><span class="sr-only"> — өөр сайт</span></a>
            </li>
          </ul>
        </nav>
      </div>
    </header>

    <main id="main" tabindex="-1">
      <slot />
    </main>

    <footer class="pf">
      <div class="wrap">
        <div class="pf-grid">
          <div>
            <p class="pf-name">Бээжингийн Их Сургуулийн<br />Монгол Оюутны Холбоо</p>
            <p class="pf-zh" lang="zh-Hans">北京大学蒙古国留学生学生会</p>
            <p class="pf-about">Бээжингийн Их Сургуульд суралцаж буй Монгол оюутнуудын сайн дурын байгууллага.</p>
          </div>
          <div>
            <h2>Хуудсууд</h2>
            <ul>
              {nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
              <li><a href={COURSES.href}>{COURSES.label}</a></li>
              <li><a href={CONSTITUTION.href} target="_blank" rel="noopener">Үндсэн дүрэм (PDF)<span class="sr-only"> — шинэ цонхонд</span></a></li>
            </ul>
          </div>
          <div>
            <h2>Холбогдох</h2>
            <ul>
              <li><a href="mailto:pku_mongolia@163.com">pku_mongolia@163.com</a></li>
              <li><a href="mailto:pkumongolia@gmail.com">pkumongolia@gmail.com</a></li>
              <li><a href="https://www.instagram.com/pku_mongolia/" rel="noopener">Instagram · @pku_mongolia</a></li>
            </ul>
          </div>
        </div>
        <div class="pf-bottom">
          <span>© {new Date().getFullYear()} МОХ</span>
          <span lang="en">Mongolian Student Association at Peking University</span>
        </div>
      </div>
    </footer>

    <script is:inline>
      (function () {
        // Mobile menu: a real button with aria-expanded; without JS the nav is simply always shown.
        var btn = document.querySelector('.menu-btn');
        var nav = document.getElementById('site-nav');
        var label = btn && btn.querySelector('.menu-label');
        function set(open) {
          btn.setAttribute('aria-expanded', String(open));
          nav.classList.toggle('open', open);
          if (label) label.textContent = open ? 'Хаах' : 'Цэс';
        }
        if (btn && nav) {
          btn.addEventListener('click', function () { set(btn.getAttribute('aria-expanded') !== 'true'); });
          document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape' && nav.classList.contains('open')) { set(false); btn.focus(); }
          });
          document.addEventListener('click', function (e) {
            if (nav.classList.contains('open') && !e.target.closest('.ph-header')) set(false);
          });
          matchMedia('(min-width: 1425px)').addEventListener('change', function (m) { if (m.matches) set(false); });
        }
        // Sections rise in as they scroll into view. Only armed when the browser can do it and the
        // visitor hasn't asked for less motion, so nothing is ever left hidden.
        if ('IntersectionObserver' in window && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
          // The title band plays its own sequence in CSS from the first paint (see public.css), so it is not
          // armed here. Everything below it is written in from the left edge, top to bottom: a list arrives item
          // by item, anything else as one block. `--i` is the stagger step (capped so nothing waits long).
          var io = new IntersectionObserver(function (entries) {
            entries.forEach(function (e) { if (e.isIntersecting) show(e.target); });
          }, { rootMargin: '0px 0px -8% 0px' });
          // Once an element has arrived its entrance class is dropped, so its own hover and press transitions
          // (cards lifting, tiles) are not held back by the entrance ones.
          function show(el) {
            if (el.classList.contains('in')) return;
            el.classList.add('in');
            io.unobserve(el);
            setTimeout(function () { el.classList.remove('rv'); }, 2600);
          }
          function arm(el, i) {
            el.classList.add('rv');
            el.style.setProperty('--i', String(Math.min(i, 8)));
            io.observe(el);
          }
          var LISTS = '.rows, .tiles, .triad, .pairs, .numbered, .members, .depts, .cards, .sos, .gallery-p, .spend-by, .timeline-steps, .faq, .nf-links';
          function collect(el, i) {
            if (getComputedStyle(el).display === 'contents') {
              Array.prototype.forEach.call(el.children, function (c, j) { collect(c, i + j); });
            } else if (el.matches(LISTS)) {
              Array.prototype.forEach.call(el.children, function (c, j) { arm(c, i + j); });
            } else if (el.classList.contains('figs')) {
              // the four budget figures arrive one by one, then the bar grows under them
              Array.prototype.forEach.call(el.children, function (c) {
                if (c.classList.contains('figs-grid')) Array.prototype.forEach.call(c.children, function (f, k) { arm(f, i + k); });
                else arm(c, i + 4);
              });
            } else {
              arm(el, i);
            }
          }
          document.querySelectorAll('main .sec > .wrap').forEach(function (g) {
            Array.prototype.forEach.call(g.children, function (el, i) { collect(el, i); });
          });
          document.documentElement.classList.add('reveal-on');
          // A fast jump (End key, a link to #durem, printing) can skip past a section between two frames, and
          // the observer never sees it: anything already above the bottom of the screen shows at once.
          var sweep = function () {
            document.querySelectorAll('.rv:not(.in)').forEach(function (el) {
              if (el.getBoundingClientRect().top < innerHeight) show(el);
            });
          };
          var queued = false;
          addEventListener('scroll', function () { if (!queued) { queued = true; setTimeout(function () { queued = false; sweep(); }, 150); } }, { passive: true });
          addEventListener('beforeprint', function () { document.querySelectorAll('.rv').forEach(function (el) { el.classList.add('in'); }); });
        }
        // Long guide pages: the section menu stays under the header. Its height is shared with the CSS so that
        // anchors and the pinned headings sit below both bars, and the link of the section being read is marked.
        var toc = document.querySelector('.toc.sticky');
        if (toc) {
          var hdr = document.querySelector('.ph-header');
          var row = toc.querySelector('ul');
          var setBars = function () { document.documentElement.style.setProperty('--toc-h', toc.offsetHeight + 'px'); };
          setBars();
          addEventListener('resize', setBars);
          if ('ResizeObserver' in window) new ResizeObserver(setBars).observe(toc);
          if ('IntersectionObserver' in window) {
            var byId = {};
            Array.prototype.forEach.call(toc.querySelectorAll('a[href^="#"]'), function (a) { byId[a.getAttribute('href').slice(1)] = a; });
            var parts = [];
            Object.keys(byId).forEach(function (id) { var el = document.getElementById(id); if (el) parts.push(el); });
            Array.prototype.forEach.call(document.querySelectorAll('[data-toc-for]'), function (el) { parts.push(el); });
            var inBand = [];
            var now = null;
            var reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
            var top = (hdr ? hdr.offsetHeight : 72) + toc.offsetHeight + 8;
            var watch = new IntersectionObserver(function (entries) {
              entries.forEach(function (e) {
                var at = inBand.indexOf(e.target);
                if (e.isIntersecting && at < 0) inBand.push(e.target);
                if (!e.isIntersecting && at >= 0) inBand.splice(at, 1);
              });
              if (!inBand.length) return;
              // the lowest section that reaches into the reading band is the one being read
              inBand.sort(function (a, b) { return a.compareDocumentPosition(b) & 4 ? -1 : 1; });
              var cur = inBand[inBand.length - 1];
              var link = byId[cur.getAttribute('data-toc-for') || cur.id];
              if (!link || link === now) return;
              if (now) now.removeAttribute('aria-current');
              link.setAttribute('aria-current', 'location');
              now = link;
              // only the menu row moves, never the page (scrollIntoView could move both)
              if (row && row.scrollWidth > row.clientWidth) {
                row.scrollTo({ left: link.offsetLeft - (row.clientWidth - link.offsetWidth) / 2, behavior: reduced ? 'auto' : 'smooth' });
              }
            }, { rootMargin: '-' + top + 'px 0px -55% 0px' });
            parts.forEach(function (el) { watch.observe(el); });
          }
        }
        // A soft shadow under the header once the page has scrolled: a 4 px marker at the very top of the
        // page is watched instead of listening to every scroll event.
        var header = document.querySelector('.ph-header');
        if (header && 'IntersectionObserver' in window) {
          var mark = document.createElement('div');
          mark.setAttribute('aria-hidden', 'true');
          mark.style.cssText = 'position:absolute;top:0;left:0;width:1px;height:4px;pointer-events:none';
          document.body.prepend(mark);
          new IntersectionObserver(function (entries) {
            header.classList.toggle('is-scrolled', !entries[0].isIntersecting);
          }).observe(mark);
        }
      })();
    </script>
  </body>
</html>
