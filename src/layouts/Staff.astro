---
import '@fontsource-variable/golos-text';
import '../styles/base.css';
import '../styles/staff.css';
import Icon from '../components/Icon.astro';
import type { IconName } from '../lib/icons';
import { cleanStaffPath } from '../lib/hosts';
import { canManageSettings, canSeeAudit, canSeeParticipation } from '../lib/permissions';
import { ROLE_LABEL } from '../lib/types';
import { flashFrom } from '../lib/http';
import { isTestMode, publicOrigin } from '../lib/site';
import { navCounts } from '../lib/nav';
import { initials } from '../lib/team';

interface Props {
  title: string;
  /** Login and invite pages render without the menu. */
  bare?: boolean;
}
const { title, bare = false } = Astro.props;
const user = Astro.locals.user;
const here = cleanStaffPath(Astro.url.pathname);
const flash = flashFrom(Astro.url);
const test = isTestMode(Astro.url);
const counts = user && !bare ? await navCounts(user) : { awaiting: 0, tasks: 0 };

interface NavItem { href: string; label: string; icon: IconName; count?: number; hot?: boolean }
const groups: { label: string; items: NavItem[] }[] = user
  ? [
      {
        label: 'Ажил',
        items: [
          { href: '/', label: 'Нүүр', icon: 'home' },
          { href: '/barimt', label: 'Баримт бичиг', icon: 'doc', count: counts.awaiting, hot: true },
          { href: '/uil-ajillagaa', label: 'Арга хэмжээ', icon: 'calendar', count: counts.tasks },
        ],
      },
      {
        label: 'Холбоо',
        items: [
          { href: '/heltes', label: 'Хэлтсүүд', icon: 'folder' },
          { href: '/gishuud', label: 'Гишүүд', icon: 'users' },
          { href: '/oroltsoo', label: canSeeParticipation(user) ? 'Оролцоо' : 'Миний оролцоо', icon: 'chart' },
          ...(canSeeAudit(user) ? [{ href: '/burtgel', label: 'Үйлдлийн бүртгэл', icon: 'shield' as IconName }] : []),
          ...(canManageSettings(user) ? [{ href: '/tohirgoo', label: 'Тохиргоо', icon: 'stamp' as IconName }] : []),
        ],
      },
    ]
  : [];
const active = (href: string) => (href === '/' ? here === '/' : here === href || here.startsWith(href + '/'));
const totalCount = counts.awaiting;
const roleText = user ? `${ROLE_LABEL[user.role]}${user.isDeputy ? ' · орлогч' : ''}` : '';
---
<!doctype html>
<html lang="mn">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#0d2138" />
    <title>{title} · МОХ ажлын орчин</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <slot name="head" />
  </head>
  <body class:list={['staff', { bare }]}>
    <a class="skip" href="#main">Үндсэн агуулга руу шилжих</a>
    {test && <div class="test-strip" role="note">ТУРШИЛТЫН ОРЧИН — жинхэнэ мэдээлэл бүү оруулаарай. Нэвтрэх код дэлгэц дээр харагдана.</div>}

    {
      bare ? (
        <main id="main" class="bare-wrap" tabindex="-1">
          <slot />
        </main>
      ) : (
        <div class="app">
          <header class="topbar">
            <a class="side-brand" href="/">
              <span class="logo"><img src="/brand/logo.svg" alt="" width="26" height="20" /></span>
              <span><b>МОХ</b><small>Ажлын орчин</small></span>
            </a>
            <button class="menu-btn" type="button" aria-expanded="false" aria-controls="side">
              <Icon name="menu" />
              Цэс
              {totalCount > 0 && <span class="count hot">{totalCount}<span class="sr-only"> шийдвэр хүлээж байна</span></span>}
            </button>
          </header>

          <aside class="side" id="side" aria-label="Ажлын орчны цэс">
            <div class="drawer-head">
              <b>Цэс</b>
              <button class="icon-btn" type="button" data-close-menu aria-label="Цэс хаах"><Icon name="x" /></button>
            </div>
            <a class="side-brand" href="/">
              <span class="logo"><img src="/brand/logo.svg" alt="" width="34" height="26" /></span>
              <span><b>МОХ</b><small>Ажлын орчин</small></span>
            </a>
            <nav aria-label="Үндсэн цэс">
              {groups.map((g) => (
                <div class="nav-group">
                  <div class="nav-label" aria-hidden="true">{g.label}</div>
                  <ul class="nav-list">
                    {g.items.map((n) => (
                      <li>
                        <a href={n.href} aria-current={active(n.href) ? 'page' : undefined}>
                          <Icon name={n.icon} />
                          {n.label}
                          {!!n.count && (
                            <span class:list={['count', { hot: n.hot }]}>
                              {n.count}
                              <span class="sr-only">{n.hot ? ' шийдвэр хүлээж байна' : ' идэвхтэй ажил'}</span>
                            </span>
                          )}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
            </nav>
            {user && (
              <div class="side-foot">
                <a class="side-link" href={`${publicOrigin(Astro.url)}/`} target="_blank" rel="noopener">
                  <Icon name="globe" /> Нийтийн сайт <span class="sr-only">(шинэ цонхонд)</span>
                </a>
                <div class="me">
                  <span class="avatar gold" aria-hidden="true">{initials(user.name)}</span>
                  <span class="me-text">
                    <b>{user.name}</b>
                    <small>{roleText}</small>
                  </span>
                  <form method="post" action="/gar">
                    <button class="icon-btn" type="submit" aria-label="Гарах" title="Гарах"><Icon name="logout" /></button>
                  </form>
                </div>
              </div>
            )}
          </aside>
          <div class="scrim" data-close-menu></div>

          <div class="content">
            <main id="main" class="main" tabindex="-1">
              {flash.ok && (
                <div class="flash ok" role="status" data-flash>
                  <Icon name="check" />
                  <span class="flash-text">{flash.ok}</span>
                  <button class="flash-x" type="button" aria-label="Хаах"><Icon name="x" /></button>
                </div>
              )}
              {flash.err && (
                <div class="flash err" role="alert" data-flash>
                  <Icon name="alert" />
                  <span class="flash-text">{flash.err}</span>
                  <button class="flash-x" type="button" aria-label="Хаах"><Icon name="x" /></button>
                </div>
              )}
              <slot />
            </main>
            <footer class="foot">Бээжингийн Их Сургуулийн Монгол Оюутны Холбоо · дотоод ажлын орчин</footer>
          </div>
        </div>
      )
    }

    <script is:inline>
      (function () {
        // ---- drawer menu (phones): button toggles, Esc / scrim / × close, the page behind goes inert
        var side = document.getElementById('side');
        var btn = document.querySelector('.menu-btn');
        var content = document.querySelector('.content');
        var scrim = document.querySelector('.scrim');
        function setMenu(open) {
          if (!side || !btn) return;
          side.classList.toggle('open', open);
          if (scrim) scrim.classList.toggle('open', open);
          btn.setAttribute('aria-expanded', String(open));
          if (content) content.inert = open;
          document.documentElement.style.overflow = open ? 'hidden' : '';
          if (open) { var first = side.querySelector('a, button'); if (first) first.focus(); }
          else btn.focus();
        }
        if (btn) btn.addEventListener('click', function () { setMenu(!side.classList.contains('open')); });
        document.querySelectorAll('[data-close-menu]').forEach(function (el) { el.addEventListener('click', function () { setMenu(false); }); });
        document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && side && side.classList.contains('open')) setMenu(false); });
        matchMedia('(min-width: 1000px)').addEventListener('change', function (m) { if (m.matches && side && side.classList.contains('open')) setMenu(false); });

        // ---- flash: dismissable, and removed from the address bar so a refresh doesn't repeat it
        document.querySelectorAll('[data-flash] .flash-x').forEach(function (x) {
          x.addEventListener('click', function () { x.closest('[data-flash]').remove(); });
        });
        var u = new URL(location.href);
        if (u.searchParams.has('ok') || u.searchParams.has('err')) {
          u.searchParams.delete('ok'); u.searchParams.delete('err');
          history.replaceState(null, '', u.pathname + (u.search ? u.search : '') + u.hash);
        }

        // ---- every form: ask before destructive actions, check "required with this button" fields, submit only once
        document.addEventListener('submit', function (e) {
          var form = e.target;
          var by = e.submitter;
          if (form.dataset.busy) { e.preventDefault(); return; }
          var need = by && by.dataset.require ? document.getElementById(by.dataset.require) : null;
          if (need && !need.value.trim()) {
            e.preventDefault();
            need.setAttribute('aria-invalid', 'true');
            var msg = document.getElementById(by.dataset.require + '-msg');
            if (msg) msg.hidden = false;
            need.focus();
            return;
          }
          var ask = (by && by.dataset.confirm) || form.dataset.confirm;
          if (ask && !window.confirm(ask)) { e.preventDefault(); return; }
          form.dataset.busy = '1';
          form.setAttribute('aria-busy', 'true');
          if (by) by.classList.add('is-busy');
          form.dataset.submitted = '1';
        });
        // coming "back" to a page restores it from cache — make its forms usable again
        window.addEventListener('pageshow', function () {
          document.querySelectorAll('form[data-busy]').forEach(function (f) {
            delete f.dataset.busy; f.removeAttribute('aria-busy');
            f.querySelectorAll('.is-busy').forEach(function (b) { b.classList.remove('is-busy'); });
          });
        });

        // ---- long forms: warn before leaving with unsaved changes
        document.querySelectorAll('form[data-guard]').forEach(function (f) {
          var dirty = false;
          f.addEventListener('input', function () { dirty = true; });
          window.addEventListener('beforeunload', function (e) {
            if (dirty && !f.dataset.submitted) { e.preventDefault(); e.returnValue = ''; }
          });
        });

        // ---- copy buttons
        document.querySelectorAll('[data-copy]').forEach(function (b) {
          b.addEventListener('click', function () {
            var input = document.getElementById(b.dataset.copy);
            if (!input) return;
            input.select();
            var label = b.querySelector('[data-label]') || b;
            var done = function () {
              var was = label.textContent; label.textContent = 'Хуулсан ✓';
              setTimeout(function () { label.textContent = was; }, 2000);
            };
            // Without the clipboard API the text is at least selected, ready for Ctrl+C / long-press.
            if (navigator.clipboard) navigator.clipboard.writeText(input.value).then(done);
          });
        });
      })();
    </script>
  </body>
</html>
