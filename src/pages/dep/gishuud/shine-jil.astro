---
/**
 * The September ritual (Idea 1): accounts expire by default, and the President confirms who stays.
 * Doing nothing is the safe outcome — anyone not renewed simply stops working on 30 September.
 */
export const prerender = false;
import Staff from '../../../layouts/Staff.astro';
import PageHead from '../../../components/PageHead.astro';
import Icon from '../../../components/Icon.astro';
import { clientIp, str, withFlash } from '../../../lib/http';
import { archiveLapsed, asMemberLike, nextTerm, renewalCandidates, renewMembers } from '../../../lib/members';
import * as P from '../../../lib/permissions';
import { academicYear, fmtDate, now } from '../../../lib/time';
import { ROLE_LABEL } from '../../../lib/types';

const user = Astro.locals.user!;
if (!P.canManageMembers(user)) return Astro.redirect(withFlash('/gishuud', 'denied', 'err'));

if (Astro.request.method === 'POST') {
  const fd = await Astro.request.formData();
  const ip = clientIp(Astro.request);
  if (str(fd, 'action', 20) === 'archive') {
    await archiveLapsed(user.id);
    return Astro.redirect(withFlash('/gishuud/shine-jil', 'saved'));
  }
  const ids = fd.getAll('renew').map((v) => Number(v)).filter(Number.isInteger);
  await renewMembers(user, ids, ip);
  return Astro.redirect(withFlash('/gishuud/shine-jil', 'renewed'));
}

const rows = await renewalCandidates();
const t = now();
const lapsed = rows.filter((m) => (m.term_ends_at ?? 0) < t).length;
// President may renew their own term; otherwise the usual member-change rule applies (a deputy renews heads and members).
const canRenew = (id: number) => (user.role === 'president' && id === user.id) || P.canModifyMember(user, asMemberLike(rows.find((r) => r.id === id)!));
---
<Staff title="Шинэ жилийн бүртгэл">
  <PageHead title="Шинэ жилийн бүртгэл" sub={`${academicYear()} · Үргэлжлүүлэн ажиллах хүмүүсийг тэмдэглэж эрхийг нь сунгана.`} crumbs={[{ href: '/gishuud', label: 'Гишүүд' }]} />

  <div class="flash info" role="note">
    <Icon name="clock" />
    <span class="flash-text">
      Ажлын орчны эрх жил бүрийн <strong>9-р сарын 30-нд</strong> автоматаар дуусна. Тэмдэглээгүй хүмүүсийн эрх хугацаа нь дуусахад
      өөрөө хаагдана — хэнийг хасахаа санах шаардлагагүй. Тэдний бичсэн бүх баримт хэвээр үлдэнэ.
    </span>
  </div>

  {
    rows.length === 0 ? (
      <div class="empty good"><Icon name="check" /><b>Ойрын 60 хоногт эрх нь дуусах хүн алга.</b></div>
    ) : (
      <form method="post" class="panel">
        <div class="table-wrap" style="border:0;box-shadow:none;border-radius:var(--radius-lg) var(--radius-lg) 0 0">
          <table class="t">
            <caption class="sr-only">Эрх нь удахгүй дуусах хүмүүс</caption>
            <thead>
              <tr>
                <th scope="col" style="width:44px"><input type="checkbox" id="all" aria-label="Бүгдийг сонгох" /></th>
                <th scope="col">Нэр</th>
                <th scope="col">Эрх</th>
                <th scope="col">Одоо дуусах</th>
                <th scope="col">Сунгавал</th>
              </tr>
            </thead>
            <tbody>
              {rows.map((m) => {
                const ok = canRenew(m.id);
                const gone = (m.term_ends_at ?? 0) < t;
                return (
                  <tr>
                    <td>{ok && <input type="checkbox" name="renew" value={m.id} class="pick" id={`r_${m.id}`} />}</td>
                    <td>
                      {ok ? <label for={`r_${m.id}`}><strong>{m.name_mn}</strong></label> : <strong>{m.name_mn}</strong>}
                      {m.id === user.id && <span class="muted small"> (та)</span>}
                      <span class="sub">{m.dept_name ?? '—'}</span>
                    </td>
                    <td class="nowrap">{ROLE_LABEL[m.role]}</td>
                    <td class:list={['nowrap num', { lapsed: gone }]}>{fmtDate(m.term_ends_at)}{gone && ' · дууссан'}</td>
                    <td class="nowrap num muted">{fmtDate(nextTerm(m.term_ends_at))}</td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
        <div class="form-actions">
          <button class="btn btn-primary" type="submit" data-renew-btn>Сонгосон хүмүүсийн эрхийг сунгах</button>
          <span class="form-note" data-renew-count aria-live="polite">0 хүн сонгогдсон</span>
          <span class="grow"></span>
          <a class="btn btn-quiet" href="/gishuud">Буцах</a>
        </div>
      </form>
    )
  }

  {lapsed > 0 && (
    <form method="post" class="panel" style="margin-top:20px" data-confirm={`Хугацаа нь дууссан ${lapsed} хүнийг идэвхгүй болгох уу?`}>
      <input type="hidden" name="action" value="archive" />
      <div class="panel-head"><h2>Хугацаа нь дууссан {lapsed} хүн</h2></div>
      <div class="panel-body stack" style="--stack:12px">
        <p class="form-note">Тэд аль хэдийн нэвтэрч чадахгүй байгаа. Жагсаалтаас гаргаж, «идэвхгүй» болгох бол дарна уу.</p>
        <button class="btn btn-sm" type="submit">Идэвхгүй болгох</button>
      </div>
    </form>
  )}
</Staff>

<script is:inline>
  (function () {
    var all = document.getElementById('all');
    var picks = Array.prototype.slice.call(document.querySelectorAll('.pick'));
    var out = document.querySelector('[data-renew-count]');
    var btn = document.querySelector('[data-renew-btn]');
    function sync() {
      var n = picks.filter(function (c) { return c.checked; }).length;
      if (out) out.textContent = n + ' хүн сонгогдсон';
      if (btn) btn.disabled = n === 0;
      if (all) { all.checked = n > 0 && n === picks.length; all.indeterminate = n > 0 && n < picks.length; }
    }
    if (all) all.addEventListener('change', function () { picks.forEach(function (c) { c.checked = all.checked; }); sync(); });
    picks.forEach(function (c) { c.addEventListener('change', sync); });
    sync();
  })();
</script>
