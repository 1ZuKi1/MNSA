const ways = [
  { k: 'Өөрөө', v: 'Ойролцоогоор ¥400. 北京市公安局海淀分局外国人出入境服务大厅, 09:00–17:00. zwfw.gaj.beijing.gov.cn/rp хаягаар урьдчилан цаг авна.' },
  { k: 'Холбоогоор', v: 'Ойролцоогоор ¥500.' },
  { k: 'Сургуулиар', v: 'Ойролцоогоор ¥600. Удаж магадгүй.' },
  { k: 'Материал', v: 'Паспорт, JW201/202, элсэлтийн захиа, эмчийн үзлэгийн хариу, сургуулийн тамгатай виз мэдүүлгийн маягт, оршин суух тодорхойлолт (住宿登记表 — дотуур байранд бол 1-р байрнаас, хувиараа бол цагдаагийн хэсгээс), 48×33 мм цээж зураг.' },
];

const routes = [
