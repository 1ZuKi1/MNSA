---
export const prerender = false;
import Staff from '../../../layouts/Staff.astro';
import PageHead from '../../../components/PageHead.astro';
import Icon from '../../../components/Icon.astro';
import PhotoShrink from '../../../components/PhotoShrink.astro';
import { departments, many } from '../../../lib/db';
import {
  addPhoto, addTask, assignTask, cancelTask, dropAssignment, eventPhotos, eventTasks, finishAssignment, getEvent,
  removePhoto, setCover, setEventStatus,
} from '../../../lib/events';
import { clientIp, int, safeNext, str, withFlash } from '../../../lib/http';
import { BadImage, mediaUrl, storeImage } from '../../../lib/media';
import * as P from '../../../lib/permissions';
import { Denied } from '../../../lib/records';
import { dayDiff, fmtDate, fmtDateTime, fromLocal, now, relDay } from '../../../lib/time';
import type { DeptSlug } from '../../../lib/types';
import { publicOrigin } from '../../../lib/site';
import { initials } from '../../../lib/team';

const user = Astro.locals.user!;
const id = int(Astro.params.id);
const ev = id ? await getEvent(id) : null;
if (!ev) return new Response(null, { status: 404 });
const here = `/uil-ajillagaa/${ev.id}`;
const editor = P.canEditEvents(user);
const manager = P.canManageTasks(user, ev.dept_slug);

if (Astro.request.method === 'POST') {
  const fd = await Astro.request.formData();
  const action = str(fd, 'action', 20);
  const back = safeNext(str(fd, 'back', 200), here);
  const ip = clientIp(Astro.request);
  try {
    let key = 'saved';
    switch (action) {
      case 'publish': await setEventStatus(user, ev, 'published', ip); key = 'published'; break;
      case 'unpublish': await setEventStatus(user, ev, 'draft', ip); key = 'unpublished'; break;
      case 'cancel': await setEventStatus(user, ev, 'cancelled', ip); key = 'cancelled'; break;
      case 'take': await assignTask(user, ev, int(str(fd, 'task')) ?? 0, user.id, ip); key = 'taken'; break;
      case 'assign': await assignTask(user, ev, int(str(fd, 'task')) ?? 0, int(str(fd, 'user')) ?? 0, ip); key = 'assigned'; break;
      case 'done': await finishAssignment(user, ev, int(str(fd, 'assignment')) ?? 0, ip); key = 'done'; break;
      case 'drop': await dropAssignment(user, ev, int(str(fd, 'assignment')) ?? 0, ip); key = 'dropped'; break;
      case 'cancel_task': await cancelTask(user, ev, int(str(fd, 'task')) ?? 0, ip); key = 'cancelled'; break;
      case 'add_task': {
        const title = str(fd, 'title', 200);
        const due = str(fd, 'due', 10);
        const dept = str(fd, 'dept', 40);
        if (!title) return Astro.redirect(withFlash(here, 'invalid', 'err'));
        const valid = (await departments()).some((d) => d.slug === dept);
        await addTask(user, ev, { title, dueAt: due ? fromLocal(due, '23:59') : null, dept: valid ? (dept as DeptSlug) : null, notes: str(fd, 'notes', 1000) }, ip);
        key = 'created';
        break;
      }
      case 'photo': {
        if (!editor) throw new Denied();
        const file = fd.get('file');
        if (!(file instanceof File) || file.size === 0) return Astro.redirect(withFlash(here, 'invalid', 'err'));
        const mediaId = await storeImage(file, user.id, int(str(fd, 'w')) ?? undefined, int(str(fd, 'h')) ?? undefined);
        await addPhoto(user, ev, mediaId, str(fd, 'caption', 300), ip);
        key = 'photo';
        break;
      }
      case 'remove_photo': await removePhoto(user, ev, int(str(fd, 'photo')) ?? 0, ip); key = 'removed'; break;
      case 'cover': await setCover(user, ev, str(fd, 'media', 64), ip); break;
    }
    return Astro.redirect(withFlash(back, key));
  } catch (e) {
    if (e instanceof BadImage) return Astro.redirect(withFlash(here, 'invalid', 'err'));
    if (e instanceof Denied) return Astro.redirect(withFlash(back, 'denied', 'err'));
    throw e;
  }
}

const [tasks, photos, people, depts] = await Promise.all([
  eventTasks(ev.id),
  eventPhotos(ev.id),
  manager
    ? many<{ id: number; name_mn: string; dept_name: string | null }>(
        `SELECT u.id, u.name_mn, d.name_mn AS dept_name FROM users u LEFT JOIN departments d ON d.id = u.department_id
          WHERE u.status = 'active' AND u.role <> 'maintainer' ORDER BY d.sort_order, u.name_mn`,
      )
    : Promise.resolve([]),
  departments(),
]);
const isPast = ev.ends_at < now();
const publicUrl = `${publicOrigin(Astro.url)}/uil-ajillagaa/${ev.id}`;
const STATUS = { draft: 'Ноорог', published: 'Нийтлэгдсэн', cancelled: 'Цуцлагдсан' } as const;
const TASK = { open: 'Нээлттэй', done: 'Дууссан', cancelled: 'Цуцлагдсан' } as const;
const liveTasks = tasks.filter((t) => t.status !== 'cancelled');
const doneCount = liveTasks.filter((t) => t.status === 'done').length;
const t0 = now();
const when = `${fmtDateTime(ev.starts_at)} – ${fmtDate(ev.ends_at) === fmtDate(ev.starts_at) ? fmtDateTime(ev.ends_at).slice(11) : fmtDateTime(ev.ends_at)}`;
---
<Staff title={ev.title}>
  <PageHead title={ev.title} crumbs={[{ href: '/uil-ajillagaa', label: 'Арга хэмжээ' }]}>
    <Fragment slot="actions">
      {editor && <a class="btn" href={`${here}/zasah`}><Icon name="edit" /> Засах</a>}
      {editor && ev.status !== 'published' && ev.status !== 'cancelled' && (
        <form method="post" data-confirm="Нийтийн сайтад гаргах уу? Тэр даруй бүх хүнд харагдана.">
          <button class="btn btn-ok" name="action" value="publish"><Icon name="globe" /> Нийтлэх</button>
        </form>
      )}
      {editor && ev.status === 'published' && (
        <form method="post" data-confirm="Нийтийн сайтаас буцааж, ноорог болгох уу?">
          <button class="btn" name="action" value="unpublish">Нийтлэлээс буцаах</button>
        </form>
      )}
    </Fragment>
    <span class={`badge b-${ev.status}`}>{STATUS[ev.status]}</span>
    <span>{isPast ? 'Өнгөрсөн' : `Удахгүй болох · ${relDay(ev.starts_at)}`}</span>
    {ev.status === 'published' && (
      <a href={publicUrl} target="_blank" rel="noopener" class="tag" style="color:var(--blue)">
        <Icon name="external" /> Нийтийн хуудсанд харах<span class="sr-only"> (шинэ цонхонд)</span>
      </a>
    )}
  </PageHead>

  <div class="cols ev-cols">
    <div>
      <section class="panel" aria-labelledby="tasks-h" id="tasks">
        <div class="panel-head">
          <h2 id="tasks-h"><Icon name="check" /> Ажлууд</h2>
          {liveTasks.length > 0 && (
            <span class="progress-line" style="margin:0">
              <span class="progress" style="width:120px" role="img" aria-label={`${liveTasks.length} ажлаас ${doneCount} нь дууссан`}>
                <span style={`width:${Math.round((doneCount / liveTasks.length) * 100)}%`} />
              </span>
              <span>{doneCount}/{liveTasks.length} дууссан</span>
            </span>
          )}
        </div>
        <div class="panel-body">
          {tasks.length === 0 ? (
            <div class="empty"><Icon name="check" /><b>Ажил нэмэгдээгүй байна.</b>{manager && <p>Доорх «Ажил нэмэх» товчоор нэмнэ үү.</p>}</div>
          ) : (
            <ul class="tasks">
              {tasks.map((t) => {
                const active = t.assignees.filter((x) => x.status === 'active');
                const mine = active.find((x) => x.user_id === user.id);
                const open = t.status === 'open';
                const d = t.due_at ? dayDiff(t.due_at, t0) : null;
                const late = open && d !== null && d < 0;
                return (
                  <li class:list={['task', { 'is-done': t.status === 'done' }]}>
                    <div class="task-top">
                      <span class="task-title">{t.title}</span>
                      <span class={`badge b-${t.status}`}>{TASK[t.status]}</span>
                      {t.notes && <p class="task-notes">{t.notes}</p>}
                      <span class="task-meta">
                        {t.due_at && (
                          <span class:list={['tag', { overdue: late }]}>
                            <Icon name="clock" /> {fmtDate(t.due_at)}{open && ` · ${late ? `${-d!} хоног хэтэрсэн` : relDay(t.due_at)}`}
                          </span>
                        )}
                        {t.dept_name && <span class="tag"><Icon name="folder" /> {t.dept_name}</span>}
                      </span>
                    </div>
                    <div class="task-bottom">
                      <ul class="people" aria-label="Хариуцагч">
                        {t.assignees.length === 0 && open && <li class="chip need-chip">Хүн хэрэгтэй</li>}
                        {t.assignees.filter((x) => x.status !== 'dropped').map((x) => (
                          <li class:list={['chip', { me: x.user_id === user.id, done: x.status === 'done' }]}>
                            <span class="avatar sm" aria-hidden="true">{initials(x.user_name)}</span>
                            {x.user_name}
                            {x.status === 'done' && <Icon name="check" label="дууссан" />}
                            {x.volunteered === 1 && <Icon name="hand" label="Сайн дураар авсан" />}
                          </li>
                        ))}
                      </ul>
                      <div class="task-acts">
                        {open && !mine && P.canTakeTask(user) && (
                          <form method="post">
                            <input type="hidden" name="task" value={t.id} />
                            <button class:list={['btn btn-sm', active.length ? '' : 'btn-blue']} name="action" value="take">
                              {active.length ? <><Icon name="plus" /> Нэгдэх</> : 'Би хийнэ'}
                            </button>
                          </form>
                        )}
                        {mine && (
                          <form method="post">
                            <input type="hidden" name="assignment" value={mine.id} />
                            <button class="btn btn-sm btn-ok" name="action" value="done"><Icon name="check" /> Дууссан</button>
                            <button class="btn btn-sm btn-quiet" name="action" value="drop" data-confirm="Энэ ажлаас гарах уу?">Орхих</button>
                          </form>
                        )}
                      </div>
                    </div>
                    {manager && open && (
                      <details class="manage">
                        <summary class="btn btn-sm btn-quiet">Удирдах <Icon name="arrow" class="rot" /></summary>
                        <div class="manage-body">
                          <form method="post" class="manage-row">
                            <input type="hidden" name="task" value={t.id} />
                            <div class="field">
                              <label class="label" for={`as_${t.id}`}>Хүн хуваарилах</label>
                              <select id={`as_${t.id}`} name="user">
                                {people.filter((p) => !active.some((x) => x.user_id === p.id)).map((p) => (
                                  <option value={p.id}>{p.name_mn}{p.dept_name ? ` — ${p.dept_name}` : ''}</option>
                                ))}
                              </select>
                            </div>
                            <button class="btn btn-sm" name="action" value="assign">Хуваарилах</button>
                          </form>
                          {active.filter((x) => x.user_id !== user.id).map((x) => (
                            <form method="post" class="assignee-row">
                              <input type="hidden" name="assignment" value={x.id} />
                              <span class="grow">{x.user_name}</span>
                              <button class="btn btn-sm btn-ok" name="action" value="done">Дууссан гэж тэмдэглэх</button>
                              <button class="btn btn-sm btn-quiet" name="action" value="drop" data-confirm={`«${x.user_name}» гишүүнийг энэ ажлаас хасах уу?`}>Хасах</button>
                            </form>
                          ))}
                          <form method="post">
                            <input type="hidden" name="task" value={t.id} />
                            <button class="btn btn-sm btn-danger" name="action" value="cancel_task" data-confirm="Энэ ажлыг цуцлах уу?"><Icon name="trash" /> Ажлыг цуцлах</button>
                          </form>
                        </div>
                      </details>
                    )}
                  </li>
                );
              })}
            </ul>
          )}
          <p class="legend">
            <span><Icon name="hand" /> сайн дураар авсан</span>
            <span><Icon name="check" /> дууссан</span>
            <span>Бүх хуваарилалт жилийн оролцооны бүртгэлд хадгалагдана.</span>
          </p>

          {manager && ev.status !== 'cancelled' && (
            <details class="add-block" open={tasks.length === 0}>
              <summary class="btn btn-sm"><Icon name="plus" /> Ажил нэмэх</summary>
              <form method="post">
                <input type="hidden" name="action" value="add_task" />
                <div class="field">
                  <label for="t_title">Ажил</label>
                  <input id="t_title" name="title" type="text" required maxlength="200" placeholder="Жишээ нь: Зурагт хуудас хийх" />
                </div>
                <div class="two">
                  <div class="field">
                    <label for="t_due">Хугацаа <span class="opt">(заавал биш)</span></label>
                    <input id="t_due" name="due" type="date" />
                  </div>
                  <div class="field">
                    <label for="t_dept">Хэлтэс <span class="opt">(заавал биш)</span></label>
                    <select id="t_dept" name="dept">
                      <option value="">—</option>
                      {depts.filter((d) => !d.is_leadership).map((d) => <option value={d.slug} selected={d.slug === ev.dept_slug}>{d.name_mn}</option>)}
                    </select>
                  </div>
                </div>
                <div class="field">
                  <label for="t_notes">Тэмдэглэл <span class="opt">(заавал биш)</span></label>
                  <input id="t_notes" name="notes" type="text" maxlength="1000" />
                </div>
                <div><button class="btn btn-primary" type="submit">Нэмэх</button></div>
              </form>
            </details>
          )}
        </div>
      </section>

      <section class="panel" aria-labelledby="photos-h">
        <div class="panel-head">
          <h2 id="photos-h"><Icon name="image" /> Зураг</h2>
          <span class="muted small">{photos.length}</span>
        </div>
        <div class="panel-body">
          {photos.length === 0 ? (
            <div class="empty"><Icon name="image" /><p>Зураг алга.{isPast && editor && ' Арга хэмжээ өнгөрсөн тул зургаа нэмээрэй — нийтийн хуудсанд харагдана.'}</p></div>
          ) : (
            <div class="photos">
              {photos.map((p) => (
                <figure>
                  <div class="photo-frame">
                    <img src={mediaUrl(p.media_id)} alt={p.caption ?? `${ev.title} — зураг`} loading="lazy" />
                    {ev.cover_media_id === p.media_id && <span class="badge plain b-maroon"><Icon name="star" /> Нүүр зураг</span>}
                  </div>
                  {p.caption && <figcaption>{p.caption}</figcaption>}
                  {editor && (
                    <form method="post" class="photo-actions">
                      <input type="hidden" name="photo" value={p.id} />
                      <input type="hidden" name="media" value={p.media_id} />
                      {ev.cover_media_id !== p.media_id && <button class="linkish" name="action" value="cover">Нүүр зураг болгох</button>}
                      <button class="linkish danger" name="action" value="remove_photo" data-confirm="Энэ зургийг устгах уу? Буцаах боломжгүй.">Устгах</button>
                    </form>
                  )}
                </figure>
              ))}
            </div>
          )}
          {editor && (
            <form method="post" enctype="multipart/form-data" class="upload" data-photo-form>
              <input type="hidden" name="action" value="photo" />
              <input type="hidden" name="w" value="" />
              <input type="hidden" name="h" value="" />
              <label class="drop">
                <Icon name="image" />
                <b>Зураг сонгох</b>
                <span data-status>Утасны зураг ч болно — илгээхээс өмнө автоматаар жижигрүүлнэ.</span>
                <input id="file" name="file" type="file" accept="image/jpeg,image/png,image/webp" required />
              </label>
              <img class="preview" alt="Сонгосон зураг" data-preview />
              <div class="field">
                <label for="caption">Тайлбар <span class="opt">(заавал биш)</span></label>
                <input id="caption" name="caption" type="text" maxlength="300" />
              </div>
              <div><button class="btn btn-primary" type="submit"><Icon name="plus" /> Байршуулах</button></div>
            </form>
          )}
        </div>
      </section>
    </div>

    <div>
      <section class="panel ev-facts" aria-labelledby="facts-h">
        <div class="panel-head"><h2 id="facts-h">Мэдээлэл</h2></div>
        <div class="panel-body">
          <dl class="facts" style="grid-template-columns:1fr">
            <div><Icon name="calendar" /><dt>Хэзээ</dt><dd>{when}</dd></div>
            <div><Icon name="pin" /><dt>Хаана</dt><dd>{ev.location ?? '—'}</dd></div>
            <div><Icon name="folder" /><dt>Зохион байгуулах</dt><dd>{ev.dept_name ?? 'Холбоо бүхэлдээ'}</dd></div>
            <div><Icon name="globe" /><dt>Нийтэлсэн</dt><dd>{ev.publisher_name ? `${ev.publisher_name} · ${fmtDate(ev.published_at)}` : 'Нийтлэгдээгүй'}</dd></div>
            {ev.source_record_id && <div><Icon name="doc" /><dt>Хүсэлт</dt><dd><a href={`/barimt/${ev.source_record_id}`}>Батлагдсан хүсэлт →</a></dd></div>}
          </dl>
          {ev.summary && <p style="margin:16px 0 0;color:var(--ink-2)">{ev.summary}</p>}
          {ev.body && (
            <details style="margin-top:10px">
              <summary class="linkish">Дэлгэрэнгүй</summary>
              <p class="pre small" style="margin-top:8px">{ev.body}</p>
            </details>
          )}
        </div>
      </section>

      {editor && ev.status !== 'cancelled' && !isPast && (
        <section class="panel danger-zone" aria-labelledby="cancel-h">
          <div class="panel-head"><h2 id="cancel-h">Цуцлах</h2></div>
          <div class="panel-body">
            <p class="small muted">Арга хэмжээ болохгүй болсон бол цуцална. Ажил, хуваарилалт бүртгэлд хадгалагдана.</p>
            <form method="post" data-confirm="Арга хэмжээг цуцлах уу? Нийтийн сайтаас алга болно.">
              <button class="btn btn-danger btn-sm" name="action" value="cancel">Арга хэмжээг цуцлах</button>
            </form>
          </div>
        </section>
      )}
    </div>
  </div>
</Staff>

<PhotoShrink />
