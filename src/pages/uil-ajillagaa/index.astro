---
// Rendered per request (because "upcoming" depends on today's date) and cached 5 minutes at Cloudflare's edge.
export const prerender = false;
import Public from '../../layouts/Public.astro';
import Band from '../../components/Band.astro';
import EventRows from '../../components/EventRows.astro';
import { publicEvents } from '../../lib/events';
import { mediaUrl } from '../../lib/media';
import { dateKey, fmtLong } from '../../lib/time';

const { upcoming, past } = await publicEvents();
---
<Public title="Үйл ажиллагаа" description="Бээжингийн Их Сургуулийн Монгол Оюутны Холбооны удахгүй болох болон өнгөрсөн арга хэмжээ.">
  <Band kicker="Үйл ажиллагаа" title="Арга хэмжээ" lede="Холбооны зохион байгуулдаг уулзалт, баяр ёслол, спорт, сургалт. Өнгөрсөн арга хэмжээ бүр зураг, тайлантайгаа энд хадгалагдана." />

  <section class="sec" aria-labelledby="up-h">
    <div class="wrap">
      <span class="sec-label">Хуанли</span>
      <h2 id="up-h">Удахгүй болох</h2>
      <EventRows events={upcoming} />
    </div>
  </section>

  <section class="sec" id="past" aria-labelledby="past-h">
    <div class="wrap">
      <span class="sec-label">Дурсамж</span>
      <h2 id="past-h">Өнгөрсөн арга хэмжээ</h2>
      {
        past.length === 0 ? (
          <p class="empty">Одоогоор алга.</p>
        ) : (
          <div class="cards">
            {past.map((e) => (
              <a class="card-p" href={`/uil-ajillagaa/${e.id}`}>
                <div class="img">
                  {e.cover_media_id ? (
                    <img src={mediaUrl(e.cover_media_id)} alt="" loading="lazy" />
                  ) : (
                    // no photo yet: the day it happened, large, instead of a stand-in picture
                    <span class="ph-date" aria-hidden="true"><b>{dateKey(e.starts_at).day}</b><small>{fmtLong(e.starts_at).slice(0, 4)}</small></span>
                  )}
                </div>
                <div class="body">
                  <p class="when">{fmtLong(e.starts_at)}</p>
                  <h3>{e.title}</h3>
                  {e.summary && <p>{e.summary}</p>}
                  {e.publisher_name && <p class="by">Нийтэлсэн: {e.publisher_name}</p>}
                </div>
              </a>
            ))}
          </div>
        )
      }
    </div>
  </section>
</Public>
