---
export const prerender = false;
import Staff from '../../layouts/Staff.astro';
import PageHead from '../../components/PageHead.astro';
import Icon from '../../components/Icon.astro';
import { many } from '../../lib/db';
import * as P from '../../lib/permissions';
const { canSeeAudit } = P;
import { fmtDateTime } from '../../lib/time';

const user = Astro.locals.user!;
if (!canSeeAudit(user)) return new Response(null, { status: 404 });

const CATS = { '': 'Бүгд', record: 'Баримт', event: 'Арга хэмжээ', task: 'Ажил', member: 'Гишүүд', invite: 'Урилга', login: 'Нэвтрэлт' } as const;
const askedCat = Astro.url.searchParams.get('cat') ?? '';
const cat = (askedCat in CATS ? askedCat : '') as keyof typeof CATS;
const rows = await many<{ id: number; action: string; entity_type: string | null; entity_id: string | null; detail: string | null; ip: string | null; created_at: number; actor: string | null }>(
  `SELECT a.id, a.action, a.entity_type, a.entity_id, a.detail, a.ip, a.created_at, u.name_mn AS actor
     FROM audit_log a LEFT JOIN users u ON u.id = a.actor_id
    ${cat ? `WHERE a.action = ?1 OR a.action LIKE ?2` : ''}
    ORDER BY a.id DESC LIMIT 300`,
  ...(cat ? [cat, `${cat}.%`] : []),
);

const LABEL: Record<string, string> = {
  login: 'Нэвтэрсэн', 'login.locked': 'Код олон удаа буруу',
  'record.create': 'Баримт үүсгэсэн', 'record.edit': 'Баримт зассан', 'record.submit': 'Хянуулахаар илгээсэн',
  'record.approve': 'Баталсан', 'record.reject': 'Буцаасан', 'record.withdraw': 'Эргүүлэн татсан', 'record.void': 'Хүчингүй болгосон',
  'event.create': 'Арга хэмжээ үүсгэсэн', 'event.edit': 'Арга хэмжээ зассан', 'event.published': 'Нийтэлсэн', 'event.draft': 'Нийтлэлээс буцаасан',
  'event.cancelled': 'Арга хэмжээ цуцалсан', 'event.photo': 'Зураг нэмсэн', 'event.photo.remove': 'Зураг устгасан', 'event.cover': 'Нүүр зураг сольсон',
  'task.create': 'Ажил нэмсэн', 'task.take': 'Ажил авсан', 'task.assign': 'Ажил хуваарилсан', 'task.done': 'Ажил дуусгасан',
  'task.drop': 'Ажлаас гарсан', 'task.cancel': 'Ажил цуцалсан',
  'invite.create': 'Урилга үүсгэсэн', 'invite.claim': 'Урилгаар бүртгүүлсэн', 'invite.revoke': 'Урилга цуцалсан',
  'member.change': 'Эрх өөрчилсөн', 'member.remove': 'Гишүүн хассан', 'member.deputy': 'Орлогч томилсон',
  'member.email': 'И-мэйл сольсон', 'member.public.show': 'Нийтийн хуудсанд харуулсан', 'member.public.hide': 'Нийтийн хуудаснаас нуусан', 'member.renew': 'Эрх сунгасан', 'member.archive-lapsed': 'Хугацаа дууссаныг идэвхгүй болгосон',
  'member.import': 'Жагсаалтаас оруулсан', 'member.photo': 'Зураг сольсон', 'member.photo.remove': 'Зураг устгасан', 'settings.stamp': 'Тамга сольсон', 'settings.stamp.remove': 'Тамга устгасан',
};
const href = (t: string | null, id: string | null) =>
  !id ? null : t === 'record' ? `/barimt/${id}` : t === 'event' ? `/uil-ajillagaa/${id}` : t === 'user' && P.canManageMembers(user) ? `/gishuud/${id}` : null;
const ENTITY: Record<string, string> = { record: 'Баримт', event: 'Арга хэмжээ', task: 'Ажил', user: 'Гишүүн', invite: 'Урилга', media: 'Зураг' };
---
<Staff title="Үйлдлийн бүртгэл">
  <PageHead title="Үйлдлийн бүртгэл" sub="Сүүлийн 300 үйлдэл. Энэ бүртгэлийг ажлын орчноос хэн ч, тэр дундаа Тэргүүн ч засах, устгах боломжгүй." />

  <nav class="tabs" aria-label="Төрлөөр шүүх">
    {Object.entries(CATS).map(([k, v]) => (
      <a href={k ? `/burtgel?cat=${k}` : '/burtgel'} aria-current={cat === k ? 'page' : undefined}>{v}</a>
    ))}
  </nav>

  {rows.length === 0 ? (
    <div class="empty"><Icon name="shield" /><p>Энэ төрлийн үйлдэл алга.</p></div>
  ) : (
    <div class="table-wrap cards-sm">
      <table class="t">
        <caption class="sr-only">Үйлдлийн бүртгэл, шинэ нь эхэндээ</caption>
        <thead><tr><th scope="col">Хэзээ</th><th scope="col">Хэн</th><th scope="col">Юу</th><th scope="col">Хаана</th>{user.role !== 'board' && <th scope="col">IP</th>}</tr></thead>
        <tbody>
          {rows.map((r) => {
            const h = href(r.entity_type, r.entity_id);
            const where = r.entity_id ? `${ENTITY[r.entity_type ?? ''] ?? r.entity_type} #${r.entity_id}` : '';
            return (
              <tr>
                <td class="nowrap num small side-cell">{fmtDateTime(r.created_at)}</td>
                <td class="nowrap main-cell"><b>{r.actor ?? '—'}</b><span class="sub m-only">{LABEL[r.action] ?? r.action}{where && ` · ${where}`}</span></td>
                <td class="hide-sm">{LABEL[r.action] ?? r.action}</td>
                <td class="small hide-sm">{h ? <a href={h}>{where}</a> : where}</td>
                {user.role !== 'board' && <td class="small muted num hide-sm">{r.ip ?? ''}</td>}
              </tr>
            );
          })}
        </tbody>
      </table>
    </div>
  )}
</Staff>
