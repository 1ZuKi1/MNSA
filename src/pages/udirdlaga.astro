---
// Generated from the members table: when the President adds, moves or removes someone in the staff
// workspace, or someone uploads their photo, this page follows within 5 minutes. Nobody edits HTML
// when the team changes.
//
// Top to bottom: the President and the board in one row, then the five departments as cards that share
// rows (a card is as wide as its people need, so a whole team fits on about two screens). Everyone is a
// photo with the name under it; a department's head comes first. Without a photo the person's initials
// show on their department's colour.
export const prerender = false;
import Public from '../layouts/Public.astro';
import Band from '../components/Band.astro';
import { departments } from '../lib/db';
import { mediaUrl } from '../lib/media';
import { initials, publicTeam, type TeamMember } from '../lib/team';
import { academicYear } from '../lib/time';
import type { DeptSlug } from '../lib/types';

const team = await publicTeam();
const depts = (await departments()).filter((d) => !d.is_leadership);
const year = academicYear().replace('-', '–');
// One colour per department, so the placeholders double as a key.
const TINT: Record<string, string> = { dotood: '#8e0000', gadaad: '#005faf', surgalt: '#1d6b3a', media: '#7a3e9d', 'erh-zui': '#8a5a00' };
const card = (m: TeamMember, role: string, tint: string, lead = false) => ({ m, role, tint, lead, photo: mediaUrl(m.photo) });
const lead = [
  ...(team.president ? [card(team.president, 'Тэргүүн', 'var(--maroon)', true)] : []),
];
const board = team.board.map((m) => card(m, 'Удирдах Зөвлөлийн гишүүн', 'var(--night)'));
---
<Public title="Удирдлагын баг" description={`Бээжингийн Их Сургуулийн Монгол Оюутны Холбооны ${year} оны хичээлийн жилийн удирдлага ба хэлтсүүд.`}>
  <Band kicker={`${year} оны хичээлийн жил`} title="Удирдлагын баг" lede="Холбоог жил бүр сонгуулиар шинэчлэгддэг удирдлага, таван хэлтсийн гишүүд сайн дурын үндсэн дээр ажиллуулдаг." />

  <section class="sec team" aria-labelledby="lead-h">
    <div class="wrap">
      <header class="team-head">
        <span class="sec-label">Удирдлага</span>
        <h2 id="lead-h">Тэргүүн ба Удирдах Зөвлөл</h2>
      </header>
      {lead.length + board.length === 0 ? (
        <p class="vacant center">Мэдээлэл удахгүй шинэчлэгдэнэ.</p>
      ) : (
        <ul class="members leadership">
          {[...lead, ...board].map((c) => (
            <li class:list={['member', { lead: c.lead }]}>
              <span class="portrait" style={`--tint:${c.tint}`}>
                {c.photo ? <img src={c.photo} alt="" width="152" height="152" /> : <span aria-hidden="true">{initials(c.m.name)}</span>}
              </span>
              <span class="n">{c.m.name}</span>
              <span class="r">{c.role}</span>
            </li>
          ))}
        </ul>
      )}

      <header class="team-head depts-head">
        <span class="sec-label">Таван хэлтэс</span>
        <h2 id="depts-h">Хэлтсүүд</h2>
      </header>
      <div class="depts">
        {depts.map((d) => {
          const people = team.byDept(d.slug as DeptSlug);
          return (
            <section class="dept" aria-labelledby={`d-${d.slug}`} style={`--tint:${TINT[d.slug] ?? 'var(--blue)'};--n:${Math.max(people.length, 1)}`}>
              <h3 id={`d-${d.slug}`}>{d.name_mn}</h3>
              {people.length === 0 ? (
                <p class="vacant">Бүрдүүлж байна</p>
              ) : (
                <ul class="members">
                  {people.map((m) => {
                    const photo = mediaUrl(m.photo);
                    return (
                      <li class="member">
                        <span class="portrait">
                          {photo ? <img src={photo} alt="" width="104" height="104" loading="lazy" /> : <span aria-hidden="true">{initials(m.name)}</span>}
                        </span>
                        <span class="n">{m.name}</span>
                        <span class="r">{m.role === 'head' ? 'Хэлтсийн дарга' : 'Гишүүн'}</span>
                      </li>
                    );
                  })}
                </ul>
              )}
            </section>
          );
        })}
      </div>
      <div class="center">
        <p class="note">Энэ жагсаалт холбооны дотоод бүртгэлээс автоматаар шинэчлэгддэг.</p>
        <a class="more" href="/taniltsuulga#butets">Хэлтэс бүрийн чиг үүрэг</a>
      </div>
    </div>
  </section>
</Public>
