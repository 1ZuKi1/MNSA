---
/**
 * Claiming an invite. The President typed only the name and student ID; the invitee types their own email,
 * then proves they own it with a code. A mistyped address can therefore never receive a working account.
 */
export const prerender = false;
import Staff from '../../../layouts/Staff.astro';
import Icon from '../../../components/Icon.astro';
import { codeRateOk, issueCode, looksLikeEmail, normalizeEmail, verifyCode } from '../../../lib/auth';
import { one } from '../../../lib/db';
import { stashDevCode, takeDevCode, clearDevCode } from '../../../lib/devcode';
import { clientIp, str } from '../../../lib/http';
import { inviteCodeMail, sendMail } from '../../../lib/mailer';
import { claimInvite, EmailTaken, inviteByToken, setInvitePendingEmail } from '../../../lib/members';
import { setSessionCookie, signSession } from '../../../lib/session';
import { fmtDate, termEnd } from '../../../lib/time';
import { ROLE_LABEL } from '../../../lib/types';

const token = Astro.params.token ?? '';
const inv = await inviteByToken(token);
const ip = clientIp(Astro.request);
let step: 'email' | 'code' = inv?.pending_email && Astro.url.searchParams.get('step') === 'code' ? 'code' : 'email';
let email = inv?.pending_email ?? '';
let error = '';

if (inv && Astro.request.method === 'POST') {
  const fd = await Astro.request.formData();
  const action = str(fd, 'action', 20);
  if (action === 'email') {
    email = normalizeEmail(str(fd, 'email', 254));
    if (!looksLikeEmail(email)) error = 'И-мэйл хаягаа зөв оруулна уу.';
    else if (await one(`SELECT 1 FROM users WHERE email = ?`, email)) error = 'Энэ хаяг бүртгэлтэй байна. Өөр хаяг оруулна уу, эсвэл Тэргүүнд хандана уу.';
    else if (!(await codeRateOk(email, ip))) error = 'Хэт олон удаа код хүслээ. 15 минутын дараа дахин оролдоно уу.';
    else {
      await setInvitePendingEmail(inv.id, email);
      const code = await issueCode(email, `invite:${inv.id}`);
      await sendMail(inviteCodeMail(email, code, inv.name_mn));
      stashDevCode(Astro.cookies, Astro.url, code);
      return Astro.redirect(`/urilga/${token}?step=code`);
    }
  }
  if (action === 'verify' && inv.pending_email) {
    step = 'code';
    email = inv.pending_email;
    const r = await verifyCode(email, `invite:${inv.id}`, str(fd, 'code', 20));
    if (r === 'ok') {
      try {
        const userId = await claimInvite(inv, email, ip);
        setSessionCookie(Astro.cookies, Astro.url, await signSession(userId, 1));
        clearDevCode(Astro.cookies);
        return Astro.redirect('/?ok=created');
      } catch (e) {
        if (e instanceof EmailTaken) error = 'Энэ хаяг аль хэдийн бүртгэлтэй байна.';
        else throw e;
      }
    } else {
      error = r === 'wrong' ? 'Код буруу байна.' : 'Кодын хугацаа дууссан эсвэл хэт олон удаа буруу оруулсан байна. Хаягаа дахин оруулж шинэ код авна уу.';
      if (r !== 'wrong') step = 'email';
    }
  }
}
const devCode = step === 'code' ? takeDevCode(Astro.cookies, Astro.url) : null;
---
<Staff title="Урилга" bare>
  <section class="auth" aria-labelledby="inv-h">
    <div class="auth-card">
      <div class="auth-logo"><img src="/brand/logo.svg" alt="" width="56" height="43" /></div>
      {
        !inv ? (
          <>
            <h1 id="inv-h">Урилга хүчингүй байна</h1>
            <p class="lead">Энэ холбоос аль хэдийн ашиглагдсан, цуцлагдсан, эсвэл 72 цагийн хугацаа нь дууссан байна. Тэргүүнээс шинэ урилга авна уу.</p>
          </>
        ) : (
          <>
            <h1 id="inv-h">Тавтай морил, {inv.name_mn}</h1>
            <p class="lead">Таныг МОХ-ны ажлын орчинд урьж байна.</p>
            <div class="steps-dots" aria-hidden="true"><span class="on"></span><span class:list={{ on: step === 'code' }}></span></div>
            <dl class="kv" style="margin:0 0 18px;padding:12px 14px;border-radius:10px;background:var(--paper)">
              <dt>Хэлтэс</dt><dd>{inv.dept_name ?? '—'}</dd>
              <dt>Эрх</dt><dd>{ROLE_LABEL[inv.role]}</dd>
              <dt>Хүчинтэй</dt><dd>{fmtDate(termEnd())} хүртэл</dd>
            </dl>
            {error && <div class="flash err" role="alert"><Icon name="alert" /><span class="flash-text">{error}</span></div>}
            {step === 'email' ? (
              <form method="post">
                <input type="hidden" name="action" value="email" />
                <div class="field">
                  <label for="email">Таны и-мэйл хаяг</label>
                  <input id="email" name="email" type="email" required autocomplete="email" inputmode="email" value={email} autofocus aria-describedby="email-hint" />
                  <span class="hint" id="email-hint">Сургуулийн хаяг (<span lang="en">…@stu.pku.edu.cn</span>) эсвэл хувийн хаяг (Gmail, QQ, 163). Нууц үг хэрэггүй: нэвтрэх бүрт код ирнэ.</span>
                </div>
                <button class="btn btn-primary btn-lg btn-block" type="submit">Код авах <Icon name="arrow" /></button>
              </form>
            ) : (
              <form method="post">
                <input type="hidden" name="action" value="verify" />
                <p class="lead" style="margin:0"><strong style="color:var(--ink)">{email}</strong> хаяг руу код илгээлээ.</p>
                {devCode && <p class="dev-code"><span>Туршилтын горим — таны код:</span> <strong class="num">{devCode}</strong></p>}
                <div class="field">
                  <label for="code">6 оронтой код</label>
                  <input id="code" name="code" class="code-input" inputmode="numeric" autocomplete="one-time-code" maxlength="7" required autofocus />
                </div>
                <button class="btn btn-primary btn-lg btn-block" type="submit">Бүртгэлээ баталгаажуулах</button>
                <p class="small" style="margin:0;text-align:center"><a href={`/urilga/${token}`}>Хаягаа засах</a></p>
              </form>
            )}
          </>
        )
      }
    </div>
  </section>
</Staff>
