---
export const prerender = false;
import Staff from '../../../layouts/Staff.astro';
import PageHead from '../../../components/PageHead.astro';
import Icon from '../../../components/Icon.astro';
import { clientIp, int, str, withFlash } from '../../../lib/http';
import * as P from '../../../lib/permissions';
import { getRecordType, showField } from '../../../lib/record-types';
import {
  asRecordLike, Conflict, decideRecord, Denied, fieldsOf, getRecord, recordChain, recordHistory, submitRecord, voidRecord, withdrawRecord,
} from '../../../lib/records';
import { fmtDate, fmtDateTime, relDay } from '../../../lib/time';
import { STATUS_LABEL, STEP_GEN, STEP_LABEL, ROLE_LABEL, type Step } from '../../../lib/types';

const user = Astro.locals.user!;
const id = int(Astro.params.id);
const rec = id ? await getRecord(id) : null;
if (!rec || !P.canReadRecord(user, asRecordLike(rec))) return new Response(null, { status: 404 });
const type = getRecordType(rec.type)!;
const here = `/barimt/${rec.id}`;

if (Astro.request.method === 'POST') {
  const fd = await Astro.request.formData();
  const action = str(fd, 'action', 20);
  const comment = str(fd, 'comment', 2000);
  const ip = clientIp(Astro.request);
  try {
    if (action === 'submit') await submitRecord(user, rec, ip);
    else if (action === 'approve') await decideRecord(user, rec, 'approve', comment, ip);
    else if (action === 'reject') await decideRecord(user, rec, 'reject', comment, ip);
    else if (action === 'withdraw') await withdrawRecord(user, rec, ip);
    else if (action === 'void') await voidRecord(user, rec, comment, ip);
    const key = { submit: 'submitted', approve: 'approved', reject: 'rejected', withdraw: 'withdrawn', void: 'voided' }[action] ?? 'saved';
    return Astro.redirect(withFlash(here, key));
  } catch (e) {
    const key = e instanceof Denied ? 'denied' : e instanceof Conflict ? 'conflict' : (e as Error).message === 'comment-required' ? 'comment' : 'invalid';
    if (key === 'invalid') console.error(e);
    return Astro.redirect(withFlash(here, key, 'err'));
  }
}

const like = asRecordLike(rec);
const can = {
  edit: P.canEditRecord(user, like),
  submit: P.canSubmitRecord(user, like),
  decide: P.canDecideStep(user, like),
  withdraw: P.canWithdrawRecord(user, like),
  void: P.canVoidRecord(user, like),
  makeEvent: type.createsEvent && rec.status === 'approved' && P.canEditEvents(user),
};
const standIn = can.decide && rec.awaiting ? !P.isStepOwner(user, rec.awaiting, rec.dept_slug, rec.co_dept_slug) : false;
// The second department's дарга is named by department, so the two дарга steps can't be mixed up.
const coGen = rec.co_dept_name?.replace(/хэлтэс$/, 'хэлтсийн') ?? '';
const stepLabel = (s: Step) => (s === 'cohead' && coGen ? `${coGen} дарга` : STEP_LABEL[s]);
const stepGen = (s: Step) => (s === 'cohead' && coGen ? `${coGen} даргын` : STEP_GEN[s]);
const fields = fieldsOf(rec);
const history = await recordHistory(rec.id);
const lastRejection = rec.status === 'rejected' ? [...history].reverse().find((h) => h.action === 'reject') : null;
const lastDecision = [...history].reverse().find((h) => h.action === 'approve' || h.action === 'auto' || h.action === 'void');

// The chain as the stepper shows it: which steps are done, which one is waiting, where it stopped.
const rejectedStep = lastRejection?.step ?? null;
const steps = recordChain(rec);
const chain = steps
  .map((s, i) => ({ s, i }))
  .filter(({ s }) => P.stepApplies(s, rec.dept_slug, rec.co_dept_slug))
  .map(({ s, i }) => {
    let state = '';
    if (rec.status === 'approved' || rec.status === 'void' || (rec.status === 'in_review' && i < rec.step)) state = 'done';
    else if (rec.status === 'in_review' && i === rec.step) state = 'now';
    else if (rec.status === 'rejected' && rejectedStep) {
      const ri = steps.indexOf(rejectedStep);
      state = i < ri ? 'done' : i === ri ? 'stop' : '';
    }
    return { step: s, label: stepLabel(s), state };
  });

const ACTION_LABEL: Record<string, string> = {
  create: 'Үүсгэсэн', edit: 'Зассан', submit: 'Хянуулахаар илгээсэн', auto: 'Автоматаар дамжсан',
  approve: 'Баталсан', reject: 'Буцаасан', withdraw: 'Эргүүлэн татсан', void: 'Хүчингүй болгосон',
};
const headline = {
  draft: 'Ноорог — хянуулахаар илгээгээгүй байна.',
  in_review: rec.awaiting ? `${stepGen(rec.awaiting)} шийдвэрийг хүлээж байна.` : 'Хянагдаж байна.',
  approved: `Батлагдсан${lastDecision ? ` · ${fmtDate(lastDecision.created_at)}` : ''}.`,
  rejected: 'Буцаагдсан. Засаад дахин илгээж болно.',
  void: 'Хүчингүй болсон.',
}[rec.status];
const hasActions = can.decide || can.submit || can.withdraw || can.makeEvent || can.void;
---
<Staff title={rec.title}>
  <PageHead
    title={rec.title}
    crumbs={[{ href: '/barimt', label: 'Баримт бичиг' }, { href: `/heltes/${rec.dept_slug}`, label: rec.dept_name }]}
  >
    <Fragment slot="actions">
      {can.edit && <a class="btn" href={`${here}/zasah`}><Icon name="edit" /> Засах</a>}
      {rec.number && <a class="btn" href={`${here}/hevleh`} target="_blank" rel="noopener"><Icon name="print" /> Хэвлэх / PDF<span class="sr-only"> (шинэ цонхонд)</span></a>}
    </Fragment>
    <span class={`badge b-${rec.status}`}>{STATUS_LABEL[rec.status]}</span>
    <span>{type.label}</span>
    {rec.number && <span class="num">{rec.number}</span>}
    {rec.co_dept_name && <span class="tag"><Icon name="folder" /> {rec.dept_name}, {rec.co_dept_name}</span>}
    {rec.visibility === 'dept' && <span class="tag"><Icon name="lock" /> Зөвхөн хэлтэс ба удирдлага</span>}
  </PageHead>

  <section class:list={['panel', 'status-panel', `s-${rec.status}`, { attention: can.decide }]} id="decide" aria-labelledby="status-h">
    <div class="panel-body">
      <h2 id="status-h" class="sr-only">Батлах явц</h2>
      <ol class="stepper" aria-label="Батлах дараалал">
        <li class="done"><span class="dot"><Icon name="check" /></span>Боловсруулсан</li>
        {chain.map((c, n) => (
          <li class={c.state} aria-current={c.state === 'now' ? 'step' : undefined}>
            <span class="dot">{c.state === 'done' ? <Icon name="check" /> : c.state === 'stop' ? <Icon name="x" /> : n + 1}</span>
            {c.label}
            <span class="sr-only">{c.state === 'done' ? ' — баталсан' : c.state === 'now' ? ' — хүлээж байна' : c.state === 'stop' ? ' — буцаасан' : ''}</span>
          </li>
        ))}
      </ol>
      <div class="status-line">
        <p><strong>{headline}</strong>{rec.status === 'in_review' && rec.submitted_at && <span class="muted"> Илгээсэн: {relDay(rec.submitted_at)}.</span>}</p>
      </div>
      {lastRejection && (
        <div class="reject-note">
          <b>{lastRejection.actor_name} буцаасан шалтгаан:</b>
          <p>{lastRejection.comment}</p>
        </div>
      )}

      {hasActions && (
        <div class="decision">
          {can.decide && (
            <form method="post" class="stack" style="--stack:12px">
              {standIn && (
                <p class="flash warn" style="margin:0">
                  <Icon name="alert" />
                  <span class="flash-text">Та Тэргүүний хувьд {stepGen(rec.awaiting!).toLowerCase()} оронд шийдвэрлэж байна. Энэ нь бүртгэлд тэмдэглэгдэнэ.</span>
                </p>
              )}
              <div class="field">
                <label for="comment">Тайлбар <span class="opt">(батлахад заавал биш, буцаахад заавал)</span></label>
                <textarea id="comment" name="comment" rows="3" aria-describedby="comment-msg"></textarea>
                <span class="error" id="comment-msg" hidden><Icon name="alert" /> Буцаах шалтгаанаа бичнэ үү.</span>
              </div>
              <div class="btn-row">
                <button class="btn btn-ok btn-lg" name="action" value="approve"><Icon name="check" /> Батлах</button>
                <button class="btn btn-danger btn-lg" name="action" value="reject" data-require="comment"><Icon name="undo" /> Буцаах</button>
              </div>
            </form>
          )}
          {(can.submit || can.withdraw || can.makeEvent) && (
            <div class="btn-row">
              {can.submit && (
                <form method="post">
                  <button class="btn btn-primary btn-lg" name="action" value="submit"><Icon name="send" /> Хянуулахаар илгээх</button>
                </form>
              )}
              {can.withdraw && (
                <form method="post" data-confirm="Хянуулахаас эргүүлэн татаж, ноорог болгох уу?">
                  <button class="btn" name="action" value="withdraw"><Icon name="undo" /> Эргүүлэн татах</button>
                </form>
              )}
              {can.makeEvent && <a class="btn btn-blue" href={`/uil-ajillagaa/shine?from=${rec.id}`}><Icon name="calendar" /> Арга хэмжээ үүсгэх</a>}
            </div>
          )}
          {can.submit && !rec.number && <p class="form-note">Илгээх үед баримтын дугаар автоматаар олгогдоно.</p>}
          {can.void && (
            <details>
              <summary class="linkish danger">Хүчингүй болгох…</summary>
              <form method="post" class="stack" style="--stack:10px; margin-top:12px; max-width:520px">
                <div class="field">
                  <label for="void-reason">Шалтгаан</label>
                  <textarea id="void-reason" name="comment" rows="2" required></textarea>
                </div>
                <div><button class="btn btn-danger btn-sm" name="action" value="void" data-confirm="Энэ баримтыг хүчингүй болгох уу? Буцаах боломжгүй.">Хүчингүй болгох</button></div>
              </form>
            </details>
          )}
        </div>
      )}
    </div>
  </section>

  <div class="cols" style="margin-top:18px">
    <article class="panel" aria-labelledby="doc-h">
      <div class="panel-head"><h2 id="doc-h"><Icon name="doc" /> Агуулга</h2></div>
      <div class="panel-body">
        {type.fields.map((f) =>
          fields[f.name] ? (
            <section class="doc-field">
              <h3>{f.label}</h3>
              <p>{showField(f, fields[f.name])}</p>
            </section>
          ) : null,
        )}
      </div>
    </article>

    <div>
      <section class="panel" aria-labelledby="info-h">
        <div class="panel-head"><h2 id="info-h">Мэдээлэл</h2></div>
        <div class="panel-body">
          <dl class="kv">
            <dt>Дугаар</dt><dd class="num">{rec.number ?? '—'}</dd>
            <dt>Хэлтэс</dt><dd>{rec.dept_name}</dd>
            {rec.co_dept_name && <><dt>Хамтран хариуцах</dt><dd><a href={`/heltes/${rec.co_dept_slug}`}>{rec.co_dept_name}</a></dd></>}
            <dt>Боловсруулсан</dt><dd>{rec.author_name}</dd>
            <dt>Хичээлийн жил</dt><dd>{rec.academic_year}</dd>
            <dt>Хувилбар</dt><dd>{rec.version}</dd>
          </dl>
        </div>
      </section>
      <section class="panel" aria-labelledby="hist-h">
        <div class="panel-head"><h2 id="hist-h"><Icon name="clock" /> Түүх</h2></div>
        <div class="panel-body">
          <ol class="timeline">
            {[...history].reverse().map((h) => (
              <li class={`t-${h.action}`}>
                <div>
                  <strong>{h.actor_name}</strong> — {ACTION_LABEL[h.action] ?? h.action}
                  {h.step && <span class="muted"> ({stepLabel(h.step)})</span>}
                </div>
                <div class="when">{fmtDateTime(h.created_at)} · {ROLE_LABEL[h.actor_role]}</div>
                {h.comment && <blockquote>{h.comment}</blockquote>}
              </li>
            ))}
          </ol>
        </div>
      </section>
    </div>
  </div>
</Staff>
