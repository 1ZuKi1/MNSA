const faq = [
  { q: 'Холбоонд заавал элсэх ёстой юу?', a: 'Бүртгүүлэх шаардлагагүй. Үндсэн дүрмийн дагуу Бээжингийн Их Сургуульд суралцаж буй Монгол Улсын иргэн оюутан бүр Холбооны гишүүн.' },
  { q: 'Хятад хэл мэдэхгүй бол асуудал гарах уу?', a: 'Хэлний бэлтгэлд хэл сурахаар ирж байгаа ч кампус болон гадуур хүмүүстэй хятадаар харилцах шаардлага гарна. Ирэхээсээ өмнө өдөр тутмын үгс сурах, эсвэл орчуулгын апп ашиглахыг зөвлөж байна.' },
  { q: 'Хятад хэл сайн биш бол хичээлээ ойлгох уу?', a: 'Хэлний бэлтгэлд анхан шатны мэдлэгтэй орж ирдэг оюутан олон бий. Багш нар бүх чадлаараа ойлгуулахыг хичээдэг — битгий сэтгэлээр унаарай.' },
  { q: 'Монгол банкны картаа ашиглаж болох уу?', a: 'Тийм. Visa, Mastercard, UnionPay картыг WeChat, Alipay-д холбож ашиглана. Alipay: Me → Settings → Account & Security → Identity Information (实名认证), дараа нь Me → Bank Cards → Add Bank Card. WeChat: Me → Service → Wallet → Bank Cards → Add Card.' },
  { q: 'Сургалтын төлбөрөө яаж төлөх вэ?', a: 'studyatpku.com хаягаар урьдчилан төлөхийг зөвлөдөг. Төлж амжаагүй бол бүртгэлийн өдөр төлж болно. Картын нэг удаагийн болон өдрийн гүйлгээний хязгаарыг урьдчилан шалгаарай. Санхүүгийн асуудал гарвал хариуцсан багштайгаа холбогдоорой.' },
  { q: 'Дотуур байр олдохгүй бол яах вэ?', a: 'Бакалавр болон түүнээс дээш түвшинд дотуур байр хязгаартай. studyatpku.com → «Dormitory Reservation»-оор захиалж, олдохгүй бол хүлээлгийн жагсаалтад нэрээ өгч, түр хугацаанд гадуур байр түрээслэнэ. Хэлний бэлтгэлийн оюутнуудад сургууль 4 хүний өрөө бэлддэг.' },
  { q: 'Эмнэлэгт хэрхэн үзүүлэх вэ?', a: 'Сургуулийн эмнэлэг 24 цагаар ажилладаг, зүүн хаалганы эсрэг талд байрладаг. Оюутны үнэмлэх, даатгалаа ашиглан үйлчлүүлнэ.' },
  { q: 'Паспортоо байнга авч явах уу?', a: 'Үгүй. Гэхдээ зураг эсвэл цахим хуулбарыг утсандаа хадгалж яваарай. E-Mongolia энд хүчингүй.' },
  { q: 'Монгол жолооны үнэмлэхээ ашиглаж болох уу?', a: 'Болохгүй. Тусгай зөвшөөрөл авч, жолооны шалгалт өгөх шаардлагатай.' },
  { q: 'Бээжин аюулгүй юу?', a: 'Ерөнхийдөө аюулгүй хот. Гэхдээ бусад том хотын адил эд зүйл, мөнгө, цахим мэдээллийнхээ аюулгүй байдалд анхаараарай.' },
  { q: 'Хэлтсийн гишүүн болбол хичээлд саад болох уу?', a: 'Холбоо гишүүдийнхээ сурлагыг нэн тэргүүнд тавьдаг. Хичээлийнхээ хуваарьтай зөв зохицуулаад оролцоорой.' },
  { q: 'Холбоо надад тусалж чадах уу?', a: 'Холбоо гишүүддээ туслах зорилгоор байгуулагдсан. Эрх хэмжээнийхээ хүрээнд олон асуудлыг шийдэж чадна — учир явдлаа хэлэхээс бүү эргэлз.' },
];

// The permit options lead with their cost as a figure; the rest of each sentence stays under it, unchanged.
const permit = ways.slice(0, 3).map((w) => {
  const m = w.v.match(/^(Ойролцоогоор) (¥\d+)\.?\s*(.*)$/s);
  return { k: w.k, pre: m?.[1] ?? '', cost: m?.[2] ?? '', rest: m?.[3] ?? w.v };
});
const materials = ways[3];
// Each department list becomes separate items; the Mongolian lead-in is kept apart from the Chinese names.
const math = mathRules.map((r) => {
  const m = r.v.match(/^([^\u4e00-\u9fff]*?)\s*([\u4e00-\u9fff].*)$/s);
  return { k: r.k, lead: m?.[1] ?? '', items: (m?.[2] ?? r.v).split(', ') };
});
