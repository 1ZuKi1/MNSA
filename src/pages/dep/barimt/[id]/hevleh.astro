---
/**
 * The official document, in the association's own layout (see components/OfficialDoc.astro).
 * Browser print → "Save as PDF". No PDF library, no Worker CPU, perfect Mongolian Cyrillic.
 */
export const prerender = false;
import '@fontsource-variable/source-serif-4';
import '@fontsource-variable/golos-text';
import OfficialDoc, { type SignerBlock } from '../../../../components/OfficialDoc.astro';
import OfficialLetter from '../../../../components/OfficialLetter.astro';
import { latinName, letterDateLine, ZH, zhDate, zhStepTitle } from '../../../../lib/letterhead';
import { int } from '../../../../lib/http';
import * as P from '../../../../lib/permissions';
import { getRecordType, printKind, showField } from '../../../../lib/record-types';
import { asRecordLike, fieldsOf, getRecord, paperOf, recordChain, recordHistory } from '../../../../lib/records';
import { stampId, stampUrl } from '../../../../lib/settings';
import { staffTeam } from '../../../../lib/team';
import { fmtDate, fmtOfficial, fmtOfficialDate, toDateInput } from '../../../../lib/time';
import { STATUS_LABEL, STEP_LABEL, type Step } from '../../../../lib/types';

const user = Astro.locals.user!;
const id = int(Astro.params.id);
const rec = id ? await getRecord(id) : null;
if (!rec || !P.canReadRecord(user, asRecordLike(rec))) return new Response(null, { status: 404 });
// A paper document from before the website prints as the paper was: its own heading, date and signers.
const paper = paperOf(rec);
if (!rec.number && !paper) return new Response(null, { status: 404 });
const type = getRecordType(rec.type)!;
const pr = type.print;
const f = fieldsOf(rec);
const [history, team] = await Promise.all([recordHistory(rec.id), staffTeam()]);
const final = rec.status === 'approved';

// The latest approval per step (a resubmission after rejection restarts the chain).
const lastSubmit = Math.max(...history.filter((h) => h.action === 'submit').map((h) => h.id), 0);
const approvals = recordChain(rec)
  .filter((s) => P.stepApplies(s, rec.dept_slug, rec.co_dept_slug))
  .map((s) => ({ step: s, by: history.filter((h) => h.id > lastSubmit && h.step === s && (h.action === 'approve' || h.action === 'auto')).at(-1) ?? null }));

// Who signs. Before a step is decided, the person who holds it now is printed; after, whoever decided it.
const holder: Record<Step, string | undefined> = {
  president: team.find((p) => p.role === 'president')?.name,
  legal: team.find((p) => p.role === 'head' && p.dept === 'erh-zui')?.name,
  head: team.find((p) => p.role === 'head' && p.dept === rec.dept_slug)?.name,
  cohead: team.find((p) => p.role === 'head' && !!rec.co_dept_slug && p.dept === rec.co_dept_slug)?.name,
};
const deptGen = rec.dept_name.replace(/хэлтэс$/, 'хэлтсийн');
const coGen = rec.co_dept_name?.replace(/хэлтэс$/, 'хэлтсийн') ?? '';
const stepTitle = (s: Step) => (s === 'head' ? `${deptGen} дарга` : s === 'cohead' ? `${coGen} дарга` : STEP_LABEL[s]);
// The President's signature carries a stamp once they approved: the square one on the official blank
// (Албан бичиг, Хамтын ажиллагаа), the round one on everything else.
const stampKind = pr.stamp ?? 'round';
const presidentApproved = final && approvals.some((a) => a.step === 'president' && a.by);
const stampMedia = presidentApproved ? await stampId(stampKind) : null;
const stamp = stampMedia ? stampUrl(stampKind, stampMedia) : null;
// A document written in Chinese prints every fixed label in Chinese and names in Latin letters.
const zh = !!pr.langField && f[pr.langField] === '中文';
const signerName = (name: string) => (zh ? latinName(name) : name);
const stepSigner = (step: Step, title: string): SignerBlock => ({
  title: zh ? zhStepTitle(step, rec.dept_slug, rec.co_dept_slug) : title,
  names: [signerName(approvals.find((a) => a.step === step)?.by?.actor_name ?? holder[step] ?? '')],
  stamp: step === 'president' ? stamp : null,
});
// A second department's дарга signs beside the main дарга, wherever the main дарга signs. Where no дарга
// signs (an outgoing letter carries the President's and Legal's signatures), the approval is in the trail line.
const coSigns = P.stepApplies('cohead', rec.dept_slug, rec.co_dept_slug);
const signers: SignerBlock[] = pr.signers.flatMap((s): SignerBlock[] => {
  if ('step' in s) {
    if (!P.stepApplies(s.step, rec.dept_slug, rec.co_dept_slug)) return [];
    const block = stepSigner(s.step, s.step === 'head' ? stepTitle('head') : s.title);
    return s.step === 'head' && coSigns ? [block, stepSigner('cohead', stepTitle('cohead'))] : [block];
  }
  if ('author' in s) return [{ title: s.title, names: [rec.author_name] }];
  if ('field' in s) return [{ title: s.title, names: [f[s.field] ?? ''] }];
  return [{ title: s.title, names: team.filter((p) => p.dept === rec.dept_slug && (p.role === 'head' || p.role === 'member')).map((p) => p.name) }];
});
// The other side of an agreement signs too, when the form names who signs for them.
if (f.partner_signer) signers.push({ title: zh ? ZH.onBehalf(f.partner ?? '') : `Хамтрагч тал: ${f.partner ?? ''}`, names: [f.partner_signer] });

const fieldDef = (name: string) => type.fields.find((x) => x.name === name)!;
const show = (name: string) => showField(fieldDef(name), f[name] ?? '', true);
const meta = (pr.meta ?? []).filter((n) => f[n]).map((n) => ({ label: fieldDef(n).label, value: show(n) }));
// Fields in the order the form has them: running text as it was typed, everything else as numbered sections.
const skip = new Set(
  [...(pr.meta ?? []), pr.closing, pr.langField, 'recipient', 'greeting', 'attachments_note', 'annex', 'doc_kind', 'partner', 'partner_signer', 'heading'].filter(Boolean) as string[],
);
let n = 0;
const blocks = type.fields
  .filter((x) => f[x.name] && !skip.has(x.name))
  .map((x) => ((pr.plain ?? []).includes(x.name) ? { n: 0, label: '', text: f[x.name] } : { n: ++n, label: x.label, text: show(x.name) }));
const kind = paper ? paper.kind : printKind(type, f);

// The date the document carries: the paper's own, or the day it was approved (else sent for review).
const ymd = (v: string | null | undefined) => {
  const m = /^(\d{4})-(\d{2})-(\d{2})$/.exec(v ?? '');
  return m ? { y: +m[1], m: +m[2], d: +m[3] } : null;
};
const docDay = paper ? ymd(paper.date) : ymd(toDateInput(rec.decided_at ?? rec.submitted_at));
const dateText = zh
  ? docDay ? zhDate(docDay) : '________________'
  : paper
    ? paper.date ? fmtOfficialDate(paper.date) : '________________'
    : fmtOfficial(rec.decided_at ?? rec.submitted_at);
const annexHeading = zh ? ZH.annex : 'ХАВСРАЛТ';
// The subject line under the heading: typed on the form, else in Chinese the memoranda's own wording.
const subject = f.heading?.trim() || (zh && f.partner ? `${ZH.org}与${f.partner}关于开展合作事宜` : rec.title);
// Documents that leave the association (square stamp) carry no internal approval line.
const outgoing = pr.stamp === 'square';
const letter = pr.layout === 'letter';
const president = signers.find((x) => x.title === 'Холбооны Тэргүүн') ?? signers[0];

// A one-line record of the electronic approval, under the page — the full history stays online.
const trail = [
  `Цахим батлалт: боловсруулсан — ${rec.author_name} (${fmtDate(rec.submitted_at)})`,
  ...approvals.filter((a) => a.by).map((a) => `${stepTitle(a.step)} — ${a.by!.actor_name} (${fmtDate(a.by!.created_at)})`),
  `team.pkumongolia.com/barimt/${rec.id}`,
].join(' · ');
const paperTrail = paper
  ? [
      `Цаасан эх хувиас цахим архивт оруулсан (${fmtDate(paper.imported_at ?? rec.created_at)}${paper.source ? `, ${paper.source.replace(/#\d+$/, '')}` : ''})`,
      paper.paper_number ? `цаасан дээрх дугаар: ${paper.paper_number}` : '',
      `team.pkumongolia.com/barimt/${rec.id}`,
    ].filter(Boolean).join(' · ')
  : '';
const paperSigners: SignerBlock[] = (paper?.signers ?? []).map((s) => ({ title: s.title, names: s.names }));
---
<!doctype html>
<html lang="mn">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <title>{rec.number} — {rec.title}</title>
  </head>
  <body>
    <div class="toolbar">
      <button onclick="window.print()">Хэвлэх / PDF хадгалах</button>
      <a href={`/barimt/${rec.id}`}>← Буцах</a>
      {paper && <span>Цаасан эх хувийн бичвэр — гарын үсэг, тамга эх хувь дээр байна.</span>}
      {!final && <span class="warn">Энэ баримт бичиг хараахан батлагдаагүй ({STATUS_LABEL[rec.status]}).</span>}
    </div>

    {
      letter ? (
        <OfficialLetter
          recipient={f.recipient ?? ''}
          title={paper ? (paper.subject ?? rec.title) : rec.title}
          greeting={f.greeting}
          body={paper ? (f.text ?? '') : (f.body ?? '')}
          attachments={f.attachments_note || undefined}
          dateLine={docDay ? letterDateLine(docDay) : '20__ оны __ дугаар сарын __-ны өдрийн'}
          number={rec.number}
          signerTitle="Тэргүүн"
          signerName={(paper ? paperSigners[0]?.names[0] : president?.names[0]) ?? ''}
          stamp={paper ? null : (president?.stamp ?? null)}
          draft={paper ? false : !final}
        />
      ) : (
        <OfficialDoc
          kind={kind}
          subtitle={paper ? (paper.subject ?? rec.title) : pr.template ? undefined : subject}
          recipient={paper ? undefined : f.recipient || undefined}
          meta={paper ? [] : meta}
          signers={paper ? paperSigners : signers}
          number={rec.number}
          date={dateText}
          draft={paper ? false : !final}
          trail={paper ? paperTrail : outgoing ? null : trail}
          lang={zh ? 'zh' : 'mn'}
        >
          {
            paper ? (
              <p class="para paper">{f.text}</p>
            ) : pr.template ? (
              pr.template.map((t) => (
                <section class="tsec">
                  <h3>{t.heading}</h3>
                  {t.paragraphs?.map((p) => <p>{p}</p>)}
                  {t.facts && <ul>{t.facts.map((x) => <li>{x.label}: {x.date ? fmtOfficialDate(f[x.field] ?? '') : f[x.field]}</li>)}</ul>}
                  {t.items && <ol>{t.items.map((x) => <li>{x}</li>)}</ol>}
                </section>
              ))
            ) : (
              <>
                {blocks.map((b) =>
                  b.n ? (
                    <section class="sec">
                      <h3>{b.n}. {b.label}</h3>
                      <p class="para">{b.text}</p>
                    </section>
                  ) : (
                    <p class="para">{b.text}</p>
                  ),
                )}
                {pr.closing && f[pr.closing] && <p class="closing">{f[pr.closing]}</p>}
                {f.attachments_note && <p class="attach"><strong>Хавсралт:</strong> {f.attachments_note}</p>}
              </>
            )
          }
          {!paper && f.annex && (
            <section class="annex" slot="after">
              <h3>{annexHeading}</h3>
              <p class="para">{f.annex}</p>
            </section>
          )}
        </OfficialDoc>
      )
    }
  </body>
</html>

<style is:global>
  * { box-sizing: border-box; }
  body { margin: 0; background: #e9e6e1; }
  .toolbar { position: sticky; top: 0; z-index: 5; display: flex; gap: 16px; align-items: center; padding: 10px 20px; background: #fff; border-bottom: 1px solid #ddd; font: 14px 'Golos Text Variable', system-ui, sans-serif; }
  .toolbar button { font: inherit; font-weight: 600; padding: 7px 14px; border-radius: 6px; border: 1px solid #8e0000; background: #8e0000; color: #fff; cursor: pointer; }
  .toolbar .warn { color: #8a5a00; }
  .toolbar span { color: #555; }
  .sheet .para.paper { text-align: left; tab-size: 4; }
  @media print {
    body { background: #fff; }
    .toolbar { display: none; }
  }
</style>
