---
/**
 * One person. Everyone can open their own page (to hide themselves from the public team page);
 * the President and the deputy can open anyone's and change role, department, e-mail, or remove them.
 * Forms post to /gishuud (one place that changes members) and come back here.
 */
export const prerender = false;
import Staff from '../../../layouts/Staff.astro';
import PageHead from '../../../components/PageHead.astro';
import Icon from '../../../components/Icon.astro';
import PortraitCrop from '../../../components/PortraitCrop.astro';
import RoleDept from '../../../components/RoleDept.astro';
import { departments } from '../../../lib/db';
import { int } from '../../../lib/http';
import { asMemberLike, canSetPhoto, canSetPublic, getMember } from '../../../lib/members';
import { mediaUrl } from '../../../lib/media';
import * as P from '../../../lib/permissions';
import { deptTint, initials } from '../../../lib/team';
import { fmtDate, fmtDateTime, now, relDay } from '../../../lib/time';
import { ROLE_LABEL } from '../../../lib/types';

const user = Astro.locals.user!;
const id = int(Astro.params.id);
const m = id ? await getMember(id) : null;
const manager = P.canManageMembers(user);
// The maintainer may open anyone's page too — to load the team's photos — but changes nothing else there.
if (!m || m.status !== 'active' || (m.id !== user.id && !manager && user.role !== 'maintainer')) return new Response(null, { status: 404 });

const depts = await departments();
const self = m.id === user.id;
const canTouch = P.canModifyMember(user, asMemberLike(m));
const canPublic = canSetPublic(user, m) && m.role !== 'maintainer';
const canPhoto = canSetPhoto(user, m) && m.role !== 'maintainer';
const photo = mediaUrl(m.photo_id);
const grantable = P.grantableRoles(user);
const back = `/gishuud/${m.id}`;
const expiring = m.term_ends_at !== null && m.term_ends_at - now() < 30 * 86400;
---
<Staff title={m.name_mn}>
  <PageHead title={m.name_mn} crumbs={[{ href: '/gishuud', label: 'Гишүүд' }]}>
    <span>{ROLE_LABEL[m.role]}</span>
    {m.dept_name && <span>{m.dept_name}</span>}
    {m.is_deputy === 1 && <span class="badge plain b-blue">орлогч</span>}
    {self && <span class="badge plain">та</span>}
  </PageHead>

  <div class="cols">
    <div>
      <section class="panel" aria-labelledby="info-h">
        <div class="panel-head"><h2 id="info-h"><Icon name="user" /> Мэдээлэл</h2></div>
        <div class="panel-body">
          <div class="profile" style="margin-bottom:16px">
            {photo
              ? <span class="avatar lg photo" aria-hidden="true"><img src={photo} alt="" width="64" height="64" /></span>
              : <span class="avatar lg" style={`--tint:${deptTint(m.dept_slug)}`} aria-hidden="true">{initials(m.name_mn)}</span>}
            <dl class="kv">
              {m.full_name && <><dt>Бүтэн нэр</dt><dd>{m.full_name}</dd></>}
              <dt>И-мэйл</dt><dd>{m.email}</dd>
              <dt>Оюутны дугаар</dt><dd class="num">{m.student_id ?? '—'}</dd>
              <dt>Эрх дуусах</dt><dd class:list={{ warnc: expiring }}>{fmtDate(m.term_ends_at)}</dd>
              <dt>Сүүлд нэвтэрсэн</dt><dd>{m.last_login_at ? `${fmtDateTime(m.last_login_at)} (${relDay(m.last_login_at)})` : 'Нэвтэрч байгаагүй'}</dd>
            </dl>
          </div>
<div class="btn-row">
            {P.canSeeParticipation(user, m.id) && (
              <a class="btn btn-sm" href={`/oroltsoo?user=${m.id}`}><Icon name="chart" /> {self ? 'Миний оролцоо' : 'Оролцоог харах'}</a>
            )}
            {(self || manager) && (m.role === 'president' || m.role === 'head' || m.role === 'member') && (
              <a class="btn btn-sm" href={`/gishuud/bichig?id=${m.id}`} target="_blank" rel="noopener"><Icon name="print" /> Үүргийн бичиг<span class="sr-only"> (шинэ цонхонд)</span></a>
            )}
          </div>
        </div>
      </section>

      {canTouch && (
        <form method="post" action="/gishuud" class="panel" aria-labelledby="role-h">
          <input type="hidden" name="user" value={m.id} />
          <input type="hidden" name="back" value={back} />
          <div class="panel-head"><h2 id="role-h"><Icon name="shield" /> Эрх ба хэлтэс</h2></div>
          <div class="panel-body" style="display:grid;gap:16px">
            <div class="two">
              <div class="field">
                <label for="m_role">Эрх</label>
                <select id="m_role" name="role">
                  {[...new Set([m.role, ...grantable])].map((r) => <option value={r} selected={r === m.role}>{ROLE_LABEL[r]}</option>)}
                </select>
              </div>
              <div class="field">
                <label for="m_dept">Хэлтэс</label>
                <select id="m_dept" name="dept">
                  {depts.map((d) => <option value={d.slug} data-leadership={d.is_leadership === 1 ? '' : undefined} selected={d.slug === m.dept_slug}>{d.name_mn}</option>)}
                </select>
              </div>
            </div>
            <p class="form-note">Өөрчлөлт шууд хүчин төгөлдөр болно — дахин нэвтрэх шаардлагагүй.</p>
            <div><button class="btn btn-primary" name="action" value="change">Хадгалах</button></div>
          </div>
        </form>
      )}

      {canTouch && (
        <form method="post" action="/gishuud" class="panel" aria-labelledby="mail-h">
          <input type="hidden" name="user" value={m.id} />
          <input type="hidden" name="back" value={back} />
          <div class="panel-head"><h2 id="mail-h"><Icon name="mail" /> И-мэйл солих</h2></div>
          <div class="panel-body" style="display:grid;gap:14px">
            <div class="field">
              <label for="m_email">Шинэ и-мэйл</label>
              <input id="m_email" name="email" type="email" required value={m.email} autocomplete="off" aria-describedby="m_email-hint" />
              <span class="hint" id="m_email-hint">Хуучин хаягаа ашиглах боломжгүй болсон үед. Тухайн хүн гарч, шинэ хаягаараа дахин нэвтэрнэ.</span>
            </div>
            <div><button class="btn" name="action" value="email" data-confirm="И-мэйл хаягийг солих уу?">И-мэйл солих</button></div>
          </div>
        </form>
      )}
    </div>

    <div>
      {canPhoto && (
        <form method="post" action="/gishuud" enctype="multipart/form-data" class="panel" aria-labelledby="ph-h" data-portrait-form>
          <input type="hidden" name="user" value={m.id} />
          <input type="hidden" name="back" value={back} />
          <input type="hidden" name="w" value="" />
          <input type="hidden" name="h" value="" />
          <div class="panel-head"><h2 id="ph-h"><Icon name="image" /> Зураг</h2></div>
          <div class="panel-body stack" style="--stack:14px">
            <p class="form-note">Нийтийн «Удирдлагын баг» хуудсанд нэрийн дээр гарна. Цээж зураг хамгийн тохиромжтой. Зураг сонгосны дараа харагдах хэсгийг өөрөө тохируулна.</p>
            <div class="portrait-row">
              {photo
                ? <span class="avatar xl photo"><img src={photo} alt={`${m.name_mn}-ийн одоогийн зураг`} width="112" height="112" /></span>
                : <span class="avatar xl" style={`--tint:${deptTint(m.dept_slug)}`} aria-hidden="true">{initials(m.name_mn)}</span>}
            </div>
            <label class="drop">
              <Icon name="image" />
              <b>{photo ? 'Шинэ зураг сонгох' : 'Зураг сонгох'}</b>
              <span data-status>Утасны зураг ч болно — илгээхээс өмнө автоматаар жижигрүүлнэ.</span>
              <input name="file" type="file" accept="image/jpeg,image/png,image/webp" required />
            </label>
            <div class="cropper" data-crop hidden>
              <div class="crop-stage" tabindex="0" role="img" aria-label="Нийтийн хуудсанд харагдах хэсэг. Сумтай товчоор зөөнө.">
                <canvas></canvas>
              </div>
              <label class="crop-zoom">
                <span>Томруулах</span>
                <input type="range" min="1" max="4" step="0.01" value="1" />
              </label>
              <p class="form-note">Зургийг чирж, томруулж байрлуулна уу. Нийтийн хуудсанд яг энэ хүрээнд харагдаж буйгаар гарна.</p>
            </div>
            <div class="btn-row">
              <button class="btn btn-primary" type="submit" name="action" value="photo"><Icon name="check" /> Хадгалах</button>
              {photo && <button class="btn btn-sm" type="submit" name="action" value="photo_remove" formnovalidate data-confirm="Зургийг устгах уу? Нэрийн эхний үсгүүд харагдана.">Зургийг устгах</button>}
            </div>
          </div>
        </form>
      )}

      {canPublic && (
        <form method="post" action="/gishuud" class="panel" aria-labelledby="pub-h">
          <input type="hidden" name="user" value={m.id} />
          <input type="hidden" name="back" value={back} />
          <div class="panel-head"><h2 id="pub-h"><Icon name="globe" /> Нийтийн хуудас</h2></div>
          <div class="panel-body stack" style="--stack:12px">
            <p style="margin:0">
              {m.show_public
                ? <><Icon name="check" class="inline-ic" /> «Удирдлагын баг» хуудсанд нэр, эрх нь харагдаж байна.</>
                : 'Нийтийн «Удирдлагын баг» хуудсанд харагдахгүй байна.'}
            </p>
            <button class="btn btn-sm" name="action" value={m.show_public ? 'public_off' : 'public_on'}>
              {m.show_public ? 'Нийтийн хуудаснаас нуух' : 'Нийтийн хуудсанд харуулах'}
            </button>
          </div>
        </form>
      )}

      {P.canSetDeputy(user) && m.role !== 'maintainer' && m.role !== 'president' && (
        <form method="post" action="/gishuud" class="panel" aria-labelledby="dp-h">
          <input type="hidden" name="user" value={m.id} />
          <input type="hidden" name="back" value={back} />
          <div class="panel-head"><h2 id="dp-h"><Icon name="user" /> Орлогч</h2></div>
          <div class="panel-body stack" style="--stack:12px">
            <p class="form-note">Тэргүүн байхгүй үед гишүүн нэмж, хасах эрхтэй нэг хүн. Нэг л хүн байна.</p>
            {m.is_deputy === 1
              ? <button class="btn btn-sm" name="action" value="no_deputy" data-confirm="Орлогчийг цуцлах уу?">Орлогчоос чөлөөлөх</button>
              : <button class="btn btn-sm" name="action" value="deputy" data-confirm={`«${m.name_mn}» гишүүнийг орлогчоор томилох уу? Өмнөх орлогч чөлөөлөгдөнө.`}>Орлогчоор томилох</button>}
          </div>
        </form>
      )}

      {canTouch && (
        <form method="post" action="/gishuud" class="panel danger-zone" aria-labelledby="rm-h">
          <input type="hidden" name="user" value={m.id} />
          <input type="hidden" name="back" value={back} />
          <div class="panel-head"><h2 id="rm-h"><Icon name="trash" /> Ажлын орчноос хасах</h2></div>
          <div class="panel-body stack" style="--stack:12px">
            <p class="form-note">Тэр даруй нэвтрэх эрхгүй болно. Түүний бичсэн бүх баримт, оролцооны бүртгэл хэвээр үлдэнэ.</p>
            <button class="btn btn-danger btn-sm" name="action" value="remove" data-confirm={`«${m.name_mn}» гишүүнийг ажлын орчноос хасах уу?`}>Хасах</button>
          </div>
        </form>
      )}
    </div>
  </div>
</Staff>

<PortraitCrop />
<RoleDept />
