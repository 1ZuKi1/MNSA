---
import Public from '../layouts/Public.astro';
---
<Public title="Хуудас олдсонгүй">
  <section class="wrap nf">
    <img src="/brand/logo.svg" alt="" width="140" height="106" />
    <h1>Хуудас олдсонгүй</h1>
    <p class="muted">Таны хайсан хуудас байхгүй эсвэл зөөгдсөн байна.</p>
    <a class="btn btn-primary" href="/">Нүүр хуудас руу</a>
  </section>
</Public>

<style>
  .nf { text-align: center; padding-top: 64px; }
  .nf img { width: 140px; height: auto; margin: 0 auto 20px; opacity: 0.8; }
  .nf h1 { font-family: var(--font-serif); }
</style>
