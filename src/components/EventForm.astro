---
import Icon from './Icon.astro';
import TimeInput from './TimeInput.astro';
import type { EventFormValues } from '../lib/forms';
import type { DeptRow } from '../lib/db';

interface Props {
  values: EventFormValues;
  errors: Record<string, string>;
  depts: DeptRow[];
  submitLabel: string;
  cancelHref: string;
}
const { values: v, errors, depts, submitLabel, cancelHref } = Astro.props;
const LABEL: Record<string, [string, string]> = { title: ['Нэр', 'title'], start: ['Эхлэх', 'start_date'], end: ['Дуусах', 'end_date'] };
const problems = Object.keys(LABEL).filter((k) => errors[k]).map((k) => [k, errors[k]] as const);
---
<form method="post" class="panel form" data-guard>
  <div class="panel-body">
    {
      problems.length > 0 && (
        <div class="error-summary" role="alert" tabindex="-1" id="errors">
          <h2><Icon name="alert" /> Дараах зүйлсийг засна уу</h2>
          <ul>{problems.map(([k, msg]) => <li><a href={`#${LABEL[k][1]}`}>{LABEL[k][0]}: {msg}</a></li>)}</ul>
        </div>
      )
    }

    <div class="field">
      <label for="title">Нэр</label>
      <input id="title" name="title" type="text" required maxlength="200" value={v.title}
        aria-invalid={errors.title ? 'true' : undefined} aria-describedby={errors.title ? 'title-err' : undefined} />
      {errors.title && <span class="error" id="title-err"><Icon name="alert" /> {errors.title}</span>}
    </div>

    <div class="two">
      <fieldset class="field">
        <legend class="label">Эхлэх</legend>
        <div class="dt">
          <input id="start_date" name="start_date" type="date" required value={v.startDate} aria-label="Эхлэх огноо"
            aria-invalid={errors.start ? 'true' : undefined} aria-describedby={errors.start ? 'start-err' : undefined} />
          <TimeInput name="start_time" value={v.startTime} label="Эхлэх цаг" />
        </div>
        {errors.start && <span class="error" id="start-err"><Icon name="alert" /> {errors.start}</span>}
      </fieldset>
      <fieldset class="field">
        <legend class="label">Дуусах <span class="opt">(заавал биш)</span></legend>
        <div class="dt">
          <input id="end_date" name="end_date" type="date" value={v.endDate} aria-label="Дуусах огноо"
            aria-invalid={errors.end ? 'true' : undefined} aria-describedby={errors.end ? 'end-err' : undefined} />
          <TimeInput name="end_time" value={v.endTime} label="Дуусах цаг" />
        </div>
        {errors.end && <span class="error" id="end-err"><Icon name="alert" /> {errors.end}</span>}
      </fieldset>
    </div>

    <div class="two">
      <div class="field">
        <label for="location">Байршил <span class="opt">(заавал биш)</span></label>
        <input id="location" name="location" type="text" maxlength="200" value={v.location} />
      </div>
      <div class="field">
        <label for="dept">Зохион байгуулах хэлтэс</label>
        <select id="dept" name="dept" aria-describedby="dept-hint">
          <option value="">— Холбоо бүхэлдээ —</option>
          {depts.map((d) => <option value={d.slug} selected={d.slug === v.dept}>{d.name_mn}</option>)}
        </select>
        <span class="hint" id="dept-hint">Тухайн хэлтсийн дарга ажлуудыг удирдах эрхтэй болно.</span>
      </div>
    </div>

    <div class="field">
      <label for="summary">Товч танилцуулга <span class="opt">(заавал биш)</span></label>
      <input id="summary" name="summary" type="text" maxlength="400" value={v.summary} aria-describedby="summary-hint" />
      <span class="hint" id="summary-hint">Нийтийн хуудасны жагсаалтад харагдана. Нэг, хоёр өгүүлбэр.</span>
    </div>

    <div class="field">
      <label for="body">Дэлгэрэнгүй <span class="opt">(заавал биш)</span></label>
      <textarea id="body" name="body" rows="8" aria-describedby="body-hint">{v.body}</textarea>
      <span class="hint" id="body-hint">Өнгөрсөн арга хэмжээнд: юу болсон, хэдэн хүн оролцсон, ямар үр дүнтэй болсон.</span>
    </div>
  </div>

  <div class="form-actions">
    <button class="btn btn-primary" type="submit">{submitLabel}</button>
    <span class="grow"></span>
    <a class="btn btn-quiet" href={cancelHref}>Болих</a>
  </div>
</form>

<script is:inline>
  (function () {
    var s = document.getElementById('errors'); if (s) s.focus();
    // Picking a start date fills an empty end date with the same day — most events are one evening —
    // and the end's calendar can't go back before the start.
    var a = document.getElementById('start_date'), b = document.getElementById('end_date');
    if (a && b) {
      var sync = function () { b.min = a.value; };
      a.addEventListener('change', function () { sync(); if (!b.value) { b.value = a.value; b.dispatchEvent(new Event('change')); } });
      sync();
    }
  })();
</script>
