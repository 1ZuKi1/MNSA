---
// Generated from the members table: when the President adds, moves or removes someone in the staff
// workspace, this page follows within 5 minutes. Nobody edits HTML when the team changes.
export const prerender = false;
import Public from '../layouts/Public.astro';
import Band from '../components/Band.astro';
import { departments } from '../lib/db';
import { initials, publicTeam } from '../lib/team';
import { academicYear } from '../lib/time';
import type { DeptSlug } from '../lib/types';

const team = await publicTeam();
const depts = (await departments()).filter((d) => !d.is_leadership);
const year = academicYear().replace('-', '–');
// One colour per department, so avatars double as a key.
const TINT: Record<string, string> = { dotood: '#8e0000', gadaad: '#005faf', surgalt: '#1d6b3a', media: '#7a3e9d', 'erh-zui': '#8a5a00' };
---
<Public title="Удирдлагын баг" description={`Бээжингийн Их Сургуулийн Монгол Оюутны Холбооны ${year} оны хичээлийн жилийн удирдлага ба хэлтсүүд.`}>
  <Band kicker={`${year} оны хичээлийн жил`} title="Удирдлагын баг" lede="Холбоог жил бүр сонгуулиар шинэчлэгддэг удирдлага, таван хэлтсийн гишүүд сайн дурын үндсэн дээр ажиллуулдаг." />

  <section class="sec" aria-labelledby="lead-h">
    <div class="wrap">
      <span class="sec-label">Удирдлага</span>
      <h2 id="lead-h">Тэргүүн ба Удирдах Зөвлөл</h2>
      <ul class="rows">
        <li>
          <div class="row-in">
            <span class="k">Тэргүүн</span>
            <div class="v">
              {
                team.president ? (
                  <span class="person">
                    <span class="avatar lg" aria-hidden="true">{initials(team.president.name)}</span>
                    <span><span class="n">{team.president.name}</span><span class="r">Холбоог удирдан чиглүүлж, дотоод болон гадаад харилцаанд төлөөлнө.</span></span>
                  </span>
                ) : (
                  <p class="vacant">Мэдээлэл удахгүй шинэчлэгдэнэ.</p>
                )
              }
            </div>
          </div>
        </li>
        <li>
          <div class="row-in">
            <span class="k">Удирдах Зөвлөл</span>
            <div class="v">
              {
                team.board.length === 0 ? (
                  <p class="vacant">Мэдээлэл удахгүй шинэчлэгдэнэ.</p>
                ) : (
                  <ul class="people">
                    {team.board.map((m) => (
                      <li class="person">
                        <span class="avatar" style="background:var(--night)" aria-hidden="true">{initials(m.name)}</span>
                        <span><span class="n">{m.name}</span><span class="r">Зөвлөлийн гишүүн</span></span>
                      </li>
                    ))}
                  </ul>
                )
              }
            </div>
          </div>
        </li>
      </ul>
    </div>
  </section>

  <section class="sec" aria-labelledby="depts-h">
    <div class="wrap">
      <span class="sec-label">Таван хэлтэс</span>
      <h2 id="depts-h">Хэлтсүүд</h2>
      <ul class="rows">
        {depts.map((d) => {
          const people = team.byDept(d.slug as DeptSlug);
          return (
            <li>
              <div class="row-in">
                <span class="k">{d.name_mn}<small>{d.code}</small></span>
                <div class="v">
                  {people.length === 0 ? (
                    <p class="vacant">Бүрдүүлж байна</p>
                  ) : (
                    <ul class="people">
                      {people.map((m) => (
                        <li class="person">
                          <span class="avatar" style={`background:${TINT[d.slug] ?? 'var(--blue)'}`} aria-hidden="true">{initials(m.name)}</span>
                          <span><span class="n">{m.name}</span><span class="r">{m.role === 'head' ? 'Хэлтсийн дарга' : 'Гишүүн'}</span></span>
                        </li>
                      ))}
                    </ul>
                  )}
                </div>
              </div>
            </li>
          );
        })}
      </ul>
      <p class="note">Энэ жагсаалт холбооны дотоод бүртгэлээс автоматаар шинэчлэгддэг.</p>
      <a class="more" href="/taniltsuulga#butets">Хэлтэс бүрийн чиг үүрэг</a>
    </div>
  </section>
</Public>
