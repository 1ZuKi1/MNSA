---
/** A small set of line icons drawn for this site (24×24, stroke = currentColor). Decorative unless given a label. */
import { ICONS, type IconName } from '../lib/icons';



interface Props {
  name: IconName;
  label?: string;
  class?: string;
}
const { name, label, class: cls } = Astro.props;
---
<svg
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.7"
  stroke-linecap="round"
  stroke-linejoin="round"
  class:list={['icon', cls]}
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
  set:html={ICONS[name]}
/>
