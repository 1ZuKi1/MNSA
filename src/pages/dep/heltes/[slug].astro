---
export const prerender = false;
import Staff from '../../../layouts/Staff.astro';
import PageHead from '../../../components/PageHead.astro';
import Icon from '../../../components/Icon.astro';
import { deptTint, initials } from '../../../lib/team';
import { deptBySlug, many } from '../../../lib/db';
import { membersOfDept } from '../../../lib/members';
import { canCreateRecordIn } from '../../../lib/permissions';
import { getRecordType } from '../../../lib/record-types';
import { listRecords } from '../../../lib/records';
import { academicYear, dateKey, fmtDate, now, relDay } from '../../../lib/time';
import { ROLE_LABEL, STATUS_LABEL, type DeptSlug } from '../../../lib/types';

const user = Astro.locals.user!;
const dept = await deptBySlug(Astro.params.slug ?? '');
if (!dept) return new Response(null, { status: 404 });
const cur = academicYear();
const years = [cur, `${Number(cur.slice(0, 4)) - 1}-${cur.slice(0, 4)}`];
const asked = Astro.url.searchParams.get('year') ?? '';
const year = years.includes(asked) ? asked : cur;
const [members, records, events] = await Promise.all([
  membersOfDept(dept.id),
  listRecords(user, { dept: dept.slug, year, limit: 200 }),
  many<{ id: number; title: string; starts_at: number; status: string }>(
    `SELECT id, title, starts_at, status FROM events WHERE department_id = ? AND ends_at >= ? AND status <> 'cancelled' ORDER BY starts_at`,
    dept.id,
    now(),
  ),
]);
const mine = user.dept === dept.slug;
const canWrite = canCreateRecordIn(user, dept.slug as DeptSlug);
---
<Staff title={dept.name_mn}>
  <PageHead title={dept.name_mn} crumbs={[{ href: '/heltes', label: 'Хэлтсүүд' }]}>
    <Fragment slot="actions">
      {canWrite && <a class="btn btn-primary" href={`/barimt/shine?dept=${dept.slug}`}><Icon name="plus" /> Баримт бичиг</a>}
    </Fragment>
    <span class="code" style="font-weight:700;color:var(--maroon);letter-spacing:.06em">{dept.code}</span>
    {mine && <span class="badge plain b-blue">Таны хэлтэс</span>}
    {!canWrite && <span>Та уншиж болно, засах эрхгүй.</span>}
  </PageHead>

  <div class="cols">
    <section aria-labelledby="rec-h">
      <div style="display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap;margin-bottom:12px">
        <h2 id="rec-h" class="sec-title" style="margin:0">Архив <span class="badge plain">{records.length}</span></h2>
        <nav class="tabs" aria-label="Хичээлийн жил" style="margin:0">
          {years.map((y) => <a href={`/heltes/${dept.slug}?year=${y}`} aria-current={y === year ? 'page' : undefined}>{y}</a>)}
        </nav>
      </div>
      {
        records.length === 0 ? (
          <div class="empty"><Icon name="folder" /><b>{year} онд баримт бичиг алга.</b></div>
        ) : (
          <div class="table-wrap cards-sm">
            <table class="t">
              <caption class="sr-only">{dept.name_mn} — {year} оны баримт бичиг</caption>
              <thead><tr><th scope="col">Гарчиг</th><th scope="col">Төлөв</th><th scope="col" class="num">Шинэчилсэн</th></tr></thead>
              <tbody>
                {records.map((r) => (
                  <tr class="clickable">
                    <td class="main-cell">
                      <a class="row-link" href={`/barimt/${r.id}`}>{r.title}</a>
                      <span class="sub">{getRecordType(r.type)?.label}{r.number && ` · ${r.number}`} · {r.author_name}</span>
                    </td>
                    <td class="side-cell"><span class={`badge b-${r.status}`}>{STATUS_LABEL[r.status]}</span></td>
                    <td class="num nowrap muted hide-sm">{fmtDate(r.updated_at)}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )
      }
    </section>

    <div>
      <section class="panel" aria-labelledby="ppl-h">
        <div class="panel-head"><h2 id="ppl-h"><Icon name="users" /> Бүрэлдэхүүн</h2></div>
        <div class="panel-body">
          {members.length === 0 ? <p class="form-note">Одоогоор гишүүн алга.</p> : (
            <ul class="items">
              {members.map((m) => (
                <li class="item" style="grid-template-columns:auto minmax(0,1fr)">
                  <span class="avatar" style={`--tint:${deptTint(dept.slug)};grid-row:1 / span 2;align-self:center`} aria-hidden="true">{initials(m.name_mn)}</span>
                  <span class="item-title">{m.name_mn}</span>
                  <span class="item-meta"><span>{ROLE_LABEL[m.role]}{m.is_deputy ? ' · орлогч' : ''}</span></span>
                </li>
              ))}
            </ul>
          )}
        </div>
      </section>
      {events.length > 0 && (
        <section class="panel" aria-labelledby="ev-h">
          <div class="panel-head"><h2 id="ev-h"><Icon name="calendar" /> Зохион байгуулах арга хэмжээ</h2></div>
          <div class="panel-body">
            <ul class="items">
              {events.map((e) => {
                const k = dateKey(e.starts_at);
                return (
                  <li class="item" style="grid-template-columns:auto minmax(0,1fr)">
                    <span class="ic"><Icon name="calendar" /></span>
                    <a class="item-title" href={`/uil-ajillagaa/${e.id}`}>{e.title}</a>
                    <span class="item-meta"><span>{k.day} · {k.sub}</span><span>{relDay(e.starts_at)}</span></span>
                  </li>
                );
              })}
            </ul>
          </div>
        </section>
      )}
    </div>
  </div>
</Staff>
