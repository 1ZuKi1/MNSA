---
/**
 * The navy title band at the top of every public page: kicker, page title, one sentence and (optionally)
 * buttons, always in the same place behind a thin gold rule.
 */
interface Props {
  kicker?: string;
  title: string;
  lede?: string | null;
  home?: boolean;
  back?: { href: string; label: string };
}
const { kicker, title, lede, home = false, back } = Astro.props;
---
<section class:list={['band', { 'band-home': home }]}>
  <div class="wrap">
    <div class="band-text">
      {back && <p class="band-back"><a href={back.href}><span aria-hidden="true">←</span> {back.label}</a></p>}
      {kicker && <p class="kicker">{kicker}</p>}
      {
        home ? (
          <h1>
            <span class="pre">Бээжингийн Их Сургуулийн</span>
            Монгол Оюутны Холбоо
          </h1>
        ) : (
          <h1>{title}</h1>
        )
      }
      {lede && <p class="lede">{lede}</p>}
      <slot />
    </div>
  </div>
</section>
