const campus = [
  { k: 'Кампусууд', v: 'Нийт 7: 燕园 (төв кампус), 医学部 (Эмнэлгийн сургууль), 深圳研究生院, 昌平新校区, 大兴校区, 怀柔校区, 英国校区 (Оксфордшир).' },
  { k: 'Төв кампус', v: 'Хоолны газар, номын сан, банк, эмнэлэг, супермаркет, кофе шоп, спорт заал, фитнес, усан бассейн, хэвлэлийн газар — өдөр тутмын бүх хэрэгцээ нэг дор.' },
  { k: 'Хоол', v: 'Сургуулийн хоолны газрууд (食堂) өглөө, өдөр, оройд олон сонголттой. Нэг хоол дунджаар ¥5–30.' },
  { k: 'Ундны ус', v: 'Кампусын бүх газарт үнэгүй. Усны савтайгаа явахад хангалттай.' },
