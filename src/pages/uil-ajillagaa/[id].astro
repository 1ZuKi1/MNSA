---
export const prerender = false;
import Public from '../../layouts/Public.astro';
import Band from '../../components/Band.astro';
import { eventPhotos, getEvent } from '../../lib/events';
import { int } from '../../lib/http';
import { mediaUrl } from '../../lib/media';
import { fmtDate, fmtDateTime, fmtLong, now } from '../../lib/time';

const id = int(Astro.params.id?.split('-')[0]);
const ev = id ? await getEvent(id) : null;
if (!ev || ev.status !== 'published') return new Response(null, { status: 404 });
const photos = await eventPhotos(ev.id);
const past = ev.ends_at < now();
const sameDay = fmtDate(ev.starts_at) === fmtDate(ev.ends_at);
const when = `${fmtDateTime(ev.starts_at)} – ${sameDay ? fmtDateTime(ev.ends_at).slice(11) : fmtDateTime(ev.ends_at)}`;
---
<Public title={ev.title} description={ev.summary ?? undefined} image={mediaUrl(ev.cover_media_id)}>
  <Band
    back={{ href: '/uil-ajillagaa', label: 'Бүх арга хэмжээ' }}
    kicker={`${past ? 'Өнгөрсөн арга хэмжээ' : 'Удахгүй болох'} · ${fmtLong(ev.starts_at)}`}
    title={ev.title}
    lede={ev.summary}
  />

  <section class="sec" aria-labelledby="facts-h">
    <div class="wrap">
      <h2 id="facts-h" class="sr-only">Дэлгэрэнгүй</h2>
      <ul class="rows">
        <li><div class="row-in"><span class="k">Хэзээ</span><div class="v"><p>{when}</p></div></div></li>
        {ev.location && <li><div class="row-in"><span class="k">Хаана</span><div class="v"><p>{ev.location}</p></div></div></li>}
        {ev.dept_name && <li><div class="row-in"><span class="k">Зохион байгуулсан</span><div class="v"><p>{ev.dept_name}</p></div></div></li>}
      </ul>
      {ev.body && <div class="prose" style="margin-top:32px">{ev.body}</div>}
    </div>
  </section>

  {
    photos.length > 0 && (
      <section class="sec" aria-labelledby="photos-h">
        <div class="wrap">
          <span class="sec-label">Зургууд</span>
          <h2 id="photos-h">Арга хэмжээний зургууд</h2>
          <div class="gallery-p" data-gallery>
            {photos.map((p) => (
              <figure>
                <a href={mediaUrl(p.media_id)} target="_blank" rel="noopener" aria-label={`Зургийг томоор харах${p.caption ? ': ' + p.caption : ''}`}>
                  <img src={mediaUrl(p.media_id)} alt={p.caption ?? `${ev.title} — зураг`} loading="lazy" />
                </a>
                {p.caption && <figcaption>{p.caption}</figcaption>}
              </figure>
            ))}
          </div>
        </div>
      </section>
    )
  }

  {
    ev.publisher_name && (
      <div class="wrap">
        <p class="note" style="margin:0 0 48px">Нийтэлсэн: <strong>{ev.publisher_name}</strong> · {fmtLong(ev.published_at)}</p>
      </div>
    )
  }

  {
    photos.length > 0 && (
      <dialog class="lightbox" aria-label="Зураг томоор">
        <span class="lb-count" aria-live="polite"></span>
        <figure class="lb-figure">
          <img alt="" />
          <figcaption></figcaption>
        </figure>
        <button class="lb-btn lb-prev" type="button" aria-label="Өмнөх зураг">‹</button>
        <button class="lb-btn lb-next" type="button" aria-label="Дараагийн зураг">›</button>
        <button class="lb-btn lb-close" type="button" aria-label="Хаах">×</button>
      </dialog>
    )
  }
</Public>

<script is:inline>
  // Photo viewer: opens a photo in place instead of a new tab. Arrow keys move, Esc or a click outside closes.
  // Without JavaScript (or without <dialog> support) the links still open the full photo.
  (function () {
    var grid = document.querySelector('[data-gallery]');
    var box = document.querySelector('.lightbox');
    if (!grid || !box || typeof box.showModal !== 'function') return;
    var links = Array.prototype.slice.call(grid.querySelectorAll('a'));
    var img = box.querySelector('img'), cap = box.querySelector('figcaption'), count = box.querySelector('.lb-count');
    var prev = box.querySelector('.lb-prev'), next = box.querySelector('.lb-next');
    var i = 0, opener = null;
    function show(n) {
      i = (n + links.length) % links.length;
      var a = links[i], thumb = a.querySelector('img'), fc = a.parentNode.querySelector('figcaption');
      img.src = a.href; img.alt = thumb.alt;
      cap.textContent = fc ? fc.textContent : '';
      count.textContent = links.length > 1 ? (i + 1) + ' / ' + links.length : '';
    }
    prev.hidden = next.hidden = links.length < 2;
    links.forEach(function (a, n) {
      a.addEventListener('click', function (e) {
        if (e.metaKey || e.ctrlKey || e.shiftKey) return; // let people open in a new tab on purpose
        e.preventDefault(); opener = a; show(n); box.showModal();
      });
    });
    prev.addEventListener('click', function () { show(i - 1); });
    next.addEventListener('click', function () { show(i + 1); });
    box.querySelector('.lb-close').addEventListener('click', function () { box.close(); });
    box.addEventListener('click', function (e) { if (e.target === box) box.close(); });
    box.addEventListener('keydown', function (e) {
      if (e.key === 'ArrowLeft') show(i - 1);
      if (e.key === 'ArrowRight') show(i + 1);
    });
    box.addEventListener('close', function () { img.removeAttribute('src'); if (opener) opener.focus(); });
  })();
</script>
