---
import '@fontsource-variable/golos-text';
import '../styles/base.css';
import '../styles/staff.css';
import Icon from '../components/Icon.astro';
import type { IconName } from '../lib/icons';
import { cleanStaffPath } from '../lib/hosts';
import { canManageSettings, canSeeAudit, canSeeParticipation } from '../lib/permissions';
import { ROLE_LABEL } from '../lib/types';
import { flashFrom } from '../lib/http';
import { isTestMode, publicOrigin } from '../lib/site';
import { navCounts } from '../lib/nav';
import { initials } from '../lib/team';

interface Props {
  title: string;
  /** Login and invite pages render without the menu. */
  bare?: boolean;
}
const { title, bare = false } = Astro.props;
const user = Astro.locals.user;
const here = cleanStaffPath(Astro.url.pathname);
const flash = flashFrom(Astro.url);
const test = isTestMode(Astro.url);
const counts = user && !bare ? await navCounts(user) : { awaiting: 0, tasks: 0 };

interface NavItem { href: string; label: string; icon: IconName; count?: number; hot?: boolean }
const groups: { label: string; items: NavItem[] }[] = user
  ? [
      {
        label: 'Ажил',
        items: [
          { href: '/', label: 'Нүүр', icon: 'home' },
          { href: '/barimt', label: 'Баримт бичиг', icon: 'doc', count: counts.awaiting, hot: true },
          { href: '/uil-ajillagaa', label: 'Арга хэмжээ', icon: 'calendar', count: counts.tasks },
        ],
      },
      {
        label: 'Холбоо',
        items: [
          { href: '/heltes', label: 'Хэлтсүүд', icon: 'folder' },
          { href: '/gishuud', label: 'Гишүүд', icon: 'users' },
          { href: '/oroltsoo', label: canSeeParticipation(user) ? 'Оролцоо' : 'Миний оролцоо', icon: 'chart' },
          ...(canSeeAudit(user) ? [{ href: '/burtgel', label: 'Үйлдлийн бүртгэл', icon: 'shield' as IconName }] : []),
          ...(canManageSettings(user) ? [{ href: '/tohirgoo', label: 'Тохиргоо', icon: 'stamp' as IconName }] : []),
        ],
      },
    ]
  : [];
const active = (href: string) => (href === '/' ? here === '/' : here === href || here.startsWith(href + '/'));
const totalCount = counts.awaiting;
const roleText = user ? `${ROLE_LABEL[user.role]}${user.isDeputy ? ' · орлогч' : ''}` : '';
---
<!doctype html>
<html lang="mn">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#0d2138" />
    <title>{title} · МОХ ажлын орчин</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <slot name="head" />
  </head>
  <body class:list={['staff', { bare }]}>
    <a class="skip" href="#main">Үндсэн агуулга руу шилжих</a>
    {test && <div class="test-strip" role="note">ТУРШИЛТЫН ОРЧИН — жинхэнэ мэдээлэл бүү оруулаарай. Нэвтрэх код дэлгэц дээр харагдана.</div>}

    {
      bare ? (
        <div class="auth-split">
          <header class="auth-brand">
            <div class="auth-brand-in">
              <span class="auth-logo"><img src="/brand/logo.svg" alt="" width="96" height="73" /></span>
              <div class="auth-brand-text">
                <p class="auth-org">Бээжингийн Их Сургуулийн<br />Монгол Оюутны Холбоо</p>
                <p class="auth-zh" lang="zh-Hans">北京大学蒙古国留学生学生会</p>
                <p class="auth-sub">Дотоод ажлын орчин</p>
              </div>
            </div>
          </header>
          <main id="main" class="bare-wrap" tabindex="-1">
            <slot />
          </main>
        </div>
      ) : (
        <div class="app">
          <header class="topbar">
            <a class="side-brand" href="/">
              <span class="logo"><img src="/brand/logo.svg" alt="" width="26" height="20" /></span>
              <span><b>МОХ</b><small>Ажлын орчин</small></span>
            </a>
            <button class="menu-btn" type="button" aria-expanded="false" aria-controls="side">
              <Icon name="menu" />
              Цэс
              {totalCount > 0 && <span class="count hot">{totalCount}<span class="sr-only"> шийдвэр хүлээж байна</span></span>}
            </button>
          </header>

          <aside class="side" id="side" aria-label="Ажлын орчны цэс">
            <div class="drawer-head">
              <b>Цэс</b>
              <button class="icon-btn" type="button" data-close-menu aria-label="Цэс хаах"><Icon name="x" /></button>
            </div>
            <a class="side-brand" href="/">
              <span class="logo"><img src="/brand/logo.svg" alt="" width="34" height="26" /></span>
              <span><b>МОХ</b><small>Ажлын орчин</small></span>
            </a>
            <nav aria-label="Үндсэн цэс">
              {groups.map((g) => (
                <div class="nav-group">
                  <div class="nav-label" aria-hidden="true">{g.label}</div>
                  <ul class="nav-list">
                    {g.items.map((n) => (
                      <li>
                        <a href={n.href} aria-current={active(n.href) ? 'page' : undefined}>
                          <Icon name={n.icon} />
                          {n.label}
                          {!!n.count && (
                            <span class:list={['count', { hot: n.hot }]}>
                              {n.count}
                              <span class="sr-only">{n.hot ? ' шийдвэр хүлээж байна' : ' идэвхтэй ажил'}</span>
                            </span>
                          )}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
            </nav>
            {user && (
              <div class="side-foot">
                <a class="side-link" href={`${publicOrigin(Astro.url)}/`} target="_blank" rel="noopener">
                  <Icon name="globe" /> Нийтийн сайт <span class="sr-only">(шинэ цонхонд)</span>
                </a>
                <div class="me">
                  <span class="avatar gold" aria-hidden="true">{initials(user.name)}</span>
                  <span class="me-text">
                    <b>{user.name}</b>
                    <small>{roleText}</small>
                  </span>
                  <form method="post" action="/gar">
                    <button class="icon-btn" type="submit" aria-label="Гарах" title="Гарах"><Icon name="logout" /></button>
                  </form>
                </div>
              </div>
            )}
          </aside>
          <div class="scrim" data-close-menu></div>

          <div class="content">
            <main id="main" class="main" tabindex="-1">
              {flash.ok && (
                <div class="flash ok" role="status" data-flash>
                  <Icon name="check" />
                  <span class="flash-text">{flash.ok}</span>
                  <button class="flash-x" type="button" aria-label="Хаах"><Icon name="x" /></button>
                </div>
              )}
              {flash.err && (
                <div class="flash err" role="alert" data-flash>
                  <Icon name="alert" />
                  <span class="flash-text">{flash.err}</span>
                  <button class="flash-x" type="button" aria-label="Хаах"><Icon name="x" /></button>
                </div>
              )}
              <slot />
            </main>
            <footer class="foot">Бээжингийн Их Сургуулийн Монгол Оюутны Холбоо · дотоод ажлын орчин</footer>
          </div>
        </div>
      )
    }

    <script is:inline>
      (function () {
        // ---- drawer menu (phones): button toggles, Esc / scrim / × close, the page behind goes inert
        var side = document.getElementById('side');
        var btn = document.querySelector('.menu-btn');
        var content = document.querySelector('.content');
        var scrim = document.querySelector('.scrim');
        function setMenu(open) {
          if (!side || !btn) return;
          side.classList.toggle('open', open);
          if (scrim) scrim.classList.toggle('open', open);
          btn.setAttribute('aria-expanded', String(open));
          if (content) content.inert = open;
          document.documentElement.style.overflow = open ? 'hidden' : '';
          if (open) { var first = side.querySelector('a, button'); if (first) first.focus(); }
          else btn.focus();
        }
        if (btn) btn.addEventListener('click', function () { setMenu(!side.classList.contains('open')); });
        document.querySelectorAll('[data-close-menu]').forEach(function (el) { el.addEventListener('click', function () { setMenu(false); }); });
        document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && side && side.classList.contains('open')) setMenu(false); });
        matchMedia('(min-width: 1000px)').addEventListener('change', function (m) { if (m.matches && side && side.classList.contains('open')) setMenu(false); });

        // ---- flash: dismissable, and removed from the address bar so a refresh doesn't repeat it
        document.querySelectorAll('[data-flash] .flash-x').forEach(function (x) {
          x.addEventListener('click', function () { x.closest('[data-flash]').remove(); });
        });
        var u = new URL(location.href);
        if (u.searchParams.has('ok') || u.searchParams.has('err')) {
          u.searchParams.delete('ok'); u.searchParams.delete('err');
          history.replaceState(null, '', u.pathname + (u.search ? u.search : '') + u.hash);
        }

        // ---- every form: ask before destructive actions, check "required with this button" fields, submit only once
        document.addEventListener('submit', function (e) {
          var form = e.target;
          var by = e.submitter;
          if (form.dataset.busy) { e.preventDefault(); return; }
          var need = by && by.dataset.require ? document.getElementById(by.dataset.require) : null;
          if (need && !need.value.trim()) {
            e.preventDefault();
            need.setAttribute('aria-invalid', 'true');
            var msg = document.getElementById(by.dataset.require + '-msg');
            if (msg) msg.hidden = false;
            need.focus();
            return;
          }
          var ask = (by && by.dataset.confirm) || form.dataset.confirm;
          if (ask && !window.confirm(ask)) { e.preventDefault(); return; }
          form.dataset.busy = '1';
          form.setAttribute('aria-busy', 'true');
          if (by) by.classList.add('is-busy');
          form.dataset.submitted = '1';

          // POST forms go in the background, and the page that comes back REPLACES this one in the history.
          // A normal submit adds a second copy of the same page (member page → save → member page again),
          // so Back seemed to do nothing. getAttribute: many forms have an <input name="action">, which
          // hides form.action.
          var method = (form.getAttribute('method') || 'get').toLowerCase();
          if (method !== 'post' || form.getAttribute('target') || !window.fetch || form.hasAttribute('data-native')) return;
          e.preventDefault();
          var body = new FormData(form);
          if (by && by.name) body.append(by.name, by.value);
          var url = new URL(form.getAttribute('action') || location.href, location.href).href;
          fetch(url, { method: 'POST', body: body, credentials: 'same-origin' })
            .then(function (res) {
              if (res.redirected) { location.replace(res.url); return; }
              // the same page again, e.g. with a form error: show it in place of this one
              return res.text().then(function (html) {
                history.replaceState(null, '', res.url);
                document.open(); document.write(html); document.close();
              });
            })
            .catch(function () {
              delete form.dataset.busy; delete form.dataset.submitted; form.removeAttribute('aria-busy');
              if (by) by.classList.remove('is-busy');
              window.alert('Сүлжээний алдаа гарлаа. Интернэтээ шалгаад дахин оролдоно уу.');
            });
        });

        // ---- table rows: a tap anywhere on a row opens it (not only on its title). Done here rather than
        //      with a link stretched over the row, which some browsers (Safari) place over the wrong row.
        document.addEventListener('click', function (e) {
          var tr = e.target.closest && e.target.closest('tr.clickable');
          if (!tr || e.defaultPrevented || e.button !== 0) return;
          if (e.target.closest('a, button, input, select, textarea, label, summary, form')) return;
          if (String(window.getSelection && window.getSelection())) return; // selecting text, not opening
          var link = tr.querySelector('a.row-link');
          if (!link) return;
          if (e.ctrlKey || e.metaKey || e.shiftKey) window.open(link.href, '_blank', 'noopener');
          else location.href = link.href;
        });
        // coming "back" to a page restores it from cache — make its forms usable again
        window.addEventListener('pageshow', function () {
          document.querySelectorAll('form[data-busy]').forEach(function (f) {
            delete f.dataset.busy; f.removeAttribute('aria-busy');
            f.querySelectorAll('.is-busy').forEach(function (b) { b.classList.remove('is-busy'); });
          });
        });

        // ---- dates and times, the same on every form: a click anywhere on a date box opens the calendar,
        //      and under each date the day is spelled out the association's way (Бямба, 2026.10.10), because
        //      the box itself shows the browser's own format (10/10/2026 on an English browser). Times are typed
        //      as ЦЦ:ММ (components/TimeInput.astro), never the browser's clock box.
        var DAYS = ['Ням', 'Даваа', 'Мягмар', 'Лхагва', 'Пүрэв', 'Баасан', 'Бямба'];
        document.querySelectorAll('input[type=date]').forEach(function (el) {
          el.addEventListener('click', function () { try { el.showPicker(); } catch (e) { /* already open, or an older browser */ } });
        });
        var TIME = /^([01]\d|2[0-3]):[0-5]\d$/;
        // typed times: the colon puts itself in (1830 → 18:30, 930 → 9:30), and leaving the box completes
        // the time (9 → 09:00, 9:30 → 09:30). Hours starting 3–9 can only be one digit.
        document.querySelectorAll('input[data-time]').forEach(function (el) {
          el.addEventListener('input', function (e) {
            if (e.inputType && e.inputType.indexOf('delete') === 0) return; // backspace works as usual
            var d = el.value.replace(/\D/g, '');
            var h = d[0] > '2' || (d[0] === '2' && d[1] > '3') ? 1 : 2;
            el.value = d.length > h ? d.slice(0, h) + ':' + d.slice(h, h + 2) : d;
          });
          el.addEventListener('blur', function () {
            var m = /^(\d{1,2})(?:[:.\s]?(\d{2}))?$/.exec(el.value.trim());
            if (!m) return;
            el.value = (m[1].length === 1 ? '0' : '') + m[1] + ':' + (m[2] || '00');
            el.dispatchEvent(new Event('change'));
          });
        });
        function spell(el) {
          if (el.hasAttribute('data-time')) return TIME.test(el.value) ? el.value : '';
          var m = /^(\d{4})-(\d{2})-(\d{2})$/.exec(el.value);
          return m ? DAYS[new Date(+m[1], m[2] - 1, +m[3]).getDay()] + ', ' + m[1] + '.' + m[2] + '.' + m[3] : '';
        }
        // one line per group: a date with its time (Бямба, 2026.10.10, 18:00) or a period (… – …)
        document.querySelectorAll('.field input[type=date]').forEach(function (d) {
          var group = d.closest('.dt');
          if (group && group.querySelector('input[type=date]') !== d) return;
          var inputs = group ? Array.prototype.slice.call(group.querySelectorAll('input')) : [d];
          var range = group && group.classList.contains('range');
          var echo = document.createElement('span');
          echo.className = 'date-echo';
          (group || d).after(echo);
          function show() {
            var parts = inputs.map(spell);
            echo.textContent = parts[0] ? parts.filter(Boolean).join(range ? ' – ' : ', ') : '';
          }
          inputs.forEach(function (el) { el.addEventListener('input', show); el.addEventListener('change', show); });
          show();
        });
        // in a period, the end's calendar starts at the chosen start and can't go before it (times are checked on saving)
        document.querySelectorAll('.dt.range').forEach(function (g) {
          var ends = g.querySelectorAll('input');
          function sync() { if (ends[1].type === 'date') ends[1].min = ends[0].value; }
          ends[0].addEventListener('change', sync);
          sync();
        });

        // ---- long forms: warn before leaving with unsaved changes
        document.querySelectorAll('form[data-guard]').forEach(function (f) {
          var dirty = false;
          f.addEventListener('input', function () { dirty = true; });
          window.addEventListener('beforeunload', function (e) {
            if (dirty && !f.dataset.submitted) { e.preventDefault(); e.returnValue = ''; }
          });
        });

        // ---- copy buttons
        document.querySelectorAll('[data-copy]').forEach(function (b) {
          b.addEventListener('click', function () {
            var input = document.getElementById(b.dataset.copy);
            if (!input) return;
            input.select();
            var label = b.querySelector('[data-label]') || b;
            var done = function () {
              var was = label.textContent; label.textContent = 'Хуулсан ✓';
              setTimeout(function () { label.textContent = was; }, 2000);
            };
            // Without the clipboard API the text is at least selected, ready for Ctrl+C / long-press.
            if (navigator.clipboard) navigator.clipboard.writeText(input.value).then(done);
          });
        });
      })();
    </script>
  </body>
</html>
