---
export const prerender = false;
import Staff from '../../../layouts/Staff.astro';
import RecordForm from '../../../components/RecordForm.astro';
import PageHead from '../../../components/PageHead.astro';
import Icon from '../../../components/Icon.astro';
import { departments } from '../../../lib/db';
import { readRecordForm } from '../../../lib/forms';
import { clientIp, withFlash } from '../../../lib/http';
import { canCreateRecordIn } from '../../../lib/permissions';
import { getRecordType, RECORD_TYPE_LIST, TYPE_GROUPS } from '../../../lib/record-types';
import { prefill } from '../../../lib/prefill';
import { createRecord, getRecord, submitRecord } from '../../../lib/records';
import { STEP_LABEL, type DeptSlug } from '../../../lib/types';
import { stepApplies } from '../../../lib/permissions';

const user = Astro.locals.user!;
const allDepts = await departments();
const depts = allDepts.filter((d) => canCreateRecordIn(user, d.slug as DeptSlug));
if (!depts.length) return Astro.redirect(withFlash('/barimt', 'denied', 'err'));

let type = getRecordType(Astro.url.searchParams.get('type') ?? '');
let title = '';
let values: Record<string, string> = {};
let errors: Record<string, string> = {};
let visibility: 'staff' | 'dept' = 'staff';
let coDept: DeptSlug | null = null;
const askedDept = Astro.url.searchParams.get('dept');
let dept = askedDept && depts.some((d) => d.slug === askedDept)
  ? askedDept
  : user.dept && depts.some((d) => d.slug === user.dept) ? user.dept : depts[0].slug;
const chainText = (chain: typeof RECORD_TYPE_LIST[number]['chain']) => {
  const steps = chain.filter((s) => stepApplies(s, dept as DeptSlug)).map((s) => STEP_LABEL[s]);
  return steps.length ? steps.join(' → ') : 'шууд батлагдана';
};
const typeHref = (slug: string) => `/barimt/shine?type=${slug}${askedDept ? `&dept=${askedDept}` : ''}`;

if (Astro.request.method === 'GET' && type) values = await prefill(type, dept as DeptSlug, user);

if (Astro.request.method === 'POST') {
  const form = readRecordForm(await Astro.request.formData());
  if (form) {
    ({ type, title, values, errors, visibility, coDept } = form);
    dept = (form.dept || dept) as DeptSlug;
    if (!depts.some((d) => d.slug === dept)) errors.dept = 'Энэ хэлтэст бичих эрх танд байхгүй.';
    if (coDept && (coDept === dept || !allDepts.some((d) => d.slug === coDept))) errors.co_dept = 'Үндсэн хэлтсээс өөр хэлтэс сонгоно уу.';
    if (form.ok && !errors.dept && !errors.co_dept) {
      const ip = clientIp(Astro.request);
      const id = await createRecord(user, { type: form.type, dept: dept as DeptSlug, coDept, title, values, visibility }, ip);
      if (form.then === 'submit') {
        await submitRecord(user, (await getRecord(id))!, ip);
        return Astro.redirect(withFlash(`/barimt/${id}`, 'submitted'));
      }
      return Astro.redirect(withFlash(`/barimt/${id}`, 'created'));
    }
  }
}
---
<Staff title={type ? `Шинэ ${type.label.toLowerCase()}` : 'Шинэ баримт бичиг'}>
  <PageHead
    title={type ? type.label : 'Ямар баримт бичиг вэ?'}
    sub={type ? type.description : 'Төрлөө сонгоно уу. Төрөл бүр өөрийн маягт, батлах дараалалтай.'}
    crumbs={[{ href: '/barimt', label: 'Баримт бичиг' }, ...(type ? [{ href: '/barimt/shine', label: 'Шинэ' }] : [])]}
  >
    <Fragment slot="actions">
      {type && <a class="btn btn-quiet" href="/barimt/shine"><Icon name="back" /> Төрөл солих</a>}
    </Fragment>
  </PageHead>

  {
    !type ? (
      <div class="stack" style="--stack:26px">
        {TYPE_GROUPS.map((g) => (
          <section aria-labelledby={`g-${g.key}`}>
            <h2 class="group-h" id={`g-${g.key}`}>{g.label}</h2>
            <div class="type-grid">
              {RECORD_TYPE_LIST.filter((t) => t.group === g.key).map((t) => (
                <a class="type-card" href={typeHref(t.slug)}>
                  <span class="ic"><Icon name={t.icon} /></span>
                  <h3>{t.label}</h3>
                  <p>{t.description}</p>
                  <span class="chain-note">Батлах: {chainText(t.chain)}</span>
                </a>
              ))}
            </div>
          </section>
        ))}
      </div>
    ) : (
      <RecordForm
        type={type}
        title={title}
        values={values}
        errors={errors}
        visibility={visibility}
        depts={depts}
        dept={dept}
        allDepts={allDepts}
        coDept={coDept}
        submitLabel="Ноорог хадгалах"
        cancelHref="/barimt"
      />
    )
  }
</Staff>
