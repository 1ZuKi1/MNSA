---
import Public from '../layouts/Public.astro';
import Band from '../components/Band.astro';
---
<Public title="Хуудас олдсонгүй">
  <Band kicker="404" title="Хуудас олдсонгүй" lede="Таны хайсан хуудас байхгүй эсвэл өөр хаяг руу шилжсэн байна.">
    <div class="btn-row">
      <a class="btn btn-gold" href="/">Нүүр хуудас руу <span class="arr" aria-hidden="true">→</span></a>
    </div>
  </Band>

  <section class="sec" aria-labelledby="nf-h">
    <div class="wrap">
      <span class="sec-label">Эсвэл</span>
      <h2 id="nf-h">Эндээс хайж үзээрэй</h2>
      <ul class="nf-links">
        <li><a class="more" href="/taniltsuulga">Танилцуулга</a></li>
        <li><a class="more" href="/udirdlaga">Удирдлагын баг</a></li>
        <li><a class="more" href="/uil-ajillagaa">Үйл ажиллагаа</a></li>
        <li><a class="more" href="/holboo-barih">Холбоо барих</a></li>
      </ul>
    </div>
  </section>
</Public>
