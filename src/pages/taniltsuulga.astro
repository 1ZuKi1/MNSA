---
// Static content: prerendered at build, free to serve.
import Public from '../layouts/Public.astro';
import Band from '../components/Band.astro';
import Icon from '../components/Icon.astro';
import { CONSTITUTION as C } from '../lib/public-docs';

const goals = [
  'Монгол оюутнуудын эрх ашгийг хамгаалах',
  'Харилцан ойлголцол, эв нэгдэл, хамтын ажиллагааг дэмжих',
  'Оюутнуудын соёл, боловсролын хөгжилд дэмжлэг үзүүлэх',
  'Шинээр элссэн оюутнуудыг Бээжин болон Бээжингийн Их Сургуульд дасан зохицоход дэмжих',
  'Монголын түүх, соёл, уламжлалыг сурталчлах',
  'Эрүүл, идэвхтэй амьдралын хэв маягийг дэмжих',
  'Бусад оюутны байгууллага болон холбогдох байгууллагуудтай хамтран ажиллах',
];
const values = [
  { name: 'Эв нэгдэл', text: 'Бид нэг нэгнийхээ төлөө.' },
  { name: 'Хариуцлага', text: 'Хэлсэндээ хүрч, хийсэн ажлаа тайлагнана.' },
  { name: 'Хүндэтгэл', text: 'Хүн бүрийн санаа бодлыг сонсоно.' },
  { name: 'Ил тод байдал', text: 'Шийдвэр нь гишүүдэд нээлттэй.' },
  { name: 'Хамтын ажиллагаа', text: 'Бусад холбоо, байгууллагатай хамтарна.' },
  { name: 'Тасралтгүй хөгжил', text: 'Жилээс жилд өсөж дэвшинэ.' },
];
const structure = [
  { k: 'Тэргүүн', text: 'Холбооны өдөр тутмын үйл ажиллагааг удирдан чиглүүлж, Холбоог дотоод болон гадаад харилцаанд төлөөлнө.' },
  { k: 'Удирдах Зөвлөл', text: 'Холбооны үйл ажиллагааг хянана.' },
  { k: 'Дотоод хэлтэс', text: 'Гишүүдийн хоорондын харилцаа, шинэ оюутныг угтах, холбооны дотоод арга хэмжээ.' },
  { k: 'Гадаад хэлтэс', text: 'Бусад холбоо, их сургууль, байгууллагатай тогтоох хамтын ажиллагаа.' },
  { k: 'Сургалтын хэлтэс', text: 'Хичээл, сургалт, мэдээлэл, судалгааны дэмжлэг.' },
  { k: 'Медиа хэлтэс', text: 'Мэдээ, зураг, сошиал сувгууд болон цахим хуудас.' },
  { k: 'Эрх зүйн хэлтэс', text: 'Үндсэн дүрэм, баримт бичгийн стандарт, дүрэмтэй нийцэл, архив.' },
];
// The yearly rhythm, from the Үндсэн дүрэм.
const calendar = [
  { k: 'Намрын улирал, 2-р долоо хоног', text: 'Холбооны сонгууль. Сонгуулийн хороо зохион байгуулж, шинэ Тэргүүнийг зарлана.', ref: '40.1' },
  { k: 'Намрын улирал, 3-р долоо хоног', text: 'Их Хуралдаан. Үндсэн дүрмийг гишүүдэд танилцуулж, шинэ удирдлага, хэлтсийн гишүүд гарын үсэг зурж ажлаа хүлээн авна.', ref: '17.1, 18.1' },
  { k: 'Улирал бүр', text: 'Хэлтсүүд хийсэн ажлынхаа тайланг Тэргүүн, Удирдах Зөвлөлд танилцуулна. Удирдах Зөвлөл хуралдана.', ref: '21.3, 23.4' },
  { k: 'Хаврын улирал, 14-р долоо хоног', text: 'Дараа жилийн сонгуулийг зохион байгуулах Сонгуулийн хороо байгуулагдана.', ref: '41.1' },
];
const history = [
  { date: '2025-09-28', k: '2025.09.28', text: 'Холбооны Үндсэн дүрмийн анхны хувилбар батлагдав — 13 бүлэг, 48 зүйл, 204 заалт.' },
  { date: '2025-11-08', k: '2025.11.08', text: 'Үндсэн дүрмийн анхдугаар шинэчилсэн найруулгыг баталж, 13 бүлэг, 53 зүйл, 247 заалттай болгов.' },
  { date: '2026-09-01', k: '2026.09.01', text: 'Сонгуулийн журам батлагдав — Тэргүүн, хэлтсийн дарга, хэлтсийн гишүүдийг сонгох журам.' },
  { date: '2026-09-19', k: '2026.09.19', text: '2026–2027 оны хичээлийн жилийн сонгууль болж, шинэ удирдлага ажил үүргээ хүлээн авав.' },
];
---
<Public title="Танилцуулга" description="Бээжингийн Их Сургуулийн Монгол Оюутны Холбооны эрхэм зорилго, зорилт, үнэт зүйлс, бүтэц, түүх.">
  <Band kicker="Танилцуулга" title="Бид хэн бэ" lede="Холбоо юуны төлөө байгуулагдсан, хэрхэн зохион байгуулагддаг, ямар замыг туулсныг эндээс уншаарай." />

  <nav class="toc" aria-label="Энэ хуудсанд">
    <div class="wrap">
      <ul>
        <li><a href="#about">Бидний тухай</a></li>
        <li><a href="#goals">Зорилтууд</a></li>
        <li><a href="#values">Үнэт зүйлс</a></li>
        <li><a href="#butets">Бүтэц</a></li>
        <li><a href="#huvaari">Жилийн хуваарь</a></li>
        <li><a href="#tuuh">Түүх</a></li>
        <li><a href="#durem">Үндсэн дүрэм</a></li>
      </ul>
    </div>
  </nav>

  <section class="sec" id="about" aria-labelledby="about-h">
    <div class="wrap">
      <span class="sec-label">Бидний тухай</span>
      <h2 id="about-h">Монгол Оюутны Холбоо</h2>
      <p class="alt-name">Хятадаар: <span lang="zh-Hans">北京大学蒙古国留学生学生会</span></p>
      <div class="text">
        <p>
          Бээжингийн Их Сургуулийн Монгол Оюутны Холбоо нь Бээжингийн Их Сургуульд суралцаж буй Монгол Улсын иргэн оюутнуудын
          сайн дурын үндсэн дээр байгуулагдсан оюутны байгууллага юм.
        </p>
        <p>
          Гишүүдийн хамтын ажиллагаа, эв нэгдэл, харилцан туслалцааг дэмжихийн зэрэгцээ Монгол оюутнуудын эрх ашгийг хамгаалах,
          соёл, боловсролын хөгжилд дэмжлэг үзүүлэх, Монголын түүх, соёл, уламжлалыг сурталчлах чиглэлээр үйл ажиллагаа явуулдаг.
        </p>
        <p>
          Бээжингийн Их Сургуульд суралцаж буй Монгол Улсын иргэн бүх түвшний оюутан — хэлний бэлтгэл, бакалавр (Эмнэлгийн
          сургуулийг оролцуулан), магистр, доктор — Холбооны гишүүн. Тусгайлан бүртгүүлэх шаардлагагүй. Монгол Улсаас түр
          хугацаагаар суралцахаар ирсэн оюутнууд ажиглагч гишүүн байна.
        </p>
        <p>Холбоо бүх үйл ажиллагаагаа <a href="#durem">Үндсэн дүрмийнхээ</a> дагуу явуулдаг. Бүрэн эхийг хэн ч уншиж, татаж авах боломжтой.</p>
      </div>
      <span class="quote-cap">Эрхэм зорилго</span>
      <p class="quote">
        Монгол оюутнуудыг нэгтгэж, тэдний эрх ашиг, сайн сайхан байдал, хөгжлийг дэмжсэн тогтвортой, хариуцлагатай,
        хүртээмжтэй оюутны байгууллагыг төлөвшүүлэх.
      </p>
    </div>
  </section>

  <section class="sec" id="goals" aria-labelledby="goals-h">
    <div class="wrap">
      <span class="sec-label">Зорилтууд</span>
      <h2 id="goals-h">Үндсэн зорилтууд</h2>
      <ol class="numbered">{goals.map((g) => <li>{g}</li>)}</ol>
    </div>
  </section>

  <section class="sec" id="values" aria-labelledby="values-h">
    <div class="wrap">
      <span class="sec-label">Үнэт зүйлс</span>
      <h2 id="values-h">Биднийг юу холбодог вэ</h2>
      <ul class="pairs">{values.map((v) => <li><b>{v.name}</b><span>{v.text}</span></li>)}</ul>
    </div>
  </section>

  <section class="sec" id="butets" aria-labelledby="org-h">
    <div class="wrap">
      <span class="sec-label">Бүтэц</span>
      <h2 id="org-h">Хэрхэн зохион байгуулагддаг вэ</h2>
      <ul class="rows">
        {structure.map((s) => (
          <li>
            <div class="row-in">
              <span class="k">{s.k}</span>
              <div class="v"><p>{s.text}</p></div>
            </div>
          </li>
        ))}
      </ul>
      <p class="note">Хэлтэс бүр өөрийн чиг үүргийн хүрээнд ажлаа төлөвлөж, хэрэгжүүлнэ. Хэлтсийн дарга нь хэлтсийнхээ ажлыг удирдан зохион байгуулж, Тэргүүнд тайлагнана.</p>
      <a class="more" href="/udirdlaga">Одоогийн удирдлагын баг</a>
    </div>
  </section>

  <section class="sec" id="huvaari" aria-labelledby="cal-h">
    <div class="wrap">
      <span class="sec-label">Жилийн хуваарь</span>
      <h2 id="cal-h">Жил бүр юу болдог вэ</h2>
      <ul class="rows">
        {calendar.map((c) => (
          <li>
            <div class="row-in">
              <span class="k">{c.k}</span>
              <div class="v"><p>{c.text}</p><p class="ref">Үндсэн дүрэм, {c.ref}</p></div>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="sec" id="tuuh" aria-labelledby="hist-h">
    <div class="wrap">
      <span class="sec-label">Түүх</span>
      <h2 id="hist-h">Замнал</h2>
      <ul class="rows">
        {history.map((h) => (
          <li>
            <div class="row-in">
              <time class="k" datetime={h.date}>{h.k}</time>
              <div class="v"><p>{h.text}</p></div>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="sec" id="durem" aria-labelledby="durem-h">
    <div class="wrap">
      <span class="sec-label">Үндсэн дүрэм</span>
      <h2 id="durem-h">Холбооны Үндсэн дүрэм</h2>
      <div class="doc-card">
        <span class="doc-ic" aria-hidden="true"><Icon name="doc" /><b>PDF</b></span>
        <div class="doc-body">
          <h3>Үндсэн дүрэм — {C.version}</h3>
          <p class="doc-meta">{C.adopted}-нд батлагдсан · {C.counts}</p>
          <p class="doc-meta">PDF · {C.pages} хуудас · {C.size}</p>
          <div class="btn-row">
            <a class="btn btn-primary" href={C.href} target="_blank" rel="noopener">Унших<span class="sr-only"> (PDF, шинэ цонхонд)</span></a>
            <a class="btn" href={C.href} download={C.download}><Icon name="download" /> Татаж авах<span class="sr-only"> (PDF, {C.size})</span></a>
          </div>
        </div>
      </div>

      <h3 class="sub-h" id="chapters-h">Бүлгүүд</h3>
      <ol class="numbered chapters" aria-labelledby="chapters-h">
        {C.chapters.map(([name, arts]) => <li><span>{name}<small>{arts}-р зүйл</small></span></li>)}
      </ol>
      <p class="note">
        Холбооны албан ёсны баримт бичиг Монгол хэл дээр байна (5.1). Гишүүн бүр Холбооны бүх мэдээлэлд нээлттэй хандах эрхтэй
        (10.1.4). Үндсэн дүрэмд өөрчлөлт оруулах саналаа Холбоонд албан ёсоор гаргана (50.1).
      </p>
    </div>
  </section>
</Public>
