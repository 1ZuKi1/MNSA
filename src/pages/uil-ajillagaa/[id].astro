---
export const prerender = false;
import Public from '../../layouts/Public.astro';
import { eventPhotos, getEvent } from '../../lib/events';
import { int } from '../../lib/http';
import { mediaUrl } from '../../lib/media';
import { fmtDate, fmtDateTime, fmtLong, now } from '../../lib/time';

const id = int(Astro.params.id?.split('-')[0]);
const ev = id ? await getEvent(id) : null;
if (!ev || ev.status !== 'published') return new Response(null, { status: 404 });
const photos = await eventPhotos(ev.id);
const past = ev.ends_at < now();
const sameDay = fmtDate(ev.starts_at) === fmtDate(ev.ends_at);
---
<Public title={ev.title} description={ev.summary ?? undefined} image={mediaUrl(ev.cover_media_id)}>
  <article class="wrap ev-detail page-hero">
    <p><a href="/uil-ajillagaa">← Бүх арга хэмжээ</a></p>
    <p class="kicker-p" style="margin-top:22px">{past ? 'Өнгөрсөн арга хэмжээ' : 'Удахгүй болох'} · {fmtLong(ev.starts_at)}</p>
    <h1 class="display" style="font-size:clamp(2.1rem,1.4rem + 2.8vw,3.6rem)">{ev.title}</h1>
    {ev.summary && <p class="lede">{ev.summary}</p>}

    <dl class="ev-facts">
      <div><dt>Хэзээ</dt><dd>{fmtDateTime(ev.starts_at)} – {sameDay ? fmtDateTime(ev.ends_at).slice(11) : fmtDateTime(ev.ends_at)}</dd></div>
      {ev.location && <div><dt>Хаана</dt><dd>{ev.location}</dd></div>}
      {ev.dept_name && <div><dt>Зохион байгуулсан</dt><dd>{ev.dept_name}</dd></div>}
    </dl>

    {ev.body && <div class="prose">{ev.body}</div>}

    {
      photos.length > 0 && (
        <section class="gallery-p" aria-label="Зургууд">
          {photos.map((p) => (
            <figure>
              <a href={mediaUrl(p.media_id)} target="_blank" rel="noopener">
                <img src={mediaUrl(p.media_id)} alt={p.caption ?? `${ev.title} — зураг`} loading="lazy" />
              </a>
              {p.caption && <figcaption>{p.caption}</figcaption>}
            </figure>
          ))}
        </section>
      )
    }

    {ev.publisher_name && <p class="muted" style="margin-top:36px;padding-top:16px;border-top:1px solid var(--line)">Нийтэлсэн: <strong>{ev.publisher_name}</strong> · {fmtLong(ev.published_at)}</p>}
  </article>
</Public>
