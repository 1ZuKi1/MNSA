---
import '@fontsource-variable/golos-text';
import '@fontsource-variable/source-serif-4/opsz.css';
import '../styles/base.css';
import '../styles/public.css';

interface Props {
  title?: string;
  description?: string;
  image?: string | null;
}
const {
  title,
  description = 'Бээжингийн Их Сургуульд суралцаж буй Монгол оюутнуудын холбоо — үйл ажиллагаа, удирдлагын баг, холбоо барих мэдээлэл.',
  image,
} = Astro.props;
const NAME = 'Бээжингийн Их Сургуулийн Монгол Оюутны Холбоо';
const full = title ? `${title} · ${NAME}` : NAME;
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const nav = [
  { href: '/', label: 'Нүүр' },
  { href: '/taniltsuulga', label: 'Танилцуулга' },
  { href: '/udirdlaga', label: 'Удирдлагын баг' },
  { href: '/uil-ajillagaa', label: 'Үйл ажиллагаа' },
  { href: '/holboo-barih', label: 'Холбоо барих' },
];
const current = (h: string) => (h === '/' ? path === '/' : path === h || path.startsWith(h + '/'));
const ogImage = new URL(image ?? '/brand/logo-512.png', Astro.url).href;
---
<!doctype html>
<html lang="mn">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{full}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0d2138" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="МОХ · Бээжингийн Их Сургууль" />
    <meta property="og:title" content={title ?? NAME} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body class="public">
    <a class="skip" href="#main">Үндсэн агуулга руу шилжих</a>

    <header class="ph-header">
      <div class="wrap ph-bar">
        <a href="/" class="ph-brand" aria-label="Нүүр хуудас — Бээжингийн Их Сургуулийн Монгол Оюутны Холбоо">
          <img src="/brand/logo.svg" alt="" width="58" height="44" />
          <span>
            <span class="t1">Бээжингийн Их Сургуулийн</span>
            <span class="t2">Монгол Оюутны Холбоо</span>
          </span>
        </a>
        <button class="menu-btn" type="button" aria-expanded="false" aria-controls="site-nav">
          <span class="bars" aria-hidden="true"></span> <span class="menu-label">Цэс</span>
        </button>
        <nav id="site-nav" class="ph-nav" aria-label="Үндсэн цэс">
          <ul>
            {nav.map((n) => (
              <li>
                <a href={n.href} aria-current={current(n.href) ? 'page' : undefined}>{n.label}</a>
              </li>
            ))}
          </ul>
        </nav>
      </div>
    </header>

    <main id="main" tabindex="-1">
      <slot />
    </main>

    <footer class="pf">
      <div class="wrap">
        <div class="pf-grid">
          <div>
            <p class="pf-name">Бээжингийн Их Сургуулийн<br />Монгол Оюутны Холбоо</p>
            <p class="pf-zh" lang="zh-Hans">北京大学蒙古国留学生学生会</p>
            <p style="margin-top:10px">Бээжингийн Их Сургуульд суралцаж буй Монгол оюутнуудын сайн дурын байгууллага.</p>
          </div>
          <div>
            <h2>Хуудсууд</h2>
            <ul>{nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}</ul>
          </div>
          <div>
            <h2>Холбогдох</h2>
            <ul>
              <li><a href="mailto:pku_mongolia@163.com">pku_mongolia@163.com</a></li>
              <li><a href="https://www.instagram.com/pku_mongolia/" rel="noopener">Instagram · @pku_mongolia</a></li>
            </ul>
          </div>
        </div>
        <div class="pf-bottom">
          <span>© {new Date().getFullYear()} МОХ</span>
          <span>Peking University · MNSA</span>
        </div>
      </div>
    </footer>

    <script is:inline>
      (function () {
        // Mobile menu: a real button with aria-expanded; without JS the nav is simply always shown.
        var btn = document.querySelector('.menu-btn');
        var nav = document.getElementById('site-nav');
        var label = btn && btn.querySelector('.menu-label');
        function set(open) {
          btn.setAttribute('aria-expanded', String(open));
          nav.classList.toggle('open', open);
          if (label) label.textContent = open ? 'Хаах' : 'Цэс';
        }
        if (btn && nav) {
          btn.addEventListener('click', function () { set(btn.getAttribute('aria-expanded') !== 'true'); });
          document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape' && nav.classList.contains('open')) { set(false); btn.focus(); }
          });
          document.addEventListener('click', function (e) {
            if (nav.classList.contains('open') && !e.target.closest('.ph-header')) set(false);
          });
          matchMedia('(min-width: 901px)').addEventListener('change', function (m) { if (m.matches) set(false); });
        }
        // A soft shadow under the header once the page has scrolled.
        var header = document.querySelector('.ph-header');
        if (header) {
          var tick = function () { header.classList.toggle('is-scrolled', window.scrollY > 4); };
          window.addEventListener('scroll', tick, { passive: true });
          tick();
        }
      })();
    </script>
  </body>
</html>
