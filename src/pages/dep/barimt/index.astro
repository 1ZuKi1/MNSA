---
export const prerender = false;
import Staff from '../../../layouts/Staff.astro';
import PageHead from '../../../components/PageHead.astro';
import Icon from '../../../components/Icon.astro';
import { departments } from '../../../lib/db';
import { canCreateRecordIn } from '../../../lib/permissions';
import { getRecordType, RECORD_TYPE_LIST } from '../../../lib/record-types';
import { awaitingMe, listRecords } from '../../../lib/records';
import { academicYear, fmtDate, relDay } from '../../../lib/time';
import { STATUS_LABEL, STEP_LABEL, type DeptSlug, type RecordStatus } from '../../../lib/types';

const user = Astro.locals.user!;
const sp = Astro.url.searchParams;
const view = sp.get('view') === 'mine' || sp.get('mine') === '1' ? 'mine' : sp.get('view') === 'waiting' ? 'waiting' : 'all';
const filter = {
  status: sp.get('status') ?? '',
  dept: sp.get('dept') ?? '',
  type: sp.get('type') ?? '',
  year: sp.get('year') ?? '',
  q: (sp.get('q') ?? '').trim(),
};
const [rows, waiting, depts] = await Promise.all([
  view === 'waiting'
    ? awaitingMe(user)
    : listRecords(user, { ...filter, author: view === 'mine' ? user.id : undefined, limit: 300 }),
  awaitingMe(user),
  departments(),
]);
const canCreate = depts.some((d) => canCreateRecordIn(user, d.slug as DeptSlug));
const cur = academicYear();
const years = [cur, `${Number(cur.slice(0, 4)) - 1}-${cur.slice(0, 4)}`];
const filtered = Object.values(filter).some(Boolean);

const statuses: (RecordStatus | '')[] = ['', 'draft', 'in_review', 'approved', 'rejected', 'void'];
---
<Staff title="Баримт бичиг">
  <PageHead title="Баримт бичиг" sub="Холбооны нэгдсэн архив. Бүх хэлтсийн баримтыг уншиж болно, засах эрх зөвхөн өөрийн хэлтэст.">
    <Fragment slot="actions">
      {canCreate && <a class="btn btn-primary" href="/barimt/shine"><Icon name="plus" /> Шинэ баримт бичиг</a>}
    </Fragment>
  </PageHead>

  <nav class="tabs" aria-label="Харах">
    <a href="/barimt" aria-current={view === 'all' ? 'page' : undefined}>Бүгд</a>
    <a href="/barimt?view=mine" aria-current={view === 'mine' ? 'page' : undefined}>Миний бичсэн</a>
    {(waiting.length > 0 || view === 'waiting') && (
      <a href="/barimt?view=waiting" aria-current={view === 'waiting' ? 'page' : undefined}>
        Миний шийдвэр хүлээж буй <span class="badge plain b-gold">{waiting.length}</span>
      </a>
    )}
  </nav>

  {view !== 'waiting' && (
    <form class="toolbar" method="get" role="search" aria-label="Баримт хайх">
      {view !== 'all' && <input type="hidden" name="view" value={view} />}
      <div class="search">
        <label for="q" class="sr-only">Гарчиг эсвэл дугаараар хайх</label>
        <Icon name="search" />
        <input id="q" type="search" name="q" placeholder="Гарчиг эсвэл дугаар…" value={filter.q} maxlength="20" />
      </div>
      <label for="f-status" class="sr-only">Төлөв</label>
      <select id="f-status" name="status">
        {statuses.map((s) => <option value={s} selected={filter.status === s}>{s ? STATUS_LABEL[s] : 'Бүх төлөв'}</option>)}
      </select>
      <label for="f-dept" class="sr-only">Хэлтэс</label>
      <select id="f-dept" name="dept">
        <option value="">Бүх хэлтэс</option>
        {depts.map((d) => <option value={d.slug} selected={filter.dept === d.slug}>{d.name_mn}</option>)}
      </select>
      <label for="f-type" class="sr-only">Төрөл</label>
      <select id="f-type" name="type">
        <option value="">Бүх төрөл</option>
        {RECORD_TYPE_LIST.map((t) => <option value={t.slug} selected={filter.type === t.slug}>{t.label}</option>)}
      </select>
      <label for="f-year" class="sr-only">Хичээлийн жил</label>
      <select id="f-year" name="year">
        <option value="">Бүх жил</option>
        {years.map((y) => <option value={y} selected={filter.year === y}>{y}</option>)}
      </select>
      <button class="btn" type="submit">Шүүх</button>
    </form>
  )}

  <p class="result-line" role="status">
    <span>{rows.length} баримт</span>
    {filtered && view !== 'waiting' && <a href={view === 'mine' ? '/barimt?view=mine' : '/barimt'}>Шүүлтүүр цэвэрлэх</a>}
  </p>

  {
    rows.length === 0 ? (
      <div class="empty">
        <Icon name="doc" />
        <b>{view === 'waiting' ? 'Таны шийдвэр хүлээж буй баримт алга.' : 'Энэ шүүлтүүрт тохирох баримт бичиг алга.'}</b>
      </div>
    ) : (
      <div class="table-wrap cards-sm">
        <table class="t">
          <caption class="sr-only">Баримт бичгийн жагсаалт</caption>
          <thead>
            <tr>
              <th scope="col">Гарчиг</th>
              <th scope="col">Хэлтэс</th>
              <th scope="col">Боловсруулсан</th>
              <th scope="col">Төлөв</th>
              <th scope="col" class="num">Шинэчилсэн</th>
            </tr>
          </thead>
          <tbody>
            {rows.map((r) => (
              <tr class="clickable">
                <td class="main-cell">
                  <a class="row-link" href={`/barimt/${r.id}`}>{r.title}</a>
                  <span class="sub">
                    {getRecordType(r.type)?.label ?? r.type}
                    {r.number && <> · <span class="num">{r.number}</span></>}
                    {r.visibility === 'dept' && <> · <span class="tag"><Icon name="lock" /> зөвхөн хэлтэс</span></>}
                  </span>
                  <span class="sub m-only">{r.dept_name} · {r.author_name} · {relDay(r.updated_at)}</span>
                </td>
                <td class="nowrap hide-sm">{r.dept_name}</td>
                <td class="nowrap hide-sm">{r.author_name}</td>
                <td class="side-cell">
                  <span class={`badge b-${r.status}`}>{STATUS_LABEL[r.status]}</span>
                  {r.status === 'in_review' && r.awaiting && <span class="sub hide-sm">{STEP_LABEL[r.awaiting]}</span>}
                </td>
                <td class="num nowrap muted hide-sm">{fmtDate(r.updated_at)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )
  }
</Staff>
