---
export const prerender = false;
import Staff from '../../layouts/Staff.astro';
import PageHead from '../../components/PageHead.astro';
import Icon from '../../components/Icon.astro';
import { initials } from '../../lib/team';
import { participation, participationDetail, yearsWithEvents } from '../../lib/events';
import { int } from '../../lib/http';
import { getMember } from '../../lib/members';
import { canSeeParticipation } from '../../lib/permissions';
import { academicYear, fmtDate } from '../../lib/time';
import { ROLE_LABEL } from '../../lib/types';

const user = Astro.locals.user!;
const years = await yearsWithEvents();
const year = years.includes(Astro.url.searchParams.get('year') ?? '') ? Astro.url.searchParams.get('year')! : academicYear();
const seeAll = canSeeParticipation(user);

// Everyone sees their own record; President and board see everyone's.
const requested = int(Astro.url.searchParams.get('user'));
const focusId = requested && canSeeParticipation(user, requested) ? requested : seeAll ? null : user.id;

const rows = seeAll ? await participation(year) : await participation(year, user.id);
const focus = focusId ? await getMember(focusId) : null;
const detail = focusId ? await participationDetail(focusId, year) : [];
const zeros = rows.filter((r) => r.volunteered + r.assigned === 0).length;
const totalJobs = rows.reduce((n, r) => n + r.volunteered + r.assigned, 0);
const totalVol = rows.reduce((n, r) => n + r.volunteered, 0);
const maxDone = Math.max(1, ...rows.map((r) => r.done));
const STATUS: Record<string, string> = { active: 'Хийж байгаа', done: 'Дууссан', dropped: 'Орхисон' };
const link = (p: Record<string, string | number>) => `/oroltsoo?${new URLSearchParams({ year, ...Object.fromEntries(Object.entries(p).map(([k, v]) => [k, String(v)])) })}`;
---
<Staff title={seeAll ? 'Оролцоо' : 'Миний оролцоо'}>
  <PageHead
    title={seeAll ? `Оролцоо · ${year}` : `Миний оролцоо · ${year}`}
    sub={seeAll
      ? 'Хэн хэдэн арга хэмжээнд ажилласан, хэдэн ажлыг сайн дураараа авсан, хэдийг нь хуваарилсан, хэдийг дуусгасан.'
      : 'Таны авсан, хуваарилагдсан ажлууд. Бүх гишүүний оролцоог Тэргүүн болон Удирдах Зөвлөл харна.'}
  >
    <Fragment slot="actions">
      <nav class="tabs" aria-label="Хичээлийн жил" style="margin:0">
        {years.map((y) => <a href={`/oroltsoo?year=${y}`} aria-current={y === year ? 'page' : undefined}>{y}</a>)}
      </nav>
    </Fragment>
  </PageHead>

  {
    seeAll && (
      <>
        <div class="stats">
          <div class="stat"><span class="ic"><Icon name="users" /></span><span><b>{rows.length}</b><span>гишүүн</span></span></div>
          <div class="stat blue"><span class="ic"><Icon name="check" /></span><span><b>{totalJobs}</b><span>нийт ажил авсан</span></span></div>
          <div class="stat ok"><span class="ic"><Icon name="hand" /></span><span><b>{totalVol}</b><span>сайн дураар</span></span></div>
          <div class:list={['stat', { hot: zeros > 0 }]}><span class="ic"><Icon name="alert" /></span><span><b>{zeros}</b><span>ажил аваагүй</span></span></div>
        </div>
        <div class="table-wrap cards-sm">
          <table class="t">
            <caption class="sr-only">{year} оны оролцоо, гишүүн бүрээр</caption>
            <thead>
              <tr>
                <th scope="col">Гишүүн</th>
                <th scope="col" class="num">Арга хэмжээ</th>
                <th scope="col" class="num">Сайн дураар</th>
                <th scope="col" class="num">Хуваарилсан</th>
                <th scope="col" class="num">Дууссан</th>
                <th scope="col" class="num">Хийж байгаа</th>
                <th scope="col" class="num">Орхисон</th>
              </tr>
            </thead>
            <tbody>
              {rows.map((r) => (
                <tr class:list={['clickable', { zero: r.volunteered + r.assigned === 0 }]}>
                  <td class="main-cell">
                    <span class="who">
                      <span class="avatar sm" aria-hidden="true">{initials(r.name)}</span>
                      <span class="who-text">
                        <a class="row-link" href={link({ user: r.user_id }) + '#detail'}>{r.name}</a>
                        <small>{r.dept_name ?? ROLE_LABEL[r.role]}{r.status !== 'active' && ' · идэвхгүй'}</small>
                        <small class="m-only">{r.events} арга хэмжээ · {r.volunteered} сайн дураар · {r.assigned} хуваарилсан · {r.done} дууссан</small>
                      </span>
                    </span>
                  </td>
                  <td class="num hide-sm">{r.events}</td>
                  <td class="num hide-sm">{r.volunteered}</td>
                  <td class="num hide-sm">{r.assigned}</td>
                  <td class="num side-cell">
                    <span class="bar-cell">
                      <span class="bar hide-sm" aria-hidden="true"><span style={`width:${Math.round((r.done / maxDone) * 100)}%`} /></span>
                      <strong>{r.done}</strong>
                    </span>
                  </td>
                  <td class="num hide-sm">{r.active}</td>
                  <td class="num hide-sm">{r.dropped || ''}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        {zeros > 0 && <p class="form-note" style="margin-top:10px">Энэ жил ямар ч ажил аваагүй {zeros} хүн хүснэгтийн доод хэсэгт саарал өнгөөр харагдана.</p>}
      </>
    )
  }

  {
    focus && (
      <section class="panel" id="detail" style="margin-top:20px" aria-labelledby="detail-h">
        <div class="panel-head">
          <h2 id="detail-h"><Icon name="user" /> {focus.id === user.id ? 'Миний оролцоо' : focus.name_mn}</h2>
          {seeAll && focusId && <a class="more" href={link({})}>Хаах ×</a>}
        </div>
        <div class="panel-body">
          {detail.length === 0 ? (
            <div class="empty"><Icon name="check" /><p>{year} оны хичээлийн жилд бүртгэгдсэн ажил алга.</p></div>
          ) : (
            <ul class="items">
              {detail.map((d) => (
                <li class="item">
                  <span class:list={['ic', d.status === 'done' ? 'ok' : d.status === 'dropped' ? 'bad' : 'blue']}><Icon name={d.volunteered ? 'hand' : 'check'} /></span>
                  <span class="item-title">{d.task_title}</span>
                  <span class="item-meta">
                    <a href={`/uil-ajillagaa/${d.event_id}`}>{d.event_title}</a>
                    <span>{fmtDate(d.starts_at)}</span>
                    <span>{d.volunteered ? 'Сайн дураар' : 'Хуваарилсан'}</span>
                  </span>
                  <span class="item-act"><span class={`badge b-${d.status === 'active' ? 'open' : d.status}`}>{STATUS[d.status]}</span></span>
                </li>
              ))}
            </ul>
          )}
        </div>
      </section>
    )
  }
</Staff>
