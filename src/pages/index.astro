---
// Rendered per request (it shows live events) and edge-cached for 5 minutes by the Worker.
export const prerender = false;
import Public from '../layouts/Public.astro';
import Band from '../components/Band.astro';
import EventRows from '../components/EventRows.astro';
import Icon from '../components/Icon.astro';
import { publicEvents } from '../lib/events';

const { upcoming } = await publicEvents();
const soon = upcoming.slice(0, 4);

// The four doors of the site — the same pages as the menu, with one line each.
const tiles = [
  { href: '/taniltsuulga', icon: 'doc', title: 'Танилцуулга', text: 'Зорилго, үнэт зүйлс, бүтэц, түүх' },
  { href: '/udirdlaga', icon: 'unity', title: 'Удирдлагын баг', text: 'Тэргүүн, Удирдах Зөвлөл, таван хэлтэс' },
  { href: '/uil-ajillagaa', icon: 'calendar', title: 'Үйл ажиллагаа', text: 'Удахгүй болох ба өнгөрсөн арга хэмжээ' },
  { href: '/holboo-barih', icon: 'mail', title: 'Холбоо барих', text: 'И-мэйл, Instagram, хамтын ажиллагаа' },
] as const;
---
<Public>
  <Band
    home
    title="Монгол Оюутны Холбоо"
    kicker="Peking University · 北京大学"
    lede="Бээжингийн Их Сургуульд суралцаж буй Монгол оюутнуудыг нэгтгэж, бие биедээ туслан, эх орныхоо түүх, соёлыг түгээдэг сайн дурын байгууллага."
  >
    <div class="btn-row">
      <a class="btn btn-gold" href="#shine">Шинэ оюутан уу?<span class="hide-sm">&nbsp;Эндээс эхлээрэй</span> <span class="arr" aria-hidden="true">→</span></a>
    </div>
  </Band>

  <section class="sec tight">
    <div class="wrap">
      <nav class="tiles" aria-label="Сайтын хэсгүүд">
        {tiles.map((t) => (
          <a class="tile" href={t.href}>
            <span class="ic"><Icon name={t.icon} /></span>
            <b>{t.title}</b>
            <span>{t.text}</span>
          </a>
        ))}
      </nav>
    </div>
  </section>

  <section class="sec" aria-labelledby="soon-h">
    <div class="wrap">
      <span class="sec-label">Хуанли</span>
      <h2 id="soon-h">Удахгүй болох арга хэмжээ</h2>
      <EventRows events={soon} />
      <a class="more" href="/uil-ajillagaa">Бүх арга хэмжээ, зургууд</a>
    </div>
  </section>

  <section class="sec" id="shine" aria-labelledby="new-h">
    <div class="wrap">
      <span class="sec-label">Шинэ оюутанд</span>
      <h2 id="new-h">Бээжинд шинээр ирсэн бол</h2>
      <p class="intro">Эхний хэдэн долоо хоногт ихэнх оюутан ижил асуудалтай тулгардаг. Эдгээрээс эхлээрэй — гацвал бидэнд бичээрэй.</p>
      <ol class="steps">
        <li><b>Сургуульдаа бүртгүүлэх</b><span>Гадаад оюутны албанд бүртгүүлж, оюутны карт (校园卡) аваарай.</span></li>
        <li><b>Түр оршин суух бүртгэл</b><span>Ирснээс хойш 24 цагийн дотор бүртгүүлнэ (住宿登记). Дотуур байранд бол ихэвчлэн сургууль нь бүртгэдэг.</span></li>
        <li><b>Оршин суух зөвшөөрөл</b><span>X1 визээр ирсэн бол 30 хоногийн дотор оршин суух зөвшөөрөл (居留许可) авна.</span></li>
        <li><b>Утас, банк, төлбөр</b><span>Хятад SIM карт, банкны карт аваад WeChat Pay, Alipay-гаа холбоорой.</span></li>
      </ol>
      <p class="note">Энэ бол ерөнхий зөвлөмж. Журам өөрчлөгдөж болох тул Гадаад оюутны албаны зааврыг баримтална уу.</p>
      <a class="more" href="/holboo-barih">Асуух зүйл байвал бидэнд бичээрэй</a>
    </div>
  </section>

  <section class="sec" aria-labelledby="what-h">
    <div class="wrap">
      <span class="sec-label">Бидний тухай</span>
      <h2 id="what-h">Бид юу хийдэг вэ</h2>
      <ul class="pillars">
        <li>
          <span class="ic"><Icon name="unity" /></span>
          <b>Нэгдэл</b>
          <span>Монгол оюутнуудын эв нэгдэл, хамтын ажиллагааг дэмжиж, эрх ашгийг нь хамгаална.</span>
        </li>
        <li>
          <span class="ic"><Icon name="support" /></span>
          <b>Дэмжлэг</b>
          <span>Шинэ оюутнуудыг Бээжин болон Бээжингийн Их Сургуульд дасан зохицоход нь тусална.</span>
        </li>
        <li>
          <span class="ic"><Icon name="culture" /></span>
          <b>Соёл</b>
          <span>Монголын түүх, соёл, уламжлалыг сурталчилж, эрүүл, идэвхтэй амьдралыг дэмжинэ.</span>
        </li>
      </ul>
      <a class="more" href="/taniltsuulga">Зорилго, үнэт зүйлс, бүтэц</a>
    </div>
  </section>
</Public>
