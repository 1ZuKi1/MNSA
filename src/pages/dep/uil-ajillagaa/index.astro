---
export const prerender = false;
import Staff from '../../../layouts/Staff.astro';
import PageHead from '../../../components/PageHead.astro';
import Icon from '../../../components/Icon.astro';
import { staffEvents, taskBoardFor, type StaffEventRow } from '../../../lib/events';
import { mediaUrl } from '../../../lib/media';
import { canEditEvents } from '../../../lib/permissions';
import { dateKey, fmtDate, relDay } from '../../../lib/time';

const user = Astro.locals.user!;
const [{ upcoming, past }, board] = await Promise.all([staffEvents(), taskBoardFor(user)]);
const editor = canEditEvents(user);
const myEvents = new Map<number, number>();
for (const k of board.mine) myEvents.set(k.event_id, (myEvents.get(k.event_id) ?? 0) + 1);
const STATUS: Record<StaffEventRow['status'], string> = { draft: 'Ноорог', published: 'Нийтлэгдсэн', cancelled: 'Цуцлагдсан' };
const MONTH = (ts: number) => `${Number(fmtDate(ts).slice(5, 7))}-р сар`;
---
<Staff title="Арга хэмжээ">
  <PageHead title="Арга хэмжээ" sub="Удахгүй болох арга хэмжээ, тэдгээрийн ажлууд, өнгөрсөн арга хэмжээний зураг, тайлан.">
    <Fragment slot="actions">
      {editor && <a class="btn btn-primary" href="/uil-ajillagaa/shine"><Icon name="plus" /> Шинэ арга хэмжээ</a>}
    </Fragment>
  </PageHead>

  <section aria-labelledby="up-h">
    <h2 id="up-h" class="sec-title">Удахгүй болох <span class="badge plain">{upcoming.length}</span></h2>
    {
      upcoming.length === 0 ? (
        <div class="empty"><Icon name="calendar" /><b>Товлогдсон арга хэмжээ алга.</b>{editor && <p>«Шинэ арга хэмжээ» товчоор нэмнэ үү.</p>}</div>
      ) : (
        <ul class="ev-list">
          {upcoming.map((e) => {
            const k = dateKey(e.starts_at);
            const doneN = e.task_total - e.task_open;
            const mine = myEvents.get(e.id) ?? 0;
            return (
              <li class="ev">
                <div class="ev-date" aria-hidden="true">
                  <b>{Number(fmtDate(e.starts_at).slice(8))}</b>
                  <span>{MONTH(e.starts_at)}</span>
                  <small>{k.sub.split(' · ')[0]}</small>
                </div>
                <div>
                  <div class="ev-tags">
                    <span class={`badge b-${e.status}`}>{STATUS[e.status]}</span>
                    {e.dept_name && <span class="tag">{e.dept_name}</span>}
                    {mine > 0 && <span class="badge plain b-blue">Таны ажил: {mine}</span>}
                  </div>
                  <h3><a href={`/uil-ajillagaa/${e.id}`}>{e.title}</a></h3>
                  <p class="ev-meta">{fmtDate(e.starts_at)} {k.sub.split(' · ')[1]} · {relDay(e.starts_at)}{e.location && ` · ${e.location}`}</p>
                  <div class="progress-line">
                    {e.task_total === 0 ? (
                      <span class="muted">Ажил нэмэгдээгүй</span>
                    ) : (
                      <>
                        <span class="progress" role="img" aria-label={`${e.task_total} ажлаас ${doneN} нь дууссан`}>
                          <span style={`width:${Math.round((doneN / e.task_total) * 100)}%`} />
                        </span>
                        <span>{doneN}/{e.task_total} ажил дууссан</span>
                        {e.task_unassigned > 0 && <span class="need">{e.task_unassigned} ажилд хүн хэрэгтэй</span>}
                      </>
                    )}
                  </div>
                </div>
              </li>
            );
          })}
        </ul>
      )
    }
  </section>

  <section aria-labelledby="past-h" style="margin-top:32px">
    <h2 id="past-h" class="sec-title">Өнгөрсөн ба цуцлагдсан <span class="badge plain">{past.length}</span></h2>
    {
      past.length === 0 ? (
        <div class="empty"><Icon name="image" /><p>Одоогоор алга.</p></div>
      ) : (
        <div class="table-wrap cards-sm">
          <table class="t">
            <caption class="sr-only">Өнгөрсөн арга хэмжээ</caption>
            <thead>
              <tr><th scope="col"><span class="sr-only">Нүүр зураг</span></th><th scope="col">Нэр</th><th scope="col">Хэлтэс</th><th scope="col">Төлөв</th><th scope="col" class="num">Ажил</th></tr>
            </thead>
            <tbody>
              {past.map((e) => (
                <tr class="clickable">
                  <td class="hide-sm" style="width:72px">
                    {e.cover_media_id ? <img class="thumb" src={mediaUrl(e.cover_media_id)} alt="" loading="lazy" /> : <span class="thumb" />}
                  </td>
                  <td class="main-cell">
                    <a class="row-link" href={`/uil-ajillagaa/${e.id}`}>{e.title}</a>
                    <span class="sub">{fmtDate(e.starts_at)}{!e.cover_media_id && e.status !== 'cancelled' && ' · зураггүй'}</span>
                    <span class="sub m-only">{e.dept_name ?? 'Холбоо бүхэлдээ'} · {e.task_total - e.task_open}/{e.task_total} ажил</span>
                  </td>
                  <td class="nowrap hide-sm">{e.dept_name ?? '—'}</td>
                  <td class="side-cell"><span class={`badge b-${e.status}`}>{STATUS[e.status]}</span></td>
                  <td class="num hide-sm">{e.task_total - e.task_open}/{e.task_total}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )
    }
  </section>
</Staff>
